{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@luna-shi/murm": ["./src/core/index.js"]
    }
  },
  "exclude": ["**/node_modules", "**/dist"],
  "include": ["src/**/*.ts", "scripts/**/*.ts", "examples/**/*.ts", "test-support/**/*.ts", "benchmarks/fate/**/*.ts", "benchmarks/lead-worker-orders/**/*.ts"]
}
