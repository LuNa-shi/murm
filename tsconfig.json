{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowJs": true,
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@swarmenv/core": ["./src/core/index.js"],
      "@swarmenv/core/services": ["./src/core/services.js"],
      "@swarmenv/core/backends/pi-opensandbox": ["./src/core/backends/pi-opensandbox.js"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "examples/**/*", "test-support/**/*", "test/**/*"]
}
