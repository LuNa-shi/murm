{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@swarmenv/core": ["./src/core/index.js"],
      "@swarmenv/core/services": ["./src/core/public-services.js"],
      "@swarmenv/core/backends/pi-opensandbox": ["./src/core/backends/pi-opensandbox.js"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "examples/**/*.ts", "test-support/**/*.ts"]
}
