PI_PROVIDER=kimi_proxy
PI_MODEL=k3
# Optional host-side Responses endpoint and credential for the benchmark CLI.
# If unset, the CLI reads the selected provider from the host Pi models.json.
# The worker receives a scoped gateway token in place of this upstream key.
# PI_KIMI_PROXY_BASE_URL=
# PI_KIMI_PROXY_API_KEY=
# SWARMENV_SANDBOX_ENABLED=true
# SWARMENV_SANDBOX_PROVIDER=opensandbox
# SWARMENV_SANDBOX_IMAGE=swarmenv-agent:benchmark
# SWARMENV_OPENSANDBOX_URL=http://127.0.0.1:8090/v1
# SWARMENV_OPENSANDBOX_ENDPOINT_HOST=127.0.0.1
# Optional independently deployed Mathlib Search provider.
# MATHLIB_SEARCH_UPSTREAM_URL=http://loogle:8080
# MATHLIB_SEARCH_PUBLIC_URL=http://mathlib-search:8787
# SWARMENV_MATHLIB_SEARCH_URL=http://mathlib-search:8787
# MATHLIB_SEARCH_TOKEN=
# MATHLIB_REVISION=<locked-mathlib-revision>
# LEAN_VERSION=<locked-lean-toolchain>
# Issue 119 benchmark provider. The benchmark CLI fails closed unless this
# provider is explicitly configured; values below are names/URLs, never tokens.
# SWARMENV_SANDBOX_PROVIDER=opensandbox
# SWARMENV_OPENSANDBOX_URL=http://opensandbox:8080/v1
# SWARMENV_OPENSANDBOX_ENDPOINT_HOST=127.0.0.1
# OPEN_SANDBOX_API_KEY=
# SWARMENV_EXECD_ACCESS_TOKEN=
# Non-interactive Bash CLI service endpoints.
# SWARMENV_TASK_SERVICE_URL=http://task:8787
# SWARMENV_CONTEXT_SERVICE_URL=http://context:8787
# SWARMENV_JUDGE_SERVICE_URL=http://judge:8787
# SWARMENV_CATALOG_SERVICE_URL=http://catalog:8787
# SWARMENV_SERVICE_ISOLATED=true
