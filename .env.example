# Copy this file to .env and load it before a real Agent Core run.
# Do not put API keys, tokens, or credentials in this file.

NUROUTER_PI_PROVIDER=openai
NUROUTER_PI_MODEL=openai/gpt-6-luna

# Optional NuRouter route selectors. Leave both empty unless the route requires one.
NUROUTER_PI_ACCOUNT=
NUROUTER_PI_GROUP=
