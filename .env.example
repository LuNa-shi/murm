# Copy to a private .env, edit the entries you need, and export them before launch:
# set -a; . ./.env; set +a
# Core and the example commands do not automatically load this file.
# Keep credentials in the private file or your host secret store.

# Notes example: examples/notes/config.ts uses Kimi K3 explicitly.
# Both values below are required. Use your compatible Pi 1.3.0 Worker image and
# the complete Responses endpoint, including /v1/responses.
# SWARMENV_NOTES_IMAGE=your-compatible-worker-image
# SWARMENV_NOTES_MODEL_URL=https://model.example.invalid/v1/responses
# SWARMENV_NOTES_MODEL_TOKEN=
# SWARMENV_NOTES_ADVERTISE_HOST=172.17.0.1
# SWARMENV_NOTES_LIFECYCLE_URL=http://127.0.0.1:8080/v1
# SWARMENV_NOTES_ENDPOINT_HOST=127.0.0.1
# SWARMENV_NOTES_LIFECYCLE_TOKEN=
# Other Environments receive image, model and backend settings through their
# trusted configuration module; see their example and Architecture chapter 07.

# Optional OpenSandbox manager defaults when the host omits explicit tokens.
# The Notes lifecycle token above is its explicit sandbox API credential.
# OPEN_SANDBOX_API_KEY=
# SWARMENV_EXECD_ACCESS_TOKEN=

# Optional independently deployed Mathlib Search provider.
# MATHLIB_SEARCH_UPSTREAM_URL=http://loogle:8080
# MATHLIB_SEARCH_SOURCE_ROOT=/mounted/mathlib
# MATHLIB_SEARCH_PUBLIC_URL=http://mathlib-search:8787
# MATHLIB_SEARCH_TOKEN=
# MATHLIB_REVISION=locked-mathlib-revision
# LEAN_VERSION=locked-lean-toolchain

# Standalone service host (scripts/service-host.mjs): peer endpoints and mode.
# These values configure that host; they do not register Services in a Runtime.
# SWARMENV_TASK_SERVICE_URL=http://task:8787
# SWARMENV_CONTEXT_SERVICE_URL=http://context:8787
# SWARMENV_JUDGE_SERVICE_URL=http://judge:8787
# SWARMENV_CATALOG_SERVICE_URL=http://catalog:8787
# SWARMENV_SERVICE_ISOLATED=true
