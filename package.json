{
  "name": "@swarmenv/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local-first runtime for durable, checkable agent swarm tasks.",
  "exports": {
    ".": {
      "types": "./src/core/index.d.ts",
      "default": "./src/core/index.js"
    },
    "./services": {
      "types": "./src/core/services.d.ts",
      "default": "./src/core/public-services.js"
    },
    "./backends/pi-opensandbox": {
      "types": "./src/core/backends/pi-opensandbox.d.ts",
      "default": "./src/core/backends/pi-opensandbox.js"
    }
  },
  "files": [
    "src/",
    "scripts/",
    "services/",
    "examples/",
    "docs/",
    "test/",
    "test-support/",
    "AGENTS.md",
    "GLOSSARY.md",
    "npm-shrinkwrap.json",
    ".env.example",
    ".gitmodules"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "swarm": "node scripts/swarm.mjs",
    "test": "node --test --test-concurrency=1 'test/**/*.test.js'",
    "pretest": "npm run docs:check",
    "service:mathlib-search": "node scripts/mathlib-search-service.mjs",
    "service:builtin": "node scripts/service-host.mjs",
    "docs:generate": "node scripts/generate-architecture-prompts.mjs && node scripts/generate-architecture-api.mjs && node scripts/generate-architecture-coverage.mjs",
    "docs:check": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "ajv": "8.20.0"
  },
  "bin": {
    "swarm": "scripts/swarm.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
