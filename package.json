{
  "name": "@luna-shi/murm",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "description": "Build and run custom multi-agent collaboration with isolated coding agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuNa-shi/murm.git"
  },
  "bugs": {
    "url": "https://github.com/LuNa-shi/murm/issues"
  },
  "homepage": "https://luna-shi.github.io/murm/",
  "exports": {
    ".": {
      "types": "./dist/src/core/index.d.ts",
      "default": "./dist/src/core/index.js"
    }
  },
  "files": [
    "dist/",
    "tsconfig.json",
    "tsconfig.tests.json",
    ".dockerignore",
    "src/",
    "scripts/",
    "deploy/",
    "examples/",
    "docs/",
    "test/",
    "test-support/",
    "AGENTS.md",
    "GLOSSARY.md",
    "npm-shrinkwrap.json",
    ".env.example",
    ".gitmodules"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "swarm": "node dist/scripts/swarm.js",
    "test": "node --test --test-concurrency=1 'dist/test/**/*.test.js'",
    "pretest": "npm run docs:check",
    "service:mathlib-search": "node dist/examples/services/mathlib-search/main.js",
    "service:builtin": "node dist/scripts/service-host.js",
    "docs:generate": "node dist/scripts/generate-architecture-prompts.js && node dist/scripts/generate-architecture-api.js && node dist/scripts/generate-architecture-coverage.js",
    "docs:check": "node dist/scripts/check-architecture.js",
    "predocs:generate": "npm run build",
    "predocs:check": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "js-tiktoken": "1.0.21"
  },
  "bin": {
    "murm": "dist/scripts/murm.js",
    "swarm": "dist/scripts/swarm.js"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typescript": "^7.0.2",
    "@types/node": "26.6.5"
  }
}
