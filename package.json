{
  "name": "@murm/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local-first runtime for durable, checkable agent swarm tasks.",
  "exports": {
    ".": {
      "types": "./dist/src/core/index.d.ts",
      "default": "./dist/src/core/index.js"
    },
    "./services": {
      "types": "./dist/src/core/public-services.d.ts",
      "default": "./dist/src/core/public-services.js"
    },
    "./backends/pi-opensandbox": {
      "types": "./dist/src/core/backends/pi-opensandbox.d.ts",
      "default": "./dist/src/core/backends/pi-opensandbox.js"
    },
    "./backends/codex-opensandbox": {
      "types": "./dist/src/core/backends/codex-opensandbox.d.ts",
      "default": "./dist/src/core/backends/codex-opensandbox.js"
    },
    "./backends/opensandbox": {
      "types": "./dist/src/core/backends/opensandbox.d.ts",
      "default": "./dist/src/core/backends/opensandbox.js"
    }
  },
  "files": [
    "dist/",
    "tsconfig.json",
    "tsconfig.tests.json",
    ".dockerignore",
    "src/",
    "scripts/",
    "services/",
    "examples/",
    "docs/",
    "test/",
    "test-support/",
    "AGENTS.md",
    "GLOSSARY.md",
    "npm-shrinkwrap.json",
    ".env.example",
    ".gitmodules"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "swarm": "node dist/scripts/swarm.js",
    "test": "node --test --test-concurrency=1 'dist/test/**/*.test.js'",
    "pretest": "npm run docs:check",
    "service:mathlib-search": "node dist/scripts/mathlib-search-service.js",
    "service:builtin": "node dist/scripts/service-host.js",
    "docs:generate": "node dist/scripts/generate-architecture-prompts.js && node dist/scripts/generate-architecture-api.js && node dist/scripts/generate-architecture-coverage.js",
    "docs:check": "node dist/scripts/check-architecture.js",
    "predocs:generate": "npm run build",
    "predocs:check": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "ajv": "8.20.0",
    "js-tiktoken": "1.0.21"
  },
  "bin": {
    "swarm": "dist/scripts/swarm.js"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "26.6.5"
  }
}
