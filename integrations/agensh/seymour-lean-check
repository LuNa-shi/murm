#!/usr/bin/env python3
"""Check a module using the public challenge's fixed source layout."""
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile

CHALLENGE = Path('benchmarks/openai-math-12/lean/ComparatorChallenges/SeymourSecondNeighborhood.lean')
LEAN = Path('/opt/lean')
LIBRARIES = Path('/opt/lean-libraries')
PART = re.compile(r"[A-Za-z_][A-Za-z0-9_']*")


def run_build(command, work, env, timeout=600):
    with subprocess.Popen(command, cwd=work, env=env, start_new_session=True) as process:
        try:
            return process.wait(timeout=timeout)
        except BaseException:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()
            raise


def terminate(signum, frame):
    raise InterruptedError('Local build interrupted')


def main(argument):
    repo = Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip())
    root = repo / CHALLENGE.parent
    if root.resolve(strict=True) != root or not (repo / CHALLENGE).is_file():
        raise ValueError('Missing canonical Seymour module root')
    target = Path(os.path.abspath(argument))
    if target.suffix != '.lean' or not target.is_relative_to(root) or target.resolve(strict=True) != target:
        raise ValueError(f'Check a regular Lean source under {CHALLENGE.parent}')
    ls_files = ['git', '-C', str(repo), 'ls-files', '-z']
    tracked = subprocess.check_output([*ls_files, '--cached', '--', '*.lean'])
    drafts = subprocess.check_output([*ls_files, '--others', '--exclude-standard', '--', str(CHALLENGE.parent)])
    names = set(tracked.split(b'\0')) | set(drafts.split(b'\0'))
    libs = sorted(LIBRARIES.iterdir(), key=lambda path: int(path.name))
    reserved = {'Init', 'Lean', 'Std', 'Lake', 'LakeMain', 'LeanIR', 'LeanChecker', 'Leanc', 'Mathlib'}
    for lib in libs:
        reserved.update(entry.stem for entry in lib.iterdir() if entry.is_dir() or entry.suffix == '.olean')
    with tempfile.TemporaryDirectory(prefix='lean-check-') as tmp:
        work = Path(tmp)
        source = work / 'source'
        modules = set()
        for name in sorted(names):
            if not name.endswith(b'.lean') or name == b'lakefile.lean':
                continue
            file = repo / os.fsdecode(name)
            if file.is_symlink() or file.resolve() != file:
                raise ValueError('Symlink in local Lean sources')
            if not file.exists():  # locally deleted tracked file
                continue
            if not file.is_relative_to(root):
                raise ValueError('Tracked Lean source outside the canonical module root')
            if not file.is_file():
                raise ValueError('Expected regular Lean source')
            rel = file.relative_to(root)
            parts = rel.with_suffix('').parts
            if not all(PART.fullmatch(part) for part in parts) or parts[0] in reserved:
                raise ValueError(f'Invalid or reserved Lean module: {rel}')
            dest = source / rel
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(file, dest)
            modules.add('.'.join(parts))
        selected = '.'.join(target.relative_to(root).with_suffix('').parts)
        if selected not in modules:
            raise ValueError('Requested source is ignored or missing from the worktree')
        roots = sorted({name.split('.')[0] for name in modules})
        config = ['name = "local_check"', 'fixedToolchain = true', 'srcDir = "source"',
                  '[[lean_lib]]', 'name = "WorkspaceProof"', f'roots = {json.dumps(roots)}',
                  f'globs = {json.dumps(sorted(modules))}', 'moreLeanArgs = ["-j1"]']
        # Lake sets LEAN_PATH from its dependencies. Expose only the pinned
        # library objects through empty packages with operator-owned metadata.
        for i, lib in enumerate(libs):
            name = f'dependency{i}'
            package = work / name
            build = package / '.lake/build/lib'
            build.mkdir(parents=True)
            (build / 'lean').symlink_to(lib)
            (package / 'lakefile.toml').write_text(f'name = "{name}"\n')
            config.extend(['[[require]]', f'name = "{name}"', f'path = "{name}"'])
        (work / 'lakefile.toml').write_text('\n'.join(config) + '\n')
        env = {'PATH': f'{LEAN}/bin:/usr/bin:/bin', 'HOME': tmp, 'LANG': 'C.UTF-8'}
        return run_build([str(LEAN / 'bin/lake'), 'build', '+' + selected], work, env)


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, terminate)
    try:
        if len(sys.argv) != 2:
            raise ValueError('usage: lean-check Path/Module.lean')
        sys.exit(main(sys.argv[1]))
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        sys.exit(f'lean-check: {exc}')
