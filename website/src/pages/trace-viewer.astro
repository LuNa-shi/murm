---
import BaseLayout from '../layouts/BaseLayout.astro';
import TraceViewer from '../components/TraceViewer.astro';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="Trace Viewer · murm"
  description="Inspect local murm run directories in the browser without uploading any files."
  activeSection="trace-viewer"
>
  <main class="tv-page">
    <div class="tv-page-head">
      <div>
        <p class="section-eyebrow">Local Run Inspector</p>
        <h1>Trace Viewer</h1>
        <p>
          读取本地 <code>outputDir/&lt;runId&gt;/</code> 目录，在浏览器中按 Agent 泳道检查事件流水、Service 调用与收尾回执。
        </p>
      </div>
      <a class="section-link" href={withBase('/docs/reference/deploy/')}>查看本地启动方式 →</a>
    </div>

    <TraceViewer />
  </main>
</BaseLayout>
