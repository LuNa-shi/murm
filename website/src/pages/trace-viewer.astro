---
import BaseLayout from '../layouts/BaseLayout.astro';
import TraceViewer from '../components/TraceViewer.astro';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="Trace Viewer · murm"
  description="Inspect local murm run directories in the browser without uploading any files."
  activeSection="trace-viewer"
  paperGrid={true}
>
  <main class="tv-page">
    <div class="tv-page-head">
      <div>
        <p class="section-eyebrow">TRACE VIEWER · LOCAL INSPECTOR</p>
        <h1>Trace Viewer</h1>
        <p>
          本地快速检查 <code>outputDir/&lt;runId&gt;/</code> 轨迹目录；完整形态将作为独立服务端 Web UI（类似 DSH Web UI，服务器启动、本地电脑 SSH 转发/直连查看多 Run）单独承接。
        </p>
      </div>
      <a class="section-link" href={withBase('/docs/reference/deploy/')}>本地启动说明 →</a>
    </div>

    <TraceViewer />
  </main>
</BaseLayout>
