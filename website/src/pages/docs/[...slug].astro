---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import TraceDemoEmbed from '../../components/TraceDemoEmbed.astro';
import ConceptsDiagram from '../../components/ConceptsDiagram.astro';
import GatewayDiagram from '../../components/GatewayDiagram.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => {
    const slug = entry.id.replace(/\/index$/, '');
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  section={entry.data.section}
  currentSlug={slug}
  headings={headings}
  lang="en"
>
  {slug === 'concepts' && <ConceptsDiagram slot="before-prose" lang="en" />}
  {slug === 'gateway' && <GatewayDiagram slot="before-prose" lang="en" />}
  {slug === 'trace-viewer' && <TraceDemoEmbed slot="before-prose" lang="en" />}
  <Content />
</DocsLayout>
