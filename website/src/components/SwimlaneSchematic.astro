---
/**
 * Modern light-first architectural swimlane schematic illustrating how
 * multiple isolated agents collaborate across a shared Runtime and Service Bridge.
 */
---

<figure class="schematic-card" data-swimlane-schematic>
  <div class="schematic-head">
    <div class="schematic-title-wrap">
      <span class="schematic-kicker">Subagents · 协作泳道示意</span>
      <span class="schematic-sub">3 个隔离沙箱 Agent 并行分工、实时纠偏与成果交接</span>
    </div>
    <div class="schematic-legend" aria-label="图例">
      <span><i class="lg-swatch lg-input"></i>输入 / 纠偏</span>
      <span><i class="lg-swatch lg-model"></i>模型推理</span>
      <span><i class="lg-swatch lg-tool"></i>本地工具</span>
      <span><i class="lg-swatch lg-service"></i>Service 交接</span>
    </div>
  </div>

  <div class="schematic-phase-bar" role="tablist" aria-label="聚焦协作阶段">
    <button type="button" class="phase-btn active" data-phase="all" role="tab" aria-selected="true">全部流程</button>
    <button type="button" class="phase-btn" data-phase="1" role="tab" aria-selected="false">01 拆分委派</button>
    <button type="button" class="phase-btn" data-phase="2" role="tab" aria-selected="false">02 并行执行</button>
    <button type="button" class="phase-btn" data-phase="3" role="tab" aria-selected="false">03 中途纠偏</button>
    <button type="button" class="phase-btn" data-phase="4" role="tab" aria-selected="false">04 测试交接</button>
    <button type="button" class="phase-btn" data-phase="5" role="tab" aria-selected="false">05 归档收尾</button>
  </div>

  <div class="schematic-canvas-scroll">
    <svg
      class="schematic-svg"
      viewBox="0 0 1040 348"
      width="1040"
      height="348"
      role="img"
      aria-label="多智能体泳道协作示意图：展示 /root 与两个子 Agent /root/probe_patterns、/root/probe_filters 如何通过 spawn_agent、send_message 和 settled 完成并行开发与交接"
    >
      <defs>
        <marker id="arrow-indigo" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 1 1.5 L 8.5 5 L 1 8.5" fill="none" stroke="var(--sch-indigo)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </marker>
        <marker id="arrow-teal" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 1 1.5 L 8.5 5 L 1 8.5" fill="none" stroke="var(--sch-teal)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </marker>
        <marker id="arrow-amber" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 1 1.5 L 8.5 5 L 1 8.5" fill="none" stroke="var(--sch-amber)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </marker>
      </defs>

      <!-- Subtle column grid & phase headers -->
      <rect x="0" y="0" width="1040" height="38" class="sch-header-bg" />
      <line x1="0" y1="38" x2="1040" y2="38" class="sch-rule" />

      <text x="20" y="23" class="sch-col-label">AGENT 泳道</text>
      <line x1="186" y1="0" x2="186" y2="348" class="sch-rule" />

      <line x1="354" y1="0" x2="354" y2="348" class="sch-grid-v" />
      <line x1="538" y1="0" x2="538" y2="348" class="sch-grid-v" />
      <line x1="704" y1="0" x2="704" y2="348" class="sch-grid-v" />
      <line x1="884" y1="0" x2="884" y2="348" class="sch-grid-v" />

      <text x="198" y="23" class="sch-col-label">01 拆分委派</text>
      <text x="366" y="23" class="sch-col-label">02 并行执行</text>
      <text x="550" y="23" class="sch-col-label">03 中途纠偏</text>
      <text x="716" y="23" class="sch-col-label">04 测试交接</text>
      <text x="896" y="23" class="sch-col-label">05 归档收尾</text>

      <!-- Swimlane horizontal rows -->
      <rect x="0" y="142" width="1040" height="102" class="sch-lane-alt" />
      <line x1="0" y1="142" x2="1040" y2="142" class="sch-rule-soft" />
      <line x1="0" y1="244" x2="1040" y2="244" class="sch-rule-soft" />

      <!-- Lane 1 meta: /root -->
      <circle cx="24" cy="79" r="4.5" fill="var(--sch-indigo)" />
      <text x="36" y="83" class="sch-agent-id">/root</text>
      <text x="36" y="102" class="sch-agent-role">主控 Agent · 共享工作区</text>

      <!-- Lane 2 meta: /root/probe_patterns -->
      <circle cx="24" cy="183" r="4.5" fill="var(--sch-teal)" />
      <text x="36" y="187" class="sch-agent-id">/root/probe_patterns</text>
      <text x="36" y="206" class="sch-agent-role">子 Agent · 模式与符号链接</text>

      <!-- Lane 3 meta: /root/probe_filters -->
      <circle cx="24" cy="286" r="4.5" fill="var(--sch-amber)" />
      <text x="36" y="290" class="sch-agent-id">/root/probe_filters</text>
      <text x="36" y="309" class="sch-agent-role">子 Agent · 过滤边界测试</text>

      <!-- Faint continuous lifelines inside each lane -->
      <line x1="200" y1="90" x2="1020" y2="90" class="sch-lifeline" />
      <line x1="364" y1="193" x2="736" y2="193" class="sch-lifeline" />
      <line x1="364" y1="296" x2="780" y2="296" class="sch-lifeline" />

      <!-- ===== Curved Inter-Agent Handoff Connectors ===== -->
      <!-- 1. /root spawn_agent -> /root/probe_patterns -->
      <g class="sch-node" data-sch-phase="1">
        <path
          d="M 332 108 C 344 138, 344 193, 364 193"
          fill="none"
          stroke="var(--sch-indigo)"
          stroke-width="1.5"
          stroke-dasharray="4 3"
          marker-end="url(#arrow-indigo)"
        />
        <!-- 2. /root spawn_agent -> /root/probe_filters -->
        <path
          d="M 322 108 C 334 176, 336 296, 364 296"
          fill="none"
          stroke="var(--sch-indigo)"
          stroke-width="1.5"
          stroke-dasharray="4 3"
          marker-end="url(#arrow-indigo)"
        />
      </g>

      <!-- 3. /root send_message (steer) -> /root/probe_patterns -->
      <g class="sch-node" data-sch-phase="3">
        <path
          d="M 622 108 C 622 136, 594 148, 594 172"
          fill="none"
          stroke="var(--sch-indigo)"
          stroke-width="1.6"
          marker-end="url(#arrow-indigo)"
        />
        <rect x="600" y="124" width="76" height="18" rx="9" class="sch-edge-pill" />
        <text x="638" y="136.5" text-anchor="middle" class="sch-edge-label">steer 注入</text>
      </g>

      <!-- 4. /root/probe_patterns settled -> /root -->
      <g class="sch-node" data-sch-phase="4">
        <path
          d="M 716 175 C 728 148, 728 128, 742 110"
          fill="none"
          stroke="var(--sch-teal)"
          stroke-width="1.6"
          marker-end="url(#arrow-teal)"
        />
        <!-- 5. /root/probe_filters handoff -> /root -->
        <path
          d="M 772 276 C 790 220, 788 152, 796 110"
          fill="none"
          stroke="var(--sch-amber)"
          stroke-width="1.6"
          marker-end="url(#arrow-amber)"
        />
        <rect x="748" y="216" width="84" height="18" rx="9" class="sch-edge-pill" />
        <text x="790" y="228.5" text-anchor="middle" class="sch-edge-label">交接测试套件</text>
      </g>

      <!-- ===== Lane 1 Blocks (/root) ===== -->
      <g class="sch-node" data-sch-phase="1">
        <rect x="198" y="68" width="144" height="42" rx="8" class="sch-block blk-service" />
        <rect x="198" y="68" width="4" height="42" rx="2" fill="var(--sch-indigo)" />
        <text x="211" y="85" class="sch-blk-tag">SERVICE</text>
        <text x="211" y="101" class="sch-blk-title">拆解并 spawn ×2</text>
      </g>

      <g class="sch-node" data-sch-phase="2">
        <rect x="370" y="68" width="152" height="42" rx="8" class="sch-block blk-tool" />
        <rect x="370" y="68" width="4" height="42" rx="2" fill="var(--sch-amber)" />
        <text x="383" y="85" class="sch-blk-tag">MODEL + TOOL</text>
        <text x="383" y="101" class="sch-blk-title">编写核心 CLI 实现</text>
      </g>

      <g class="sch-node" data-sch-phase="3">
        <rect x="550" y="68" width="140" height="42" rx="8" class="sch-block blk-input" />
        <rect x="550" y="68" width="4" height="42" rx="2" fill="var(--sch-blue)" />
        <text x="563" y="85" class="sch-blk-tag">USER → SERVICE</text>
        <text x="563" y="101" class="sch-blk-title">转发符号链接需求</text>
      </g>

      <g class="sch-node" data-sch-phase="4">
        <rect x="716" y="68" width="154" height="42" rx="8" class="sch-block blk-model" />
        <rect x="716" y="68" width="4" height="42" rx="2" fill="var(--sch-purple)" />
        <text x="729" y="85" class="sch-blk-tag">VERIFY & FIX</text>
        <text x="729" y="101" class="sch-blk-title">运行回归并修复边界</text>
      </g>

      <g class="sch-node" data-sch-phase="5">
        <rect x="896" y="68" width="126" height="42" rx="8" class="sch-block blk-neutral" />
        <rect x="896" y="68" width="4" height="42" rx="2" fill="var(--ink-secondary)" />
        <text x="909" y="85" class="sch-blk-tag">RUNTIME CLOSE</text>
        <text x="909" y="101" class="sch-blk-title">归档会话与产物</text>
      </g>

      <!-- ===== Lane 2 Blocks (/root/probe_patterns) ===== -->
      <g class="sch-node" data-sch-phase="2">
        <rect x="370" y="172" width="152" height="42" rx="8" class="sch-block blk-tool" />
        <rect x="370" y="172" width="4" height="42" rx="2" fill="var(--sch-teal)" />
        <text x="383" y="189" class="sch-blk-tag">PARALLEL TOOL</text>
        <text x="383" y="205" class="sch-blk-title">探测 regex/glob 行为</text>
      </g>

      <g class="sch-node" data-sch-phase="3">
        <rect x="550" y="172" width="122" height="42" rx="8" class="sch-block blk-input" />
        <rect x="550" y="172" width="4" height="42" rx="2" fill="var(--sch-blue)" />
        <text x="563" y="189" class="sch-blk-tag">STEER</text>
        <text x="563" y="205" class="sch-blk-title">补写符号链接用例</text>
      </g>

      <g class="sch-node" data-sch-phase="4">
        <rect x="684" y="172" width="60" height="42" rx="8" class="sch-block blk-service" />
        <text x="714" y="190" text-anchor="middle" class="sch-blk-tag">EVENT</text>
        <text x="714" y="205" text-anchor="middle" class="sch-blk-title">settled</text>
      </g>

      <!-- ===== Lane 3 Blocks (/root/probe_filters) ===== -->
      <g class="sch-node" data-sch-phase="2">
        <rect x="370" y="275" width="152" height="42" rx="8" class="sch-block blk-model" />
        <rect x="370" y="275" width="4" height="42" rx="2" fill="var(--sch-amber)" />
        <text x="383" y="292" class="sch-blk-tag">PARALLEL MODEL</text>
        <text x="383" y="308" class="sch-blk-title">排查过滤参数边界</text>
      </g>

      <g class="sch-node" data-sch-phase="3">
        <rect x="550" y="275" width="140" height="42" rx="8" class="sch-block blk-tool" />
        <rect x="550" y="275" width="4" height="42" rx="2" fill="var(--sch-amber)" />
        <text x="563" y="292" class="sch-blk-tag">TOOL · WRITE</text>
        <text x="563" y="308" class="sch-blk-title">编写过滤回归测试</text>
      </g>

      <g class="sch-node" data-sch-phase="4">
        <rect x="706" y="275" width="96" height="42" rx="8" class="sch-block blk-service" />
        <text x="754" y="292" text-anchor="middle" class="sch-blk-tag">SERVICE</text>
        <text x="754" y="308" text-anchor="middle" class="sch-blk-title">send_message</text>
      </g>
    </svg>
  </div>

  <figcaption class="schematic-caption">
    <span data-phase-note>
      完整流程：三个隔离沙箱中的 Agent 通过共享 Service Bridge 协作；每次运行自动写出结构化轨迹，可在独立 Trace Viewer 中载入本地 <code>outputDir/&lt;runId&gt;/</code> 目录检查。
    </span>
  </figcaption>
</figure>

<script is:inline>
  (function () {
    const figure = document.querySelector('[data-swimlane-schematic]');
    if (!figure) return;

    const notes = {
      all: '完整流程：三个隔离沙箱中的 Agent 通过共享 Service Bridge 协作；每次运行自动写出结构化轨迹，可在独立 Trace Viewer 中载入本地 outputDir/<runId>/ 目录检查。',
      '1': '01 拆分委派：/root 通过 collaboration Service 发起 spawn_agent，Runtime 分配隔离沙箱并按需挂载共享工作区或派生会话上下文。',
      '2': '02 并行执行：三只 Agent 各自在独立 Pi 会话与沙箱内并行推理和调用工具，互不阻塞，也无需共享 API Key。',
      '3': '03 中途纠偏：用户追加要求后，/root 调用 send_message，宿主使用 send({ mode: "steer", wakeIfIdle: false }) 在不打扰空闲成员的前提下即时注入忙碌中的子 Agent。',
      '4': '04 测试交接：子 Agent 完成后发出 settled 事件或显式 send_message，测试文件通过共享工作区交接给 /root 跑通验证并修复缺陷。',
      '5': '05 归档收尾：runtime.close() 按固定顺序停执行、导出完整原生 Session 与交付文件、最后回收容器并写出 runtime.json 与轨迹日志。',
    };

    const buttons = figure.querySelectorAll('[data-phase]');
    const nodes = figure.querySelectorAll('[data-sch-phase]');
    const noteEl = figure.querySelector('[data-phase-note]');

    function selectPhase(phase) {
      buttons.forEach((btn) => {
        const active = btn.getAttribute('data-phase') === phase;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      nodes.forEach((node) => {
        const match = phase === 'all' || node.getAttribute('data-sch-phase') === phase;
        node.classList.toggle('dimmed', !match);
      });
      if (noteEl && notes[phase]) {
        noteEl.textContent = notes[phase];
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectPhase(btn.getAttribute('data-phase') || 'all');
      });
    });
  })();
</script>
