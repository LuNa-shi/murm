---
/**
 * Interactive lab-notebook × pixel-terminal swimlane schematic (English).
 * All hand-drawn annotations are positioned with clear geometric margins
 * so text never collides with connector arrows or loop strokes.
 */
---

<div class="schematic-wrap">
  <p class="marker-note" aria-hidden="true">
    <span>3 isolated sandboxes, 1 shared Service Bridge — zero shared API keys</span>
    <svg viewBox="0 0 92 48" width="76" height="40">
      <path d="M 6 10 C 26 36, 56 40, 82 28 M 71 21 L 84 28 L 74 39" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </p>

  <figure class="schematic-card" data-swimlane-schematic>
    <div class="schematic-head">
      <div class="schematic-title-wrap">
        <span class="pixel-badge">SUBAGENTS · SWIMLANE</span>
        <span class="schematic-sub">Parallel sandboxes, mid-flight steer, and verified handoff</span>
      </div>
      <div class="schematic-head-right">
        <button type="button" class="play-btn" data-sch-play aria-label="Play collaboration walkthrough">
          <span data-play-icon>▶</span>
          <span data-play-label>Play walkthrough</span>
        </button>
      </div>
    </div>

    <div class="schematic-phase-bar" role="tablist" aria-label="Focus collaboration phase">
      <button type="button" class="phase-btn active" data-phase="all" role="tab" aria-selected="true">ALL</button>
      <button type="button" class="phase-btn" data-phase="1" role="tab" aria-selected="false">01 SPAWN</button>
      <button type="button" class="phase-btn" data-phase="2" role="tab" aria-selected="false">02 PARALLEL</button>
      <button type="button" class="phase-btn" data-phase="3" role="tab" aria-selected="false">03 STEER</button>
      <button type="button" class="phase-btn" data-phase="4" role="tab" aria-selected="false">04 HANDOFF</button>
      <button type="button" class="phase-btn" data-phase="5" role="tab" aria-selected="false">05 CLOSE</button>

      <div class="schematic-legend" aria-label="Legend">
        <span><i class="lg-swatch lg-service"></i>Service</span>
        <span><i class="lg-swatch lg-tool"></i>Tool</span>
        <span><i class="lg-swatch lg-input"></i>Steer</span>
        <span><i class="lg-swatch lg-model"></i>Verify</span>
      </div>
    </div>

    <div class="schematic-canvas-scroll">
      <svg
        class="schematic-svg"
        viewBox="0 0 1060 392"
        width="1060"
        height="392"
        role="img"
        aria-label="Multi-agent swimlane diagram showing /root delegating work to /root/patterns and /root/filters, steering mid-flight with wakeIfIdle: false, receiving test handoffs, and closing safely."
      >
        <defs>
          <pattern id="draft-grid" width="24" height="24" patternUnits="userSpaceOnUse">
            <path d="M 24 0 L 0 0 0 24" fill="none" stroke="var(--sch-grid)" stroke-width="0.9" />
          </pattern>
          <marker id="arrow-cobalt" viewBox="0 0 10 10" refX="8.2" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
            <path d="M 1 1.5 L 8.2 5 L 1 8.5" fill="none" stroke="var(--sch-indigo)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
          <marker id="arrow-teal" viewBox="0 0 10 10" refX="8.2" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
            <path d="M 1 1.5 L 8.2 5 L 1 8.5" fill="none" stroke="var(--sch-teal)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
          <marker id="arrow-amber" viewBox="0 0 10 10" refX="8.2" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
            <path d="M 1 1.5 L 8.2 5 L 1 8.5" fill="none" stroke="var(--sch-amber)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
        </defs>

        <!-- Drafting graph-paper base -->
        <rect x="0" y="0" width="1060" height="392" fill="var(--sch-surface)" />
        <rect x="196" y="42" width="864" height="350" fill="url(#draft-grid)" />

        <!-- Top Phase Header Bar -->
        <rect x="0" y="0" width="1060" height="42" fill="var(--sch-header)" />
        <line x1="0" y1="42" x2="1060" y2="42" class="sch-ink-rule" />
        <line x1="196" y1="0" x2="196" y2="392" class="sch-ink-rule" />

        <!-- Phase vertical zone dividers -->
        <line x1="364" y1="0" x2="364" y2="392" class="sch-grid-v" />
        <line x1="546" y1="0" x2="546" y2="392" class="sch-grid-v" />
        <line x1="726" y1="0" x2="726" y2="392" class="sch-grid-v" />
        <line x1="904" y1="0" x2="904" y2="392" class="sch-grid-v" />

        <text x="20" y="25" class="sch-pixel-head">SANDBOX LANE</text>
        <text x="210" y="25" class="sch-pixel-head">01 · SPAWN</text>
        <text x="378" y="25" class="sch-pixel-head">02 · PARALLEL</text>
        <text x="560" y="25" class="sch-pixel-head">03 · STEER</text>
        <text x="740" y="25" class="sch-pixel-head">04 · HANDOFF</text>
        <text x="918" y="25" class="sch-pixel-head">05 · CLOSE</text>

        <!-- Parallel overlap highlighter zone (Phase 2) -->
        <g class="sch-node" data-sch-phase="2">
          <rect x="374" y="162" width="162" height="196" rx="10" class="sch-parallel-band" />
          <path d="M 386 346 L 524 343" stroke="var(--marker-yellow)" stroke-width="11" stroke-linecap="round" opacity="0.9" />
          <text x="455" y="349" text-anchor="middle" class="sch-hand-sm">concurrent sandboxes!</text>
        </g>

        <!-- Swimlane row separators -->
        <line x1="0" y1="154" x2="196" y2="154" class="sch-rule-soft" />
        <line x1="0" y1="264" x2="196" y2="264" class="sch-rule-soft" />

        <!-- Lane 1 meta: /root -->
        <rect x="16" y="76" width="8" height="8" rx="1" fill="var(--sch-indigo)" />
        <text x="32" y="84" class="sch-agent-pixel">/root</text>
        <text x="32" y="103" class="sch-agent-role">Lead · plan &amp; integrate</text>

        <!-- Lane 2 meta: /root/patterns -->
        <rect x="16" y="191" width="8" height="8" rx="1" fill="var(--sch-teal)" />
        <text x="32" y="199" class="sch-agent-pixel">/root/patterns</text>
        <text x="32" y="218" class="sch-agent-role">Child · regex &amp; symlinks</text>

        <!-- Lane 3 meta: /root/filters -->
        <rect x="16" y="299" width="8" height="8" rx="1" fill="var(--sch-amber)" />
        <text x="32" y="307" class="sch-agent-pixel">/root/filters</text>
        <text x="32" y="326" class="sch-agent-role">Child · CLI filter suite</text>

        <!-- Dashed lifelines -->
        <line x1="210" y1="98" x2="1036" y2="98" class="sch-lifeline" />
        <line x1="382" y1="208" x2="770" y2="208" class="sch-lifeline" />
        <line x1="382" y1="312" x2="824" y2="312" class="sch-lifeline" />

        <!-- ===== Animated Curved Inter-Agent Handoff Connectors ===== -->
        <!-- Phase 1: spawn_agent forks (label sits cleanly left of arrows, zero overlap) -->
        <g class="sch-node" data-sch-phase="1">
          <path
            class="sch-flow-line"
            d="M 336 118 C 350 152, 356 208, 378 208"
            fill="none"
            stroke="var(--sch-indigo)"
            stroke-width="2"
            marker-end="url(#arrow-cobalt)"
          />
          <path
            class="sch-flow-line"
            d="M 326 118 C 338 190, 346 312, 378 312"
            fill="none"
            stroke="var(--sch-indigo)"
            stroke-width="2"
            marker-end="url(#arrow-cobalt)"
          />
          <text x="262" y="158" text-anchor="middle" class="sch-hand-blue">spawn ×2</text>
        </g>

        <!-- Phase 3: steer mid-flight with generously padded cobalt oval (128px wide, clear of arrows) -->
        <g class="sch-node" data-sch-phase="3">
          <path
            class="sch-flow-line"
            d="M 606 118 C 606 150, 594 162, 594 184"
            fill="none"
            stroke="var(--sch-indigo)"
            stroke-width="2.1"
            marker-end="url(#arrow-cobalt)"
          />
          <path
            d="M 622 145 C 624 126, 750 125, 752 145 C 754 164, 620 165, 622 145 Z"
            fill="var(--sch-surface)"
            stroke="var(--sch-indigo)"
            stroke-width="1.6"
          />
          <text x="687" y="149.5" text-anchor="middle" class="sch-hand-blue-sm">wakeIfIdle: false</text>
        </g>

        <!-- Phase 4: settled + send_message handoff back to /root -->
        <g class="sch-node" data-sch-phase="4">
          <path
            class="sch-flow-line"
            d="M 762 186 C 770 156, 774 138, 782 120"
            fill="none"
            stroke="var(--sch-teal)"
            stroke-width="2"
            marker-end="url(#arrow-teal)"
          />
          <path
            class="sch-flow-line"
            d="M 816 290 C 838 226, 834 158, 842 120"
            fill="none"
            stroke="var(--sch-amber)"
            stroke-width="2"
            marker-end="url(#arrow-amber)"
          />
          <text x="892" y="236" text-anchor="middle" class="sch-hand-blue">66 tests →</text>
        </g>

        <!-- ===== Tactile Offset-Shadow Block Cards ===== -->
        <!-- Lane 1 (/root) -->
        <g class="sch-node" data-sch-phase="1">
          <rect x="212" y="77" width="142" height="44" rx="5" class="sch-shadow" />
          <rect x="209" y="74" width="142" height="44" rx="5" class="sch-card" />
          <rect x="209" y="74" width="142" height="5" rx="2" fill="var(--sch-indigo)" />
          <text x="220" y="94" class="sch-card-pixel">SPAWN_AGENT</text>
          <text x="220" y="110" class="sch-card-title">Split &amp; delegate ×2</text>
        </g>

        <g class="sch-node" data-sch-phase="2">
          <rect x="385" y="77" width="148" height="44" rx="5" class="sch-shadow" />
          <rect x="382" y="74" width="148" height="44" rx="5" class="sch-card" />
          <rect x="382" y="74" width="148" height="5" rx="2" fill="var(--sch-amber)" />
          <text x="393" y="94" class="sch-card-pixel">WRITE · BASH</text>
          <text x="393" y="110" class="sch-card-title">Implement core CLI</text>
        </g>

        <g class="sch-node" data-sch-phase="3">
          <rect x="562" y="77" width="150" height="44" rx="5" class="sch-shadow" />
          <rect x="559" y="74" width="150" height="44" rx="5" class="sch-card" />
          <rect x="559" y="74" width="150" height="5" rx="2" fill="var(--sch-blue)" />
          <text x="570" y="94" class="sch-card-pixel">USER → STEER</text>
          <text x="570" y="110" class="sch-card-title">Forward symlink spec</text>
        </g>

        <g class="sch-node" data-sch-phase="4">
          <rect x="742" y="77" width="148" height="44" rx="5" class="sch-shadow" />
          <rect x="739" y="74" width="148" height="44" rx="5" class="sch-card" />
          <rect x="739" y="74" width="148" height="5" rx="2" fill="var(--sch-purple)" />
          <text x="750" y="94" class="sch-card-pixel">VERIFY · FIX</text>
          <text x="750" y="110" class="sch-card-title">Run tests &amp; fix edges</text>
        </g>

        <g class="sch-node" data-sch-phase="5">
          <rect x="920" y="77" width="124" height="44" rx="5" class="sch-shadow" />
          <rect x="917" y="74" width="124" height="44" rx="5" class="sch-card sch-card-yellow" />
          <text x="928" y="94" class="sch-card-pixel">RUNTIME.CLOSE</text>
          <text x="928" y="110" class="sch-card-title">Archive &amp; cleanup</text>
        </g>

        <!-- Lane 2 (/root/patterns) -->
        <g class="sch-node" data-sch-phase="2">
          <rect x="385" y="189" width="148" height="44" rx="5" class="sch-shadow" />
          <rect x="382" y="186" width="148" height="44" rx="5" class="sch-card" />
          <rect x="382" y="186" width="148" height="5" rx="2" fill="var(--sch-teal)" />
          <text x="393" y="206" class="sch-card-pixel">TOOL · PROBE</text>
          <text x="393" y="222" class="sch-card-title">Probe regex / glob</text>
        </g>

        <g class="sch-node" data-sch-phase="3">
          <rect x="562" y="189" width="136" height="44" rx="5" class="sch-shadow" />
          <rect x="559" y="186" width="136" height="44" rx="5" class="sch-card" />
          <rect x="559" y="186" width="136" height="5" rx="2" fill="var(--sch-blue)" />
          <text x="570" y="206" class="sch-card-pixel">STEER INJECT</text>
          <text x="570" y="222" class="sch-card-title">Add symlink suite</text>
        </g>

        <g class="sch-node" data-sch-phase="4">
          <rect x="716" y="189" width="76" height="44" rx="5" class="sch-shadow" />
          <rect x="713" y="186" width="76" height="44" rx="5" class="sch-card" />
          <rect x="713" y="186" width="76" height="5" rx="2" fill="var(--sch-teal)" />
          <text x="751" y="207" text-anchor="middle" class="sch-card-pixel">EVENT</text>
          <text x="751" y="222" text-anchor="middle" class="sch-card-title">settled</text>
        </g>

        <!-- Lane 3 (/root/filters) -->
        <g class="sch-node" data-sch-phase="2">
          <rect x="385" y="292" width="148" height="44" rx="5" class="sch-shadow" />
          <rect x="382" y="289" width="148" height="44" rx="5" class="sch-card" />
          <rect x="382" y="289" width="148" height="5" rx="2" fill="var(--sch-amber)" />
          <text x="393" y="309" class="sch-card-pixel">MODEL · AUDIT</text>
          <text x="393" y="325" class="sch-card-title">Audit CLI filter flags</text>
        </g>

        <g class="sch-node" data-sch-phase="3">
          <rect x="562" y="292" width="150" height="44" rx="5" class="sch-shadow" />
          <rect x="559" y="289" width="150" height="44" rx="5" class="sch-card" />
          <rect x="559" y="289" width="150" height="5" rx="2" fill="var(--sch-amber)" />
          <text x="570" y="309" class="sch-card-pixel">WRITE SUITE</text>
          <text x="570" y="325" class="sch-card-title">Write 66 filter tests</text>
        </g>

        <g class="sch-node" data-sch-phase="4">
          <rect x="742" y="292" width="112" height="44" rx="5" class="sch-shadow" />
          <rect x="739" y="289" width="112" height="44" rx="5" class="sch-card" />
          <rect x="739" y="289" width="112" height="5" rx="2" fill="var(--sch-indigo)" />
          <text x="795" y="309" text-anchor="middle" class="sch-card-pixel">SERVICE</text>
          <text x="795" y="325" text-anchor="middle" class="sch-card-title">send_message</text>
        </g>
      </svg>
    </div>

    <figcaption class="schematic-caption">
      <span class="caption-step" data-phase-tag>OVERVIEW</span>
      <span data-phase-note>
        Step through each phase or press Play to inspect delegation, parallel execution, non-waking steer, and archive-before-delete closeout. Every run persists structured artifacts to <code>outputDir/&lt;runId&gt;/</code>.
      </span>
    </figcaption>
  </figure>
</div>

<script is:inline>
  (function () {
    const figure = document.querySelector('[data-swimlane-schematic]');
    if (!figure) return;

    const meta = {
      all: {
        tag: 'OVERVIEW',
        note: 'Step through each phase or press Play to inspect delegation, parallel execution, non-waking steer, and archive-before-delete closeout. Every run persists structured artifacts to outputDir/<runId>/.',
      },
      '1': {
        tag: '01 · SPAWN',
        note: '/root calls collaboration.spawn_agent to spin up named children. The Runtime allocates isolated sandboxes and optionally shares a workspace or forks parent context.',
      },
      '2': {
        tag: '02 · PARALLEL',
        note: 'All three agents run concurrently inside separate Pi sessions and containers with enforced disk and network limits — upstream API keys never leave the host.',
      },
      '3': {
        tag: '03 · STEER',
        note: 'When a mid-flight requirement arrives, the host calls send({ mode: "steer", wakeIfIdle: false }): busy agents receive it before their next turn, while idle ones stay undisturbed in the mailbox.',
      },
      '4': {
        tag: '04 · HANDOFF',
        note: 'Children report back via settled events and send_message; /root runs the handed-off test suite in the shared workspace and fixes failing edge cases.',
      },
      '5': {
        tag: '05 · CLOSE',
        note: 'runtime.close() strictly stops Pi, archives raw sessions, exports required collect files, and only then deletes containers and writes runtime.json.',
      },
    };

    const buttons = figure.querySelectorAll('[data-phase]');
    const nodes = figure.querySelectorAll('[data-sch-phase]');
    const tagEl = figure.querySelector('[data-phase-tag]');
    const noteEl = figure.querySelector('[data-phase-note]');
    const playBtn = figure.querySelector('[data-sch-play]');
    const playIcon = figure.querySelector('[data-play-icon]');
    const playLabel = figure.querySelector('[data-play-label]');

    let timer = null;
    const seq = ['1', '2', '3', '4', '5', 'all'];
    let seqIdx = 0;

    function selectPhase(phase) {
      buttons.forEach((btn) => {
        const active = btn.getAttribute('data-phase') === phase;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      nodes.forEach((node) => {
        const match = phase === 'all' || node.getAttribute('data-sch-phase') === phase;
        node.classList.toggle('dimmed', !match);
        node.classList.toggle('focused', phase !== 'all' && match);
      });
      const info = meta[phase] || meta.all;
      if (tagEl) tagEl.textContent = info.tag;
      if (noteEl) noteEl.textContent = info.note;
    }

    function stopPlay() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
      if (playIcon) playIcon.textContent = '▶';
      if (playLabel) playLabel.textContent = 'Play walkthrough';
      playBtn?.classList.remove('playing');
    }

    function startPlay() {
      seqIdx = 0;
      selectPhase(seq[seqIdx]);
      if (playIcon) playIcon.textContent = '❚❚';
      if (playLabel) playLabel.textContent = 'Pause';
      playBtn?.classList.add('playing');
      timer = setInterval(() => {
        seqIdx = (seqIdx + 1) % seq.length;
        selectPhase(seq[seqIdx]);
      }, 2400);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        stopPlay();
        selectPhase(btn.getAttribute('data-phase') || 'all');
      });
    });

    playBtn?.addEventListener('click', () => {
      if (timer) stopPlay();
      else startPlay();
    });
  })();
</script>
