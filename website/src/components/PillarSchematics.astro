---
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const items = isZh
  ? [
      { kicker: '01 / MINIMAL', title: '极简内核', desc: '像 Pi 一样克制，只保留最正交的运行原语' },
      { kicker: '02 / EXTENSIBLE', title: '灵活可扩展', desc: '随时切换或自定义协作结构，不改底层引擎' },
      { kicker: '03 / TRANSPARENT', title: '全链路透明', desc: '内置轨迹回放，跨 Agent 问题一眼定位' },
    ]
  : [
      { kicker: '01 / MINIMAL', title: 'Minimal core', desc: 'Small, orthogonal runtime primitives — like Pi' },
      { kicker: '02 / EXTENSIBLE', title: 'Easy to extend', desc: 'Change collaboration structure without rewrites' },
      { kicker: '03 / TRANSPARENT', title: 'Full transparency', desc: 'Built-in trace replay to pinpoint every issue' },
    ];
---

<div class="slogan-row" aria-label={isZh ? '三大核心能力' : 'Three core runtime promises'}>
  <div class="slogan-item">
    <svg class="arch-icon" viewBox="0 0 36 36" width="34" height="34" fill="none" aria-hidden="true">
      <rect x="6" y="7" width="24" height="22" rx="4" fill="var(--accent-soft)" stroke="var(--ink)" stroke-width="1.6" />
      <line x1="6" y1="14" x2="30" y2="14" stroke="var(--ink)" stroke-width="1.4" />
      <rect x="10" y="18" width="8" height="6" rx="1.5" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.3" />
      <line x1="21" y1="19.5" x2="26" y2="19.5" stroke="var(--sch-indigo)" stroke-width="1.8" stroke-linecap="round" />
      <line x1="21" y1="23" x2="25" y2="23" stroke="var(--sch-indigo)" stroke-width="1.8" stroke-linecap="round" />
      <circle cx="10.5" cy="10.5" r="1.2" fill="var(--sch-indigo)" />
      <circle cx="14.5" cy="10.5" r="1.2" fill="var(--ink-muted)" />
    </svg>
    <span class="slogan-kicker">{items[0].kicker}</span>
    <h3>{items[0].title}</h3>
    <p>{items[0].desc}</p>
  </div>

  <div class="slogan-item">
    <svg class="arch-icon" viewBox="0 0 36 36" width="34" height="34" fill="none" aria-hidden="true">
      <path d="M 12 18 H 18 M 18 18 C 21 18, 21 11, 24 11 M 18 18 C 21 18, 21 25, 24 25" stroke="var(--sch-teal)" stroke-width="1.7" stroke-linecap="round" />
      <rect x="5" y="13" width="8" height="10" rx="2.5" fill="var(--bg-elevated)" stroke="var(--ink)" stroke-width="1.6" />
      <rect x="14" y="14" width="6" height="8" rx="1.8" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.4" />
      <rect x="24" y="7" width="7" height="8" rx="2" fill="var(--teal-soft)" stroke="var(--ink)" stroke-width="1.5" />
      <rect x="24" y="21" width="7" height="8" rx="2" fill="var(--accent-soft)" stroke="var(--ink)" stroke-width="1.5" />
    </svg>
    <span class="slogan-kicker">{items[1].kicker}</span>
    <h3>{items[1].title}</h3>
    <p>{items[1].desc}</p>
  </div>

  <div class="slogan-item">
    <svg class="arch-icon" viewBox="0 0 36 36" width="34" height="34" fill="none" aria-hidden="true">
      <rect x="5" y="7" width="26" height="22" rx="4" fill="var(--bg-elevated)" stroke="var(--ink)" stroke-width="1.6" />
      <rect x="9" y="11" width="9" height="4" rx="1.5" fill="var(--sch-indigo)" />
      <rect x="14" y="17" width="12" height="4" rx="1.5" fill="var(--sch-teal)" />
      <rect x="11" y="23" width="11" height="3.5" rx="1.5" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.1" />
      <circle cx="24" cy="13" r="2" fill="var(--sch-amber)" />
    </svg>
    <span class="slogan-kicker">{items[2].kicker}</span>
    <h3>{items[2].title}</h3>
    <p>{items[2].desc}</p>
  </div>
</div>
