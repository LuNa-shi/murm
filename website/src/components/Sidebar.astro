---
import { getDocNav, normalizeSlug } from '../lib/nav';
import { UI, docHref, type Lang } from '../lib/i18n';

interface Props {
  currentSlug: string;
  lang?: Lang;
}

const { currentSlug, lang = 'en' } = Astro.props;
const active = normalizeSlug(currentSlug);
const groups = getDocNav(lang);
const t = UI[lang];
---

<aside class="docs-sidebar" id="docs-sidebar" aria-label={t.sidebarAria}>
  {groups.map((group) => (
    <div class="sidebar-group">
      <div class="sidebar-label">{group.label}</div>
      <ul class="sidebar-list">
        {group.items.map((item) => {
          const isCurrent = normalizeSlug(item.slug) === active;
          return (
            <li>
              <a
                class:list={['sidebar-link', { active: isCurrent }]}
                href={docHref(lang, item.slug)}
                aria-current={isCurrent ? 'page' : undefined}
              >
                <span>{item.title}</span>
                {item.badge && <span class="sidebar-badge">{item.badge}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</aside>
