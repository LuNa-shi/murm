---
import MurmLogo from './MurmLogo.astro';
import { UI, homeHref, type Lang } from '../lib/i18n';

interface Props {
  showMobileMenu?: boolean;
  lang?: Lang;
  switchHref: string;
}

const { showMobileMenu = false, lang = 'en', switchHref } = Astro.props;
const t = UI[lang];
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
---

<header class="top-nav">
  <div class="top-nav-inner">
    <div class="nav-left">
      {showMobileMenu && (
        <button type="button" class="icon-btn mobile-menu-btn" id="mobile-menu-toggle" aria-label={t.menuAria}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="4" y1="6" x2="20" y2="6" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="18" x2="20" y2="18" />
          </svg>
        </button>
      )}
      <a class="brand-link" href={homeHref(lang)}>
        <MurmLogo variant="nav" />
        <span>murm</span>
      </a>
    </div>

    <div class="nav-actions">
      <button type="button" class="search-trigger" id="search-open-btn" aria-label={t.searchAria}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <span>{t.searchBtn}</span>
        <kbd>⌘K</kbd>
      </button>

      <a
        class="lang-switch-btn"
        href={switchHref}
        data-lang-switch={otherLang}
        aria-label={t.switchAria}
        title={t.switchAria}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
        </svg>
        <span>{t.switchLabel}</span>
      </a>

      <button type="button" class="icon-btn" data-theme-toggle aria-label={t.themeAria} title={t.themeTitle}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
      </button>

      <a
        class="icon-btn"
        href="https://github.com/LuNa-shi/murm"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub repository"
        title="GitHub"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
        </svg>
      </a>
    </div>
  </div>
</header>
