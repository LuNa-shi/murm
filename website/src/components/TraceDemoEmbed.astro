---
import { withBase } from '../lib/url';
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';

const embedHref = withBase('/trace-demo/index.html?run=release-notes&embed=1');
const fullHref = withBase('/trace-demo/index.html?run=release-notes');

const copy = isZh
  ? {
      badge: '实时交互泳道',
      tabs: [
        { view: 'timeline', label: '泳道时间线' },
        { view: 'collaboration', label: '协作交接 (2)' },
        { view: 'artifacts', label: '产物与文件' },
      ],
      hint: '滚轮缩放 · 拖拽平移 · 悬浮看耗时 · 点击条块打开证据面板',
      openNew: '打开完整版 ↗',
      iframeTitle: 'murm Trace Viewer 实时交互泳道（release-notes 运行记录）',
    }
  : {
      badge: 'LIVE SWIMLANE',
      tabs: [
        { view: 'timeline', label: 'Swimlane Timeline' },
        { view: 'collaboration', label: 'Collaboration (2)' },
        { view: 'artifacts', label: 'Files & Results' },
      ],
      hint: 'Wheel to zoom · Drag to pan · Hover for timing · Click any bar to inspect',
      openNew: 'Open full viewer ↗',
      iframeTitle: 'Interactive murm Trace Viewer live swimlane (release-notes Run)',
    };
---

<section class="trace-embed-shell" id="live-demo" data-trace-demo-embed>
  <div class="trace-embed-bar">
    <div class="trace-embed-meta">
      <span class="pixel-badge">{copy.badge}</span>
      <div class="trace-outer-tabs" role="tablist" aria-label={isZh ? '切换展示视图' : 'Switch Trace Viewer panel'}>
        {copy.tabs.map((tab, idx) => (
          <button
            type="button"
            class:list={['trace-outer-tab', { active: idx === 0 }]}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            data-trace-outer-tab={tab.view}
          >
            {tab.label}
          </button>
        ))}
      </div>
    </div>
    <div class="trace-embed-actions">
      <a class="trace-embed-btn trace-embed-link" href={fullHref} target="_blank" rel="noreferrer">
        {copy.openNew}
      </a>
    </div>
  </div>

  <div class="trace-embed-frame-wrap" data-trace-frame-wrap>
    <iframe
      class="trace-embed-iframe"
      src={embedHref}
      title={copy.iframeTitle}
      scrolling="no"
      data-trace-iframe
    ></iframe>
  </div>

  <div class="trace-embed-foot">
    <span>{copy.hint}</span>
    <code>release-notes · Subagents</code>
  </div>
</section>

<script is:inline>
  (function initTraceDemoEmbed() {
    document.querySelectorAll('[data-trace-demo-embed]').forEach((wrap) => {
      if (wrap.dataset.bound === '1') return;
      wrap.dataset.bound = '1';

      const iframe = wrap.querySelector('[data-trace-iframe]');
      const frameWrap = wrap.querySelector('[data-trace-frame-wrap]');
      const tabs = wrap.querySelectorAll('[data-trace-outer-tab]');

      function syncTheme() {
        if (!iframe || !iframe.contentWindow) return;
        const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        iframe.contentWindow.postMessage({ type: 'murm:theme', theme }, window.location.origin);
      }

      tabs.forEach((btn) => {
        btn.addEventListener('click', () => {
          const view = btn.getAttribute('data-trace-outer-tab');
          tabs.forEach((t) => {
            const active = t === btn;
            t.classList.toggle('active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          if (iframe && iframe.contentWindow && view) {
            iframe.contentWindow.postMessage({ type: 'murm:trace-view', view }, window.location.origin);
          }
        });
      });

      window.addEventListener('message', (event) => {
        if (event.origin !== window.location.origin) return;
        if (event.data && event.data.type === 'murm:trace-height' && typeof event.data.height === 'number') {
          if (frameWrap && iframe && event.source === iframe.contentWindow) {
            frameWrap.style.height = Math.max(380, Math.min(860, event.data.height)) + 'px';
          }
        }
      });

      if (iframe) {
        iframe.addEventListener('load', syncTheme);
        const obs = new MutationObserver(syncTheme);
        obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      }
    });
  })();
</script>
