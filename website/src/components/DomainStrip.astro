---
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';

const copy = isZh
  ? {
      eyebrow: '04 · 统一平台',
      title: '一个 Runtime，横跨多领域',
      descPre: '复用同一套 Runtime 与 ',
      descHighlight: 'Harness',
      descPost: ' —— 只需替换工作区与领域验证器。',
      domains: [
        {
          kicker: 'CODING · 编程',
          title: '软件工程',
          desc: '多个 Agent 在共享工作区、个人特性分支与自动化测试套件上并行协作。',
        },
        {
          kicker: 'FORMAL MATH · 形式化数学',
          title: '定理证明',
          desc: '由可插拔形式化验证服务与版本化主干驱动的分布式证明搜索。',
        },
        {
          kicker: 'RESEARCH · 科研探索',
          title: '开放式综合研究',
          desc: '多智能体自主探索，让发现沉淀在跨 Agent 持久化的引文图谱中。',
        },
      ],
    }
  : {
      eyebrow: '04 · ONE UNIFORM PLATFORM',
      title: 'One runtime across domains',
      descPre: 'Keep the same runtime and ',
      descHighlight: 'harnesses',
      descPost: ' — swap only the workspace and domain verifier.',
      domains: [
        {
          kicker: 'CODING',
          title: 'Software Engineering',
          desc: 'Parallel agents working across shared workspaces, feature branches, and automated test suites.',
        },
        {
          kicker: 'FORMAL MATH',
          title: 'Theorem Proving',
          desc: 'Distributed proof search guided by a pluggable formal verifier service and versioned proof trunks.',
        },
        {
          kicker: 'RESEARCH',
          title: 'Open-Ended Synthesis',
          desc: 'Autonomous exploration where findings persist in a shared citation graph beyond individual agents.',
        },
      ],
    };
---

<section class="chapter landing-section domain-section">
  <div class="chapter-rule" data-reveal-line aria-hidden="true"></div>

  <div class="section-header" data-reveal style="--reveal-delay: 40ms">
    <div>
      <p class="section-eyebrow">{copy.eyebrow}</p>
      <h2 class="section-title">{copy.title}</h2>
      <p class="section-desc">
        {copy.descPre}<span class="marker-highlight">{copy.descHighlight}</span>{copy.descPost}
      </p>
    </div>
  </div>

  <div class="domain-grid">
    <!-- 01: CODING -->
    <article class="domain-item" data-reveal style="--reveal-delay: 100ms">
      <div class="domain-emblem" aria-hidden="true">
        <svg viewBox="0 0 72 72" width="68" height="68" fill="none">
          <rect x="11" y="13" width="52" height="46" rx="7" fill="var(--ink)" opacity="0.12" />
          <rect x="8" y="10" width="52" height="46" rx="7" fill="var(--bg-elevated)" stroke="var(--ink)" stroke-width="1.8" />
          <path d="M 8 17 C 8 13.1 11.1 10 15 10 H 53 C 56.9 10 60 13.1 60 17 V 21 H 8 V 17 Z" fill="var(--accent-soft)" />
          <line x1="8" y1="21" x2="60" y2="21" stroke="var(--ink)" stroke-width="1.5" />
          <circle cx="15" cy="15.5" r="2" fill="var(--sch-indigo)" />
          <circle cx="21.5" cy="15.5" r="2" fill="var(--ink-muted)" />
          <path d="M 18 30 L 14 35 L 18 40" stroke="var(--sch-indigo)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M 25 30 L 29 35 L 25 40" stroke="var(--sch-indigo)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <line x1="38" y1="28" x2="38" y2="48" stroke="var(--ink)" stroke-width="1.9" stroke-linecap="round" />
          <path d="M 49 32 C 49 38, 38 38, 38 44" stroke="var(--sch-indigo)" stroke-width="2" stroke-linecap="round" stroke-dasharray="3 2.5" />
          <circle cx="38" cy="29" r="3.2" fill="var(--bg-elevated)" stroke="var(--ink)" stroke-width="1.6" />
          <circle cx="49" cy="31" r="3.2" fill="var(--accent-soft)" stroke="var(--sch-indigo)" stroke-width="1.7" />
          <circle cx="38" cy="46" r="4.5" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.7" />
          <rect x="46" y="45" width="18" height="14" rx="3.5" fill="var(--sch-indigo)" stroke="var(--ink)" stroke-width="1.5" />
          <path d="M 51 52 L 54 55 L 59.5 49.5" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <span class="domain-kicker">{copy.domains[0].kicker}</span>
      <h3>{copy.domains[0].title}</h3>
      <p>{copy.domains[0].desc}</p>
    </article>

    <!-- 02: FORMAL MATH -->
    <article class="domain-item" data-reveal style="--reveal-delay: 200ms">
      <div class="domain-emblem" aria-hidden="true">
        <svg viewBox="0 0 72 72" width="68" height="68" fill="none">
          <rect x="11" y="13" width="52" height="46" rx="7" fill="var(--ink)" opacity="0.12" />
          <rect x="8" y="10" width="52" height="46" rx="7" fill="var(--bg-elevated)" stroke="var(--ink)" stroke-width="1.8" />
          <line x1="8" y1="25" x2="60" y2="25" stroke="var(--border)" stroke-width="1" />
          <line x1="8" y1="41" x2="60" y2="41" stroke="var(--border)" stroke-width="1" />
          <path d="M 18 20 V 45 M 18 32.5 H 29" stroke="var(--sch-teal)" stroke-width="2.4" stroke-linecap="round" />
          <rect x="31" y="17" width="18" height="8" rx="2.5" fill="var(--teal-soft)" stroke="var(--sch-teal)" stroke-width="1.5" />
          <rect x="31" y="29" width="18" height="8" rx="2.5" fill="var(--teal-soft)" stroke="var(--ink)" stroke-width="1.5" />
          <path d="M 40 25 V 29 M 40 37 V 42" stroke="var(--sch-teal)" stroke-width="1.8" stroke-linecap="round" />
          <rect x="34" y="42" width="12" height="9" rx="2" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.6" />
          <circle cx="57" cy="52" r="9" fill="var(--sch-teal)" stroke="var(--ink)" stroke-width="1.6" />
          <path d="M 53.2 52 L 56 54.8 L 61.2 49.5" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <span class="domain-kicker domain-kicker-teal">{copy.domains[1].kicker}</span>
      <h3>{copy.domains[1].title}</h3>
      <p>{copy.domains[1].desc}</p>
    </article>

    <!-- 03: RESEARCH -->
    <article class="domain-item" data-reveal style="--reveal-delay: 300ms">
      <div class="domain-emblem" aria-hidden="true">
        <svg viewBox="0 0 72 72" width="68" height="68" fill="none">
          <rect x="11" y="13" width="52" height="46" rx="7" fill="var(--ink)" opacity="0.12" />
          <rect x="8" y="10" width="52" height="46" rx="7" fill="var(--bg-elevated)" stroke="var(--ink)" stroke-width="1.8" />
          <path d="M 18 44 L 25 32 M 30 44 L 25 32 M 30 44 L 39 32 M 42 44 L 39 32 M 25 32 L 32 19 M 39 32 L 32 19" stroke="var(--sch-amber)" stroke-width="1.9" stroke-linecap="round" />
          <circle cx="18" cy="44" r="3.8" fill="var(--amber-soft)" stroke="var(--ink)" stroke-width="1.6" />
          <circle cx="30" cy="44" r="3.8" fill="var(--amber-soft)" stroke="var(--ink)" stroke-width="1.6" />
          <circle cx="42" cy="44" r="3.8" fill="var(--amber-soft)" stroke="var(--ink)" stroke-width="1.6" />
          <rect x="19" y="28" width="12" height="8" rx="2.5" fill="var(--bg-elevated)" stroke="var(--sch-amber)" stroke-width="1.6" />
          <rect x="33" y="28" width="12" height="8" rx="2.5" fill="var(--bg-elevated)" stroke="var(--sch-purple)" stroke-width="1.6" />
          <rect x="24" y="15" width="16" height="8.5" rx="2.8" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.7" />
          <rect x="47" y="45" width="18" height="14" rx="3.5" fill="var(--sch-amber)" stroke="var(--ink)" stroke-width="1.5" />
          <path d="M 56 48.2 L 57.1 50.9 L 59.8 52 L 57.1 53.1 L 56 55.8 L 54.9 53.1 L 52.2 52 L 54.9 50.9 Z" fill="#ffffff" />
        </svg>
      </div>
      <span class="domain-kicker domain-kicker-amber">{copy.domains[2].kicker}</span>
      <h3>{copy.domains[2].title}</h3>
      <p>{copy.domains[2].desc}</p>
    </article>
  </div>
</section>
