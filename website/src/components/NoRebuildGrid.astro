---
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';

const copy = isZh
  ? {
      eyebrow: '01 · 为什么选择 MURM',
      title: '为什么不从零拼脚本，也不被单拓扑框架绑死？',
      descPre: '用极简内核提供容器隔离、安全网关与全链路观测，把协作结构彻底还给你。',
      descPost: ' 让你更快部署、清晰解耦、平滑扩展到任意多智能体形态。',
      cards: [
        {
          title: '换拓扑，不换 Runtime',
          desc: '在子智能体树、任务池、对等工程师网格与共享研究黑板之间自由切换，底层运行引擎一行不改。',
        },
        {
          title: '隔离清晰，密钥留在宿主机',
          desc: '每个 Agent 运行在独立 OpenSandbox 容器中，模型密钥与外部凭据始终留在宿主机网关。',
        },
        {
          title: '共享协作层自由插拔',
          desc: 'Agent A 通过共享 Service 写入发现或代码状态，Agent B 读取并续做——任务池、邮箱、Git 或验证器皆可即插即用。',
        },
        {
          title: '每次运行，全程可检视',
          desc: '模型请求、工具执行、跨 Agent 交接与导出文件自动归档，一条 murm trace 命令即可缩放回放。',
        },
      ],
      compareTitle: '与其他多智能体方案对比',
      legend: { yes: '原生支持', partial: '需自建 / 受限', no: '不支持' },
      compareCols: [
        { title: '核心能力', sub: '' },
        { title: '工作流 / 图框架', sub: 'LangGraph · CrewAI' },
        { title: '单拓扑 Agent / 脚本', sub: 'Agensh · 自研胶水' },
        { title: 'murm', sub: '极简多智能体底座' },
      ],
      compareRows: [
        {
          dim: '协作拓扑自由度',
          workflow: { status: 'partial', note: '偏图 / 流水线' },
          bespoke: { status: 'no', note: '绑定单一模式' },
          murm: { status: 'yes', note: '任意拓扑可切换' },
        },
        {
          dim: 'Agent 运行隔离',
          workflow: { status: 'no', note: '共享宿主进程' },
          bespoke: { status: 'partial', note: '依赖宿主环境' },
          murm: { status: 'yes', note: '每 Agent 独立容器' },
        },
        {
          dim: '密钥与权限边界',
          workflow: { status: 'no', note: '凭据在进程内' },
          bespoke: { status: 'partial', note: '手工拼装鉴权' },
          murm: { status: 'yes', note: '宿主机统一拦截' },
        },
        {
          dim: '长会话编码 Agent',
          workflow: { status: 'partial', note: '偏无状态节点' },
          bespoke: { status: 'yes', note: '支持持久会话' },
          murm: { status: 'yes', note: 'Pi · Codex · 自定义' },
        },
        {
          dim: '共享状态与验证器',
          workflow: { status: 'partial', note: '偏进程内状态' },
          bespoke: { status: 'partial', note: '与调度紧耦合' },
          murm: { status: 'yes', note: '可插拔 Services' },
        },
        {
          dim: '跨 Agent 可观测性',
          workflow: { status: 'partial', note: '依赖外接平台' },
          bespoke: { status: 'no', note: '仅文本日志' },
          murm: { status: 'yes', note: '内置零依赖回放' },
        },
      ],
    }
  : {
      eyebrow: '01 · WHY MURM',
      title: 'Why murm instead of custom glue or single-pattern tools?',
      descPre: 'A minimal runtime owns container isolation, host-gated secrets, and trace replay — leaving coordination completely open. ',
      descPost: ' gives you cleaner boundaries, faster deployment, and effortless scaling across topologies.',
      cards: [
        {
          title: 'Swap topologies, not runtimes',
          desc: 'Move between subagent trees, leased task pools, peer meshes, or shared research boards without touching the core engine.',
        },
        {
          title: 'Clean isolation, host-only keys',
          desc: 'Every agent runs in its own OpenSandbox container while model keys and external credentials stay strictly on the host.',
        },
        {
          title: 'Pluggable shared Services',
          desc: 'Agent A writes a finding or patch through a shared Service and Agent B reads it — plug in boards, pools, Git, or verifiers.',
        },
        {
          title: 'Every run, fully inspectable',
          desc: 'Model calls, tool runs, cross-agent handoffs, and exported files are archived automatically for instant murm trace replay.',
        },
      ],
      compareTitle: 'How murm compares',
      legend: { yes: 'Built-in', partial: 'Partial / DIY', no: 'Not built-in' },
      compareCols: [
        { title: 'Capability', sub: '' },
        { title: 'Workflow / Graph', sub: 'LangGraph · CrewAI' },
        { title: 'Single-Topology', sub: 'Agensh · Custom scripts' },
        { title: 'murm', sub: 'Minimal MAS runtime' },
      ],
      compareRows: [
        {
          dim: 'Topology flexibility',
          workflow: { status: 'partial', note: 'Graph / DAG bias' },
          bespoke: { status: 'no', note: 'Single pattern' },
          murm: { status: 'yes', note: 'Any topology' },
        },
        {
          dim: 'Agent isolation',
          workflow: { status: 'no', note: 'Shared process' },
          bespoke: { status: 'partial', note: 'Host-coupled' },
          murm: { status: 'yes', note: 'Per-agent sandbox' },
        },
        {
          dim: 'Secret & tool boundaries',
          workflow: { status: 'no', note: 'In-process keys' },
          bespoke: { status: 'partial', note: 'Custom glue' },
          murm: { status: 'yes', note: 'Host-gated' },
        },
        {
          dim: 'Coding agent runtime',
          workflow: { status: 'partial', note: 'Prompt nodes' },
          bespoke: { status: 'yes', note: 'Real CLI agents' },
          murm: { status: 'yes', note: 'Pi · Codex · custom' },
        },
        {
          dim: 'Shared state & verifiers',
          workflow: { status: 'partial', note: 'In-memory state' },
          bespoke: { status: 'partial', note: 'Hard-coded' },
          murm: { status: 'yes', note: 'Pluggable Services' },
        },
        {
          dim: 'Multi-agent observability',
          workflow: { status: 'partial', note: 'External SaaS' },
          bespoke: { status: 'no', note: 'Text logs only' },
          murm: { status: 'yes', note: 'Built-in trace UI' },
        },
      ],
    };

type CompareStatus = 'yes' | 'partial' | 'no';
const statusLabel = (status: CompareStatus) =>
  status === 'yes' ? copy.legend.yes : status === 'partial' ? copy.legend.partial : copy.legend.no;
---

<section class="chapter landing-section why-section">
  <div class="chapter-rule" data-reveal-line aria-hidden="true"></div>

  <div class="section-header" data-reveal style="--reveal-delay: 40ms">
    <div>
      <p class="section-eyebrow">{copy.eyebrow}</p>
      <h2 class="section-title">{copy.title}</h2>
      <p class="section-desc">
        {copy.descPre}<code>murm</code>{copy.descPost}
      </p>
    </div>
  </div>

  <div class="pillars-four">
    <article class="truth-item" data-reveal style="--reveal-delay: 90ms">
      <svg class="arch-icon-md" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
        <path d="M 20 14 V 20 M 11 26 V 20 H 29 V 26" stroke="var(--sch-indigo)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="14" y="6" width="12" height="8" rx="2.5" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.6" />
        <rect x="6" y="26" width="10" height="8" rx="2.5" fill="var(--accent-soft)" stroke="var(--ink)" stroke-width="1.6" />
        <rect x="24" y="26" width="10" height="8" rx="2.5" fill="var(--teal-soft)" stroke="var(--ink)" stroke-width="1.6" />
      </svg>
      <h3>{copy.cards[0].title}</h3>
      <p>{copy.cards[0].desc}</p>
    </article>

    <article class="truth-item" data-reveal style="--reveal-delay: 160ms">
      <svg class="arch-icon-md" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
        <path d="M 20 6 L 32 11 V 20 C 32 27.2 26.8 32.4 20 35 C 13.2 32.4 8 27.2 8 20 V 11 L 20 6 Z" fill="var(--accent-soft)" stroke="var(--ink)" stroke-width="1.6" stroke-linejoin="round" />
        <rect x="15.5" y="18.5" width="9" height="7" rx="1.8" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.4" />
        <path d="M 17.5 18.5 V 16 C 17.5 14.3 18.6 13.2 20 13.2 C 21.4 13.2 22.5 14.3 22.5 16 V 18.5" stroke="var(--ink)" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <h3>{copy.cards[1].title}</h3>
      <p>{copy.cards[1].desc}</p>
    </article>

    <article class="truth-item" data-reveal style="--reveal-delay: 230ms">
      <svg class="arch-icon-md" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
        <rect x="6" y="15" width="10" height="10" rx="2.5" fill="var(--bg-elevated)" stroke="var(--ink)" stroke-width="1.6" />
        <path d="M 16 20 H 23 M 23 20 L 28 12 M 23 20 L 28 28" stroke="var(--sch-teal)" stroke-width="1.8" stroke-linecap="round" />
        <rect x="26" y="7" width="8" height="8" rx="2" fill="var(--teal-soft)" stroke="var(--ink)" stroke-width="1.5" />
        <rect x="26" y="25" width="8" height="8" rx="2" fill="var(--amber-soft)" stroke="var(--ink)" stroke-width="1.5" />
        <circle cx="20" cy="20" r="3.5" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.4" />
      </svg>
      <h3>{copy.cards[2].title}</h3>
      <p>{copy.cards[2].desc}</p>
    </article>

    <article class="truth-item" data-reveal style="--reveal-delay: 300ms">
      <svg class="arch-icon-md" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
        <rect x="8" y="6" width="24" height="28" rx="3.5" fill="var(--bg-elevated)" stroke="var(--ink)" stroke-width="1.6" />
        <rect x="8" y="6" width="24" height="7" rx="3" fill="var(--amber-soft)" stroke="var(--ink)" stroke-width="1.4" />
        <line x1="13" y1="18.5" x2="27" y2="18.5" stroke="var(--sch-indigo)" stroke-width="1.8" stroke-linecap="round" />
        <line x1="13" y1="23.5" x2="24" y2="23.5" stroke="var(--sch-teal)" stroke-width="1.8" stroke-linecap="round" />
        <rect x="13" y="27.5" width="10" height="3" rx="1.2" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1" />
      </svg>
      <h3>{copy.cards[3].title}</h3>
      <p>{copy.cards[3].desc}</p>
    </article>
  </div>

  <div class="why-compare-wrap" data-reveal style="--reveal-delay: 240ms">
    <div class="why-compare-head">
      <div class="why-compare-title-group">
        <span class="pixel-badge">{isZh ? '架构对比' : 'COMPARISON'}</span>
        <h3>{copy.compareTitle}</h3>
      </div>
      <div class="why-compare-legend" aria-label={isZh ? '图例' : 'Legend'}>
        <span class="why-legend-item">
          <span class="cmp-badge cmp-badge-sm cmp-yes" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2.2 6.3 4.8 8.9 9.8 3.3" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          {copy.legend.yes}
        </span>
        <span class="why-legend-item">
          <span class="cmp-badge cmp-badge-sm cmp-partial" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><circle cx="6" cy="6" r="4.1" stroke="currentColor" stroke-width="1.5" /><path d="M6 1.9A4.1 4.1 0 0 1 6 10.1Z" fill="currentColor" /></svg>
          </span>
          {copy.legend.partial}
        </span>
        <span class="why-legend-item">
          <span class="cmp-badge cmp-badge-sm cmp-no" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M3 3 9 9M9 3 3 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </span>
          {copy.legend.no}
        </span>
      </div>
    </div>
    <div class="why-compare-scroll">
      <table class="why-compare-table">
        <thead>
          <tr>
            {copy.compareCols.map((col, i) => (
              <th class={i === 3 ? 'why-col-murm' : undefined}>
                <span>{col.title}</span>
                {col.sub && <span class="why-col-sub">{col.sub}</span>}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {copy.compareRows.map((row) => (
            <tr>
              <td class="why-dim">{row.dim}</td>
              {[row.workflow, row.bespoke, row.murm].map((cell, idx) => (
                <td class={idx === 2 ? 'why-col-murm' : undefined}>
                  <div class="why-cell">
                    <span
                      class={`cmp-badge cmp-${cell.status}`}
                      role="img"
                      aria-label={statusLabel(cell.status as CompareStatus)}
                    >
                      {cell.status === 'yes' && (
                        <svg width="13" height="13" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                          <path d="M2.2 6.3 4.8 8.9 9.8 3.3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      )}
                      {cell.status === 'partial' && (
                        <svg width="13" height="13" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                          <circle cx="6" cy="6" r="4.1" stroke="currentColor" stroke-width="1.5" />
                          <path d="M6 1.9A4.1 4.1 0 0 1 6 10.1Z" fill="currentColor" />
                        </svg>
                      )}
                      {cell.status === 'no' && (
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                          <path d="M3 3 9 9M9 3 3 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                      )}
                    </span>
                    <span class="why-cell-note">{cell.note}</span>
                  </div>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
