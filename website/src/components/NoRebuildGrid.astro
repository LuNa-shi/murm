---
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';

const copy = isZh
  ? {
      eyebrow: '01 · 为什么选择 MURM',
      title: '为什么不从零拼脚本，也不被单拓扑框架绑死？',
      descPre: '用极简内核提供容器隔离、安全网关与全链路观测，把协作结构彻底还给你。',
      descPost: ' 让你更快部署、清晰解耦、平滑扩展到任意多智能体形态。',
      cards: [
        {
          title: '换拓扑，不换 Runtime',
          desc: '在子智能体树、任务池、对等工程师网格与共享研究黑板之间自由切换，底层运行引擎一行不改。',
        },
        {
          title: '隔离清晰，密钥留在宿主机',
          desc: '每个 Agent 运行在独立 OpenSandbox 容器中，模型密钥与外部凭据始终留在宿主机网关。',
        },
        {
          title: '共享协作层自由插拔',
          desc: 'Agent A 通过共享 Service 写入发现或代码状态，Agent B 读取并续做——任务池、邮箱、Git 或验证器皆可即插即用。',
        },
        {
          title: '每次运行，全程可检视',
          desc: '模型请求、工具执行、跨 Agent 交接与导出文件自动归档，一条 murm trace 命令即可缩放回放。',
        },
      ],
      compareTitle: '与其他多智能体方案的架构对比',
      compareCols: ['对比维度', '工作流 / 图框架（如 LangGraph / CrewAI）', '单拓扑开源 Agent / 自研脚本（如 Agensh）', 'murm'],
      compareRows: [
        {
          dim: '架构清晰度',
          workflow: '偏无状态提示词节点编排；容器隔离、文件快照与长会话控制需自行补齐',
          bespoke: '围绕单一固定协作模式实现，切换拓扑往往需要重写调度器与鉴权层',
          murm: '极简 Runtime 与协作层彻底解耦，只改 Harness 和 Services 即可换拓扑',
        },
        {
          dim: '部署体验',
          workflow: '沙箱、密钥隔离与日志采集需按项目各自拼装',
          bespoke: '常绑定特定环境或重型外部基础设施',
          murm: '单一安装包 + murm setup --mode local 一键就绪，也支持接入远程 OpenSandbox',
        },
        {
          dim: '并发与扩展',
          workflow: '进程内共享内存/目录，多 Agent 并发写代码易互相踩踏',
          bespoke: '难以在不同团队规模、角色镜像与领域验证器之间复用',
          murm: '每 Agent 独立容器、显式并发槽位与角色镜像，从 2 人平滑扩展到大规模集群',
        },
        {
          dim: '调试透明度',
          workflow: '日志分散在外部平台，难以关联文件变更与跨 Agent 调用',
          bespoke: '多依赖文本日志，跨 Agent 因果交接难以追溯',
          murm: '内置零依赖 murm trace 泳道视图，一键贯通模型上下文、协作交接与产物',
        },
      ],
    }
  : {
      eyebrow: '01 · WHY MURM',
      title: 'Why murm instead of custom glue or single-pattern tools?',
      descPre: 'A minimal runtime owns container isolation, host-gated secrets, and trace replay — leaving coordination completely open. ',
      descPost: ' gives you cleaner boundaries, faster deployment, and effortless scaling across topologies.',
      cards: [
        {
          title: 'Swap topologies, not runtimes',
          desc: 'Move between subagent trees, leased task pools, peer meshes, or shared research boards without touching the core engine.',
        },
        {
          title: 'Clean isolation, host-only keys',
          desc: 'Every agent runs in its own OpenSandbox container while model keys and external credentials stay strictly on the host.',
        },
        {
          title: 'Pluggable shared Services',
          desc: 'Agent A writes a finding or patch through a shared Service and Agent B reads it — plug in boards, pools, Git, or verifiers.',
        },
        {
          title: 'Every run, fully inspectable',
          desc: 'Model calls, tool runs, cross-agent handoffs, and exported files are archived automatically for instant murm trace replay.',
        },
      ],
      compareTitle: 'How murm compares across architectures',
      compareCols: ['Dimension', 'Workflow / graph frameworks (LangGraph, CrewAI)', 'Single-topology agents / custom scripts (e.g. Agensh)', 'murm'],
      compareRows: [
        {
          dim: 'Architectural clarity',
          workflow: 'Built for stateless prompt graphs; sandboxing, file snapshots, and persistent sessions are DIY glue',
          bespoke: 'Wired around one fixed pattern; changing team topology means rewriting runner and auth logic',
          murm: 'Minimal core separates execution from collaboration — swap only the Harness and Services',
        },
        {
          dim: 'Deployment',
          workflow: 'Container lifecycle, secret brokering, and trace storage assembled per project',
          bespoke: 'Often coupled to custom local setups or fixed external stacks',
          murm: 'One package + murm setup --mode local (or connect to a shared OpenSandbox service)',
        },
        {
          dim: 'Scaling',
          workflow: 'Shared process state and host directories collide as parallel coding agents grow',
          bespoke: 'Hard to reuse cleanly across team sizes, role images, and external verifiers',
          murm: 'Per-agent containers, explicit capacity slots, and per-role images scale cleanly',
        },
        {
          dim: 'Observability',
          workflow: 'External dashboards disconnected from sandbox files and agent-to-agent handoffs',
          bespoke: 'Mostly plain text logs with limited cross-agent causality',
          murm: 'Built-in zero-dependency murm trace UI linking model contexts, handoffs, and artifacts',
        },
      ],
    };
---

<section class="chapter landing-section why-section">
  <div class="chapter-rule" data-reveal-line aria-hidden="true"></div>

  <div class="section-header" data-reveal style="--reveal-delay: 40ms">
    <div>
      <p class="section-eyebrow">{copy.eyebrow}</p>
      <h2 class="section-title">{copy.title}</h2>
      <p class="section-desc">
        {copy.descPre}<code>murm</code>{copy.descPost}
      </p>
    </div>
  </div>

  <div class="pillars-four">
    <article class="truth-item" data-reveal style="--reveal-delay: 90ms">
      <svg class="arch-icon-md" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
        <path d="M 20 14 V 20 M 11 26 V 20 H 29 V 26" stroke="var(--sch-indigo)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="14" y="6" width="12" height="8" rx="2.5" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.6" />
        <rect x="6" y="26" width="10" height="8" rx="2.5" fill="var(--accent-soft)" stroke="var(--ink)" stroke-width="1.6" />
        <rect x="24" y="26" width="10" height="8" rx="2.5" fill="var(--teal-soft)" stroke="var(--ink)" stroke-width="1.6" />
      </svg>
      <h3>{copy.cards[0].title}</h3>
      <p>{copy.cards[0].desc}</p>
    </article>

    <article class="truth-item" data-reveal style="--reveal-delay: 160ms">
      <svg class="arch-icon-md" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
        <path d="M 20 6 L 32 11 V 20 C 32 27.2 26.8 32.4 20 35 C 13.2 32.4 8 27.2 8 20 V 11 L 20 6 Z" fill="var(--accent-soft)" stroke="var(--ink)" stroke-width="1.6" stroke-linejoin="round" />
        <rect x="15.5" y="18.5" width="9" height="7" rx="1.8" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.4" />
        <path d="M 17.5 18.5 V 16 C 17.5 14.3 18.6 13.2 20 13.2 C 21.4 13.2 22.5 14.3 22.5 16 V 18.5" stroke="var(--ink)" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <h3>{copy.cards[1].title}</h3>
      <p>{copy.cards[1].desc}</p>
    </article>

    <article class="truth-item" data-reveal style="--reveal-delay: 230ms">
      <svg class="arch-icon-md" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
        <rect x="6" y="15" width="10" height="10" rx="2.5" fill="var(--bg-elevated)" stroke="var(--ink)" stroke-width="1.6" />
        <path d="M 16 20 H 23 M 23 20 L 28 12 M 23 20 L 28 28" stroke="var(--sch-teal)" stroke-width="1.8" stroke-linecap="round" />
        <rect x="26" y="7" width="8" height="8" rx="2" fill="var(--teal-soft)" stroke="var(--ink)" stroke-width="1.5" />
        <rect x="26" y="25" width="8" height="8" rx="2" fill="var(--amber-soft)" stroke="var(--ink)" stroke-width="1.5" />
        <circle cx="20" cy="20" r="3.5" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.4" />
      </svg>
      <h3>{copy.cards[2].title}</h3>
      <p>{copy.cards[2].desc}</p>
    </article>

    <article class="truth-item" data-reveal style="--reveal-delay: 300ms">
      <svg class="arch-icon-md" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
        <rect x="8" y="6" width="24" height="28" rx="3.5" fill="var(--bg-elevated)" stroke="var(--ink)" stroke-width="1.6" />
        <rect x="8" y="6" width="24" height="7" rx="3" fill="var(--amber-soft)" stroke="var(--ink)" stroke-width="1.4" />
        <line x1="13" y1="18.5" x2="27" y2="18.5" stroke="var(--sch-indigo)" stroke-width="1.8" stroke-linecap="round" />
        <line x1="13" y1="23.5" x2="24" y2="23.5" stroke="var(--sch-teal)" stroke-width="1.8" stroke-linecap="round" />
        <rect x="13" y="27.5" width="10" height="3" rx="1.2" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1" />
      </svg>
      <h3>{copy.cards[3].title}</h3>
      <p>{copy.cards[3].desc}</p>
    </article>
  </div>

  <div class="why-compare-wrap" data-reveal style="--reveal-delay: 240ms">
    <div class="why-compare-head">
      <span class="pixel-badge">{isZh ? '架构对比' : 'COMPARISON'}</span>
      <h3>{copy.compareTitle}</h3>
    </div>
    <div class="why-compare-scroll">
      <table class="why-compare-table">
        <thead>
          <tr>
            <th>{copy.compareCols[0]}</th>
            <th>{copy.compareCols[1]}</th>
            <th>{copy.compareCols[2]}</th>
            <th class="why-col-murm">{copy.compareCols[3]}</th>
          </tr>
        </thead>
        <tbody>
          {copy.compareRows.map((row) => (
            <tr>
              <td class="why-dim">{row.dim}</td>
              <td>{row.workflow}</td>
              <td>{row.bespoke}</td>
              <td class="why-col-murm">{row.murm}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
