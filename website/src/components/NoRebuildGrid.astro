---
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';

const copy = isZh
  ? {
      eyebrow: '01 · 为什么选择 MURM',
      title: '在同一底座上构建不同协作机制',
      descPre: '角色、任务分配和共享状态由你的 Harness 决定。',
      descPost: ' 提供隔离执行、Service 接入、统一 CLI 与内置轨迹观测。',
      cards: [
        {
          title: '换拓扑，不换 Runtime',
          desc: '在子智能体树、任务池、对等工程师网格与引文图谱之间自由切换，无需改动底层引擎。',
        },
        {
          title: '隔离执行与明确权限',
          desc: '每个 Agent 运行在独立容器与配额边界内，模型密钥始终留在宿主机上，绝不进入沙箱。',
        },
        {
          title: '通过可定制 Services 协作',
          desc: '自由创建任务板、邮箱、Git 或验证器等共享服务——例如 Agent A 通过某个 Service 发布发现或补丁，Agent B 通过同一 Service 读取并续做，全部经由 Schema 校验网关。',
        },
        {
          title: '每次运行，全程可检视',
          desc: '会话、模型请求与 Service 调用完整落盘，用内置 murm trace 浏览器直接回放时间线并核对清理回执。',
        },
      ],
    }
  : {
      eyebrow: '01 · WHY MURM',
      title: 'Build different mechanisms on one runtime',
      descPre: 'Your Harness defines roles, work allocation, and shared state. ',
      descPost: ' supplies isolated execution, Service integration, a host CLI, and built-in trace observation.',
      cards: [
        {
          title: 'Swap topologies, not runtimes',
          desc: 'Switch between subagents, task pools, peer meshes, or citation graphs without touching the core engine.',
        },
        {
          title: 'Isolated execution and explicit authority',
          desc: 'Every agent runs in its own container with strict quotas; model keys never leave the host.',
        },
        {
          title: 'Coordinate through customized services',
          desc: 'Plug in task boards, mailboxes, Git repos, or formal verifiers — e.g. Agent A publishes a finding or patch via a Service and Agent B reads it to build on it, all behind one schema-checked gateway.',
        },
        {
          title: 'Every run, fully inspectable',
          desc: 'Inspect saved sessions, model exchanges, and Service handoffs in the built-in murm trace browser alongside artifact and cleanup receipts.',
        },
      ],
    };
---

<section class="chapter landing-section why-section">
  <div class="chapter-rule" data-reveal-line aria-hidden="true"></div>

  <div class="section-header" data-reveal style="--reveal-delay: 40ms">
    <div>
      <p class="section-eyebrow">{copy.eyebrow}</p>
      <h2 class="section-title">{copy.title}</h2>
      <p class="section-desc">
        {copy.descPre}<code>murm</code>{copy.descPost}
      </p>
    </div>
  </div>

  <div class="pillars-four">
    <article class="truth-item" data-reveal style="--reveal-delay: 90ms">
      <svg class="arch-icon-md" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
        <path d="M 20 14 V 20 M 11 26 V 20 H 29 V 26" stroke="var(--sch-indigo)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="14" y="6" width="12" height="8" rx="2.5" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.6" />
        <rect x="6" y="26" width="10" height="8" rx="2.5" fill="var(--accent-soft)" stroke="var(--ink)" stroke-width="1.6" />
        <rect x="24" y="26" width="10" height="8" rx="2.5" fill="var(--teal-soft)" stroke="var(--ink)" stroke-width="1.6" />
      </svg>
      <h3>{copy.cards[0].title}</h3>
      <p>{copy.cards[0].desc}</p>
    </article>

    <article class="truth-item" data-reveal style="--reveal-delay: 160ms">
      <svg class="arch-icon-md" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
        <path d="M 20 6 L 32 11 V 20 C 32 27.2 26.8 32.4 20 35 C 13.2 32.4 8 27.2 8 20 V 11 L 20 6 Z" fill="var(--accent-soft)" stroke="var(--ink)" stroke-width="1.6" stroke-linejoin="round" />
        <rect x="15.5" y="18.5" width="9" height="7" rx="1.8" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.4" />
        <path d="M 17.5 18.5 V 16 C 17.5 14.3 18.6 13.2 20 13.2 C 21.4 13.2 22.5 14.3 22.5 16 V 18.5" stroke="var(--ink)" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <h3>{copy.cards[1].title}</h3>
      <p>{copy.cards[1].desc}</p>
    </article>

    <article class="truth-item" data-reveal style="--reveal-delay: 230ms">
      <svg class="arch-icon-md" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
        <rect x="6" y="15" width="10" height="10" rx="2.5" fill="var(--bg-elevated)" stroke="var(--ink)" stroke-width="1.6" />
        <path d="M 16 20 H 23 M 23 20 L 28 12 M 23 20 L 28 28" stroke="var(--sch-teal)" stroke-width="1.8" stroke-linecap="round" />
        <rect x="26" y="7" width="8" height="8" rx="2" fill="var(--teal-soft)" stroke="var(--ink)" stroke-width="1.5" />
        <rect x="26" y="25" width="8" height="8" rx="2" fill="var(--amber-soft)" stroke="var(--ink)" stroke-width="1.5" />
        <circle cx="20" cy="20" r="3.5" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.4" />
      </svg>
      <h3>{copy.cards[2].title}</h3>
      <p>{copy.cards[2].desc}</p>
    </article>

    <article class="truth-item" data-reveal style="--reveal-delay: 300ms">
      <svg class="arch-icon-md" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
        <rect x="8" y="6" width="24" height="28" rx="3.5" fill="var(--bg-elevated)" stroke="var(--ink)" stroke-width="1.6" />
        <rect x="8" y="6" width="24" height="7" rx="3" fill="var(--amber-soft)" stroke="var(--ink)" stroke-width="1.4" />
        <line x1="13" y1="18.5" x2="27" y2="18.5" stroke="var(--sch-indigo)" stroke-width="1.8" stroke-linecap="round" />
        <line x1="13" y1="23.5" x2="24" y2="23.5" stroke="var(--sch-teal)" stroke-width="1.8" stroke-linecap="round" />
        <rect x="13" y="27.5" width="10" height="3" rx="1.2" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1" />
      </svg>
      <h3>{copy.cards[3].title}</h3>
      <p>{copy.cards[3].desc}</p>
    </article>
  </div>
</section>
