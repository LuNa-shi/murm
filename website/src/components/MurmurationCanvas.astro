---
---

<canvas
  class="murm-sky-canvas"
  data-murm-sky
  aria-hidden="true"
></canvas>

<script is:inline>
  (function initSlowMotionBirds() {
    if (window.__murmBirdsInit) return;
    window.__murmBirdsInit = true;

    const canvas = document.querySelector('[data-murm-sky]');
    const ctx = canvas && canvas.getContext ? canvas.getContext('2d') : null;
    if (!canvas || !ctx) return;

    const reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let paused = reduced;
    let width = window.innerWidth;
    let height = window.innerHeight;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    // 6 graceful soaring birds in a loose diagonal passage (bottom-left -> top-right)
    // Carefully seeded so 2-3 large birds & their broad cast shadows are visible right on load
    const SEED_FLOCK = [
      { rx: 0.72, ry: 0.22, span: 126, alt: 0.92, speed: 0.28, angle: -0.34, phase: 0.4,  freq: 0.00105, alpha: 0.19 },
      { rx: 0.18, ry: 0.54, span: 142, alt: 1.08, speed: 0.32, angle: -0.30, phase: 2.3,  freq: 0.00092, alpha: 0.17 },
      { rx: 0.84, ry: 0.36, span: 94,  alt: 0.76, speed: 0.24, angle: -0.36, phase: 4.1,  freq: 0.00118, alpha: 0.16 },
      { rx: 0.34, ry: 0.82, span: 108, alt: 0.86, speed: 0.26, angle: -0.32, phase: 1.5,  freq: 0.00100, alpha: 0.15 },
      { rx: 0.56, ry: 0.14, span: 72,  alt: 0.62, speed: 0.21, angle: -0.38, phase: 5.0,  freq: 0.00128, alpha: 0.13 },
      { rx: -0.08, ry: 0.74, span: 84, alt: 0.70, speed: 0.23, angle: -0.33, phase: 3.2,  freq: 0.00112, alpha: 0.14 },
    ];

    let birds = [];

    function resetFlock() {
      const mobile = width < 768;
      const list = mobile ? SEED_FLOCK.slice(0, 4) : SEED_FLOCK;
      const scaleFactor = mobile ? 0.72 : 1;
      birds = list.map((s) => ({
        x: s.rx * width,
        y: s.ry * height,
        span: s.span * scaleFactor,
        alt: s.alt,
        speed: s.speed,
        angle: s.angle,
        phase: s.phase,
        freq: s.freq,
        alpha: s.alpha,
        swayPhase: s.phase * 1.7,
      }));
    }

    function resize() {
      const prevW = width || window.innerWidth;
      const prevH = height || window.innerHeight;
      width = window.innerWidth;
      height = window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      if (!birds.length) {
        resetFlock();
      } else {
        for (const b of birds) {
          b.x = (b.x / prevW) * width;
          b.y = (b.y / prevH) * height;
        }
      }
    }

    // Draw one sculptural soaring swift/swallow silhouette from above (wings arch forward at wrist, sweep gracefully back to slender tips)
    function traceBirdPath(c, span, flap) {
      const s = span * 0.5;
      // Organic slow-motion wing flex: wrist rises gently, outer primaries sweep back gracefully
      const wristX = s * (0.44 - Math.max(0, flap) * 0.05);
      const wristY = -s * (0.24 - flap * 0.06);
      const tipX = s * (1.0 - Math.abs(flap) * 0.14);
      const tipY = s * (0.18 + flap * 0.26);

      c.beginPath();
      // Slender head / beak pointing along -Y
      c.moveTo(0, -s * 0.40);
      c.bezierCurveTo(s * 0.07, -s * 0.34, s * 0.09, -s * 0.24, s * 0.13, -s * 0.18);
      // Right wing leading edge: shoulder -> arched wrist -> swept-back tapered tip
      c.bezierCurveTo(s * 0.28, wristY - s * 0.06, wristX + s * 0.26, wristY - s * 0.04, tipX, tipY);
      // Right wing trailing edge: graceful inward curve back to body waist
      c.bezierCurveTo(s * 0.68, tipY - s * 0.04, s * 0.34, s * 0.04, s * 0.07, s * 0.14);
      // Elegant forked swallow tail
      c.lineTo(s * 0.14, s * 0.50);
      c.lineTo(0, s * 0.30);
      c.lineTo(-s * 0.14, s * 0.50);
      c.lineTo(-s * 0.07, s * 0.14);
      // Left wing trailing edge -> swept tip
      c.bezierCurveTo(-s * 0.34, s * 0.04, -s * 0.68, tipY - s * 0.04, -tipX, tipY);
      // Left wing leading edge -> wrist -> head
      c.bezierCurveTo(-(wristX + s * 0.26), wristY - s * 0.04, -s * 0.28, wristY - s * 0.06, -s * 0.13, -s * 0.18);
      c.bezierCurveTo(-s * 0.09, -s * 0.24, -s * 0.07, -s * 0.34, 0, -s * 0.40);
      c.closePath();
    }

    function drawFrame(now, dt) {
      const isDark = document.documentElement.dataset.theme === 'dark';
      const birdRgb = isDark ? '210, 220, 240' : '30, 34, 42';
      const shadowRgb = isDark ? '74, 104, 230' : '22, 28, 42';

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, height);

      const pad = 210;

      for (const b of birds) {
        // Gentle slow thermal drift + diagonal glide
        const heading = b.angle + Math.sin(now * 0.00022 + b.swayPhase) * 0.055;
        if (dt > 0) {
          const step = b.speed * (dt / 16.67);
          b.x += Math.cos(heading) * step;
          b.y += Math.sin(heading) * step;

          // Seamless re-entry from lower-left / bottom corridor once off-screen
          if (b.x > width + pad || b.y < -pad) {
            if (Math.random() < 0.6) {
              b.x = -pad * 0.75 - Math.random() * 80;
              b.y = height * (0.32 + Math.random() * 0.68);
            } else {
              b.x = width * (0.04 + Math.random() * 0.58);
              b.y = height + pad * 0.65 + Math.random() * 60;
            }
          }
        }

        // Slow, natural soaring wingbeat (mostly long glide, gentle slow stroke)
        const cyc = now * b.freq + b.phase;
        const raw = Math.sin(cyc);
        const flap = raw * 0.68 + Math.sin(cyc * 2) * 0.12;

        // Smooth fade near outer viewport edges so birds arrive & depart peacefully
        const edgeX = Math.min((b.x + pad) / 140, (width + pad - b.x) / 140, 1);
        const edgeY = Math.min((b.y + pad) / 140, (height + pad - b.y) / 140, 1);
        const vis = Math.max(0, Math.min(edgeX, edgeY));
        if (vis <= 0.01) continue;

        // Rotate silhouette so beak (+0,-1 in local coords) points along heading
        const rot = heading + Math.PI * 0.5;

        // 1. LARGE SOFT CAST SHADOW on the paper surface (projected offset down-right)
        const sx = b.x + b.alt * 78;
        const sy = b.y + b.alt * 102;
        const shadowSpan = b.span * (1.42 + b.alt * 0.28);
        const shadowAlpha = (isDark ? 0.08 : 0.078) * vis;

        // Broad atmospheric penumbra cloud beneath the bird
        const penumbraR = shadowSpan * 0.68;
        const grad = ctx.createRadialGradient(sx, sy, shadowSpan * 0.06, sx, sy, penumbraR);
        grad.addColorStop(0, 'rgba(' + shadowRgb + ',' + (shadowAlpha * 0.72).toFixed(4) + ')');
        grad.addColorStop(0.55, 'rgba(' + shadowRgb + ',' + (shadowAlpha * 0.28).toFixed(4) + ')');
        grad.addColorStop(1, 'rgba(' + shadowRgb + ',0)');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.ellipse(sx, sy, penumbraR, penumbraR * 0.68, heading, 0, Math.PI * 2);
        ctx.fill();

        // Soft diffused silhouette shadow
        ctx.save();
        ctx.translate(sx, sy);
        ctx.rotate(rot);
        ctx.scale(1.12, 0.88);
        if ('filter' in ctx) {
          ctx.filter = 'blur(' + Math.round(10 + b.alt * 7) + 'px)';
        }
        traceBirdPath(ctx, shadowSpan, flap * 0.75);
        ctx.fillStyle = 'rgba(' + shadowRgb + ',' + (shadowAlpha * 1.15).toFixed(4) + ')';
        ctx.fill();
        ctx.restore();

        // 2. LARGE SLOW-MOTION SOARING BIRD SILHOUETTE
        ctx.save();
        ctx.translate(b.x, b.y);
        ctx.rotate(rot);
        traceBirdPath(ctx, b.span, flap);
        ctx.fillStyle = 'rgba(' + birdRgb + ',' + (b.alpha * vis).toFixed(4) + ')';
        ctx.fill();
        ctx.restore();
      }
    }

    function syncToggleButtons() {
      document.querySelectorAll('[data-murm-toggle]').forEach((btn) => {
        btn.setAttribute('aria-pressed', paused ? 'true' : 'false');
        btn.setAttribute('title', paused ? 'Resume soaring birds' : 'Pause soaring birds');
      });
    }

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-murm-toggle]')) {
        paused = !paused;
        syncToggleButtons();
      }
    });

    resize();
    window.addEventListener('resize', resize, { passive: true });
    syncToggleButtons();

    // Render initial serene frame immediately
    let lastNow = performance.now();
    drawFrame(lastNow, 0);

    function tick(now) {
      const dt = Math.min(64, Math.max(0, now - lastNow));
      lastNow = now;
      if (!paused && !document.hidden) {
        drawFrame(now, dt);
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  })();
</script>
