---
---

<canvas
  class="murm-sky-canvas"
  data-murm-sky
  aria-hidden="true"
></canvas>

<script is:inline>
  (function initBoidsMurmuration() {
    if (window.__murmBoidsInit) return;
    window.__murmBoidsInit = true;

    const canvas = document.querySelector('[data-murm-sky]');
    const ctx = canvas && canvas.getContext ? canvas.getContext('2d') : null;
    if (!canvas || !ctx) return;

    const reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let paused = reduced;
    let width = window.innerWidth;
    let height = window.innerHeight;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let scrollFade = 1;

    function updateScrollFade() {
      const fadeEnd = Math.max(420, height * 0.78);
      const t = Math.max(0, Math.min(1, window.scrollY / fadeEnd));
      // Smooth ease-out fade as user scrolls past the Hero title
      const eased = 1 - t * t * (3 - 2 * t);
      scrollFade = eased;
      canvas.style.opacity = eased.toFixed(3);
    }

    window.addEventListener('scroll', updateScrollFade, { passive: true });

    let boids = [];

    function seedFlock() {
      const count = width < 768 ? 7 : 12;
      const scale = width < 768 ? 0.74 : 1;
      boids = [];
      // Seed as two loose, graceful soaring clusters across upper-right and lower-left Hero sky
      for (let i = 0; i < count; i++) {
        const group = i % 2;
        const cx = group === 0 ? width * 0.72 : width * 0.24;
        const cy = group === 0 ? height * 0.28 : height * 0.52;
        const spreadX = (Math.random() - 0.5) * width * 0.34;
        const spreadY = (Math.random() - 0.5) * height * 0.28;
        const baseAngle = -0.35 + (Math.random() - 0.5) * 0.55;
        const alt = 0.62 + (i / count) * 0.58; // depth / altitude 0.62..1.20
        const spd = 0.44 + alt * 0.26;
        boids.push({
          x: cx + spreadX,
          y: cy + spreadY,
          vx: Math.cos(baseAngle) * spd,
          vy: Math.sin(baseAngle) * spd,
          heading: baseAngle,
          bank: 0,
          span: (58 + alt * 56) * scale, // large 78px..126px wingspan
          alt,
          alpha: 0.12 + alt * 0.09,
          phase: Math.random() * Math.PI * 2,
          flapFreq: 0.0011 + Math.random() * 0.00045,
          glideOffset: Math.random() * 10,
        });
      }
    }

    function resize() {
      const prevW = width || window.innerWidth;
      const prevH = height || window.innerHeight;
      width = window.innerWidth;
      height = window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      if (!boids.length) {
        seedFlock();
      } else {
        for (const b of boids) {
          b.x = (b.x / prevW) * width;
          b.y = (b.y / prevH) * height;
        }
      }
      updateScrollFade();
    }

    function wrapAngle(a) {
      while (a > Math.PI) a -= Math.PI * 2;
      while (a < -Math.PI) a += Math.PI * 2;
      return a;
    }

    // Refined 2-joint articulated bird silhouette with elbow-wrist phase lag + banking foreshortening
    function drawRefinedBird(c, span, innerFlap, outerFlap, bank, fillStyle) {
      const s = span * 0.5;
      // Subtle 3D banking foreshortening when curving left/right
      const scaleR = Math.max(0.66, 1 - bank * 0.42);
      const scaleL = Math.max(0.66, 1 + bank * 0.42);

      // Right wing landmarks (shoulder -> wrist -> outer primary tip)
      const rWristX = s * 0.43 * scaleR;
      const rWristY = -s * (0.20 - innerFlap * 0.14);
      const rTipX = s * (1.02 - Math.abs(outerFlap) * 0.12) * scaleR;
      const rTipY = s * (0.14 + outerFlap * 0.28);
      const rSecX = s * 0.52 * scaleR;
      const rSecY = s * (0.05 + innerFlap * 0.12);

      // Left wing landmarks
      const lWristX = -s * 0.43 * scaleL;
      const lWristY = -s * (0.20 - innerFlap * 0.14);
      const lTipX = -s * (1.02 - Math.abs(outerFlap) * 0.12) * scaleL;
      const lTipY = s * (0.14 + outerFlap * 0.28);
      const lSecX = -s * 0.52 * scaleL;
      const lSecY = s * (0.05 + innerFlap * 0.12);

      c.beginPath();
      // Tapered head & slender neck
      c.moveTo(0, -s * 0.42);
      c.bezierCurveTo(s * 0.05, -s * 0.36, s * 0.06, -s * 0.24, s * 0.10, -s * 0.17);
      // Right leading edge: graceful arch through wrist out to slender tapered primary tip
      c.bezierCurveTo(rWristX * 0.58, rWristY - s * 0.07, rWristX * 1.18, rWristY - s * 0.05, rTipX, rTipY);
      // Right trailing edge: subtle sculpted primary notch -> smooth secondary curve -> waist
      c.bezierCurveTo(rTipX * 0.78, rTipY + s * 0.03, rSecX * 1.12, rSecY + s * 0.06, rSecX * 0.65, rSecY);
      c.bezierCurveTo(s * 0.24 * scaleR, s * 0.05, s * 0.12 * scaleR, s * 0.10, s * 0.055, s * 0.16);
      // Elegant forked swift tail
      c.bezierCurveTo(s * 0.08, s * 0.30, s * 0.13, s * 0.42, s * 0.12, s * 0.52);
      c.bezierCurveTo(s * 0.06, s * 0.42, s * 0.03, s * 0.35, 0, s * 0.30);
      c.bezierCurveTo(-s * 0.03, s * 0.35, -s * 0.06, s * 0.42, -s * 0.12, s * 0.52);
      c.bezierCurveTo(-s * 0.13, s * 0.42, -s * 0.08, s * 0.30, -s * 0.055, s * 0.16);
      // Left trailing edge -> left tip
      c.bezierCurveTo(-s * 0.12 * scaleL, s * 0.10, -s * 0.24 * scaleL, s * 0.05, lSecX * 0.65, lSecY);
      c.bezierCurveTo(lSecX * 1.12, lSecY + s * 0.06, lTipX * 0.78, lTipY + s * 0.03, lTipX, lTipY);
      // Left leading edge -> wrist -> head
      c.bezierCurveTo(lWristX * 1.18, lWristY - s * 0.05, lWristX * 0.58, lWristY - s * 0.07, -s * 0.10, -s * 0.17);
      c.bezierCurveTo(-s * 0.06, -s * 0.24, -s * 0.05, -s * 0.36, 0, -s * 0.42);
      c.closePath();

      c.fillStyle = fillStyle;
      c.fill();
    }

    function stepBoids(now, dt) {
      if (dt <= 0) return;
      const stepScale = dt / 16.67;

      // Slow organic shifting flock attractor (wandering wind thermal across Hero sky)
      const windCenterX = width * (0.5 + 0.32 * Math.sin(now * 0.00016));
      const windCenterY = height * (0.38 + 0.18 * Math.cos(now * 0.00021));

      for (let i = 0; i < boids.length; i++) {
        const b = boids[i];
        let sepX = 0, sepY = 0;
        let aliX = 0, aliY = 0, aliN = 0;
        let cohX = 0, cohY = 0, cohN = 0;

        for (let j = 0; j < boids.length; j++) {
          if (i === j) continue;
          const o = boids[j];
          const dx = o.x - b.x;
          const dy = o.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < 68000 && d2 > 1) {
            aliX += o.vx; aliY += o.vy; aliN++;
            cohX += o.x; cohY += o.y; cohN++;
            if (d2 < 14400) {
              const d = Math.sqrt(d2);
              const push = (1 - d / 120);
              sepX -= (dx / d) * push;
              sepY -= (dy / d) * push;
            }
          }
        }

        // Reynolds Boids forces tuned for serene slow-motion cohesion
        let fx = sepX * 0.014;
        let fy = sepY * 0.014;

        if (aliN > 0) {
          fx += ((aliX / aliN) - b.vx) * 0.016;
          fy += ((aliY / aliN) - b.vy) * 0.016;
        }
        if (cohN > 0) {
          fx += ((cohX / cohN) - b.x) * 0.000018;
          fy += ((cohY / cohN) - b.y) * 0.000018;
        }

        // Smooth spatial wind-field randomness (gentle soaring curves, never rigid)
        const fieldAngle =
          Math.sin(b.x * 0.0018 + now * 0.00018) * 1.4 +
          Math.cos(b.y * 0.0021 - now * 0.00015) * 1.2;
        fx += Math.cos(fieldAngle) * 0.0038;
        fy += Math.sin(fieldAngle) * 0.0038;

        // Gentle homing pull toward drifting thermal so flock stays gracefully in Hero view
        fx += (windCenterX - b.x) * 0.000016;
        fy += (windCenterY - b.y) * 0.000020;

        // Soft margin cushion
        const margin = 90;
        if (b.x < margin) fx += 0.012;
        if (b.x > width - margin) fx -= 0.012;
        if (b.y < margin * 0.7) fy += 0.014;
        if (b.y > height * 0.86) fy -= 0.014;

        const prevHeading = b.heading;
        b.vx += fx * stepScale;
        b.vy += fy * stepScale;

        // Clamp speed to serene slow motion
        const minSpd = 0.36 + b.alt * 0.12;
        const maxSpd = 0.62 + b.alt * 0.24;
        const spd = Math.hypot(b.vx, b.vy) || 0.001;
        if (spd > maxSpd) {
          b.vx = (b.vx / spd) * maxSpd;
          b.vy = (b.vy / spd) * maxSpd;
        } else if (spd < minSpd) {
          b.vx = (b.vx / spd) * minSpd;
          b.vy = (b.vy / spd) * minSpd;
        }

        // Smooth angular inertia so turns look graceful, never jittery
        const desired = Math.atan2(b.vy, b.vx);
        const turnDelta = wrapAngle(desired - prevHeading);
        const maxTurn = 0.018 * stepScale;
        const appliedTurn = Math.max(-maxTurn, Math.min(maxTurn, turnDelta));
        b.heading = prevHeading + appliedTurn;

        const curSpd = Math.hypot(b.vx, b.vy);
        b.vx = Math.cos(b.heading) * curSpd;
        b.vy = Math.sin(b.heading) * curSpd;

        // Smooth 3D bank proportional to turn rate
        const targetBank = Math.max(-0.55, Math.min(0.55, appliedTurn * 24));
        b.bank += (targetBank - b.bank) * 0.06;

        b.x += b.vx * stepScale;
        b.y += b.vy * stepScale;
      }
    }

    function drawFrame(now, dt) {
      stepBoids(now, dt);

      const isDark = document.documentElement.dataset.theme === 'dark';
      const birdRgb = isDark ? '208, 219, 240' : '28, 32, 42';
      const shadowRgb = isDark ? '74, 104, 230' : '20, 26, 40';

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, height);

      // Sort by altitude (lower birds first, higher birds above)
      const ordered = boids.slice().sort((a, b) => a.alt - b.alt);

      for (const b of ordered) {
        // Soaring-dominant wingbeat envelope: long calm glides punctuated by 1-2 slow deep strokes
        const glideWave = Math.max(0, Math.sin(now * 0.00032 + b.glideOffset));
        const beatAmp = 0.22 + glideWave * 0.78;
        const tCycle = now * b.flapFreq + b.phase;
        const innerFlap = Math.sin(tCycle) * 0.55 * beatAmp;
        // Wrist/outer primary lags behind shoulder by 0.62 rad -> organic bird wing ripple
        const outerFlap = Math.sin(tCycle - 0.62) * 0.72 * beatAmp;

        const rot = b.heading + Math.PI * 0.5;

        // 1. LARGE SOFT CAST SHADOW gliding on the sunlit paper below-right
        const sx = b.x + b.alt * 74;
        const sy = b.y + b.alt * 96;
        const shadowSpan = b.span * (1.38 + b.alt * 0.26);
        const shadowAlpha = isDark ? 0.072 : 0.068;

        // Soft diffused shadow wash
        const washR = shadowSpan * 0.62;
        const wash = ctx.createRadialGradient(sx, sy, shadowSpan * 0.05, sx, sy, washR);
        wash.addColorStop(0, 'rgba(' + shadowRgb + ',' + (shadowAlpha * 0.65).toFixed(4) + ')');
        wash.addColorStop(0.55, 'rgba(' + shadowRgb + ',' + (shadowAlpha * 0.24).toFixed(4) + ')');
        wash.addColorStop(1, 'rgba(' + shadowRgb + ',0)');
        ctx.fillStyle = wash;
        ctx.beginPath();
        ctx.ellipse(sx, sy, washR, washR * 0.65, b.heading, 0, Math.PI * 2);
        ctx.fill();

        ctx.save();
        ctx.translate(sx, sy);
        ctx.rotate(rot);
        ctx.scale(1.12, 0.88);
        if ('filter' in ctx) {
          ctx.filter = 'blur(' + Math.round(11 + b.alt * 7) + 'px)';
        }
        drawRefinedBird(ctx, shadowSpan, innerFlap * 0.7, outerFlap * 0.7, b.bank * 0.6, 'rgba(' + shadowRgb + ',' + (shadowAlpha * 1.15).toFixed(4) + ')');
        ctx.restore();

        // 2. REFINED INK-WASH SOARING BIRD (subtle radial depth from body to tapered tips)
        ctx.save();
        ctx.translate(b.x, b.y);
        ctx.rotate(rot);
        const featherGrad = ctx.createRadialGradient(0, -b.span * 0.04, b.span * 0.04, 0, 0, b.span * 0.56);
        featherGrad.addColorStop(0, 'rgba(' + birdRgb + ',' + (b.alpha * 1.18).toFixed(4) + ')');
        featherGrad.addColorStop(0.62, 'rgba(' + birdRgb + ',' + (b.alpha * 0.88).toFixed(4) + ')');
        featherGrad.addColorStop(1, 'rgba(' + birdRgb + ',' + (b.alpha * 0.52).toFixed(4) + ')');
        drawRefinedBird(ctx, b.span, innerFlap, outerFlap, b.bank, featherGrad);
        ctx.restore();
      }
    }

    function syncToggleButtons() {
      document.querySelectorAll('[data-murm-toggle]').forEach((btn) => {
        btn.setAttribute('aria-pressed', paused ? 'true' : 'false');
        btn.setAttribute('title', paused ? 'Resume flock' : 'Pause flock');
      });
    }

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-murm-toggle]')) {
        paused = !paused;
        syncToggleButtons();
      }
    });

    resize();
    window.addEventListener('resize', resize, { passive: true });
    syncToggleButtons();

    let lastNow = performance.now();
    drawFrame(lastNow, 0);

    function tick(now) {
      const dt = Math.min(48, Math.max(0, now - lastNow));
      lastNow = now;
      // Pause animation automatically once scrolled past Hero (scrollFade <= 0.01)
      if (!paused && !document.hidden && scrollFade > 0.01) {
        drawFrame(now, dt);
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  })();
</script>
