<script define:vars={{ ZONES }}>
  (function initArenaModel() {
    const root = document.querySelector('[data-arena-model]');
    if (!root) return;

    let locked = 'all';
    const btns = root.querySelectorAll('[data-az-select]');
    const zones = root.querySelectorAll('[data-az-zone]');
    const edges = root.querySelectorAll('[data-az-links]');
    const tagEl = root.querySelector('[data-az-tag]');
    const noteEl = root.querySelector('[data-az-note]');
    const codeEl = root.querySelector('[data-az-code]');

    function render(key) {
      const k = ZONES[key] ? key : 'all';
      const data = ZONES[k];

      btns.forEach((b) => {
        const act = b.getAttribute('data-az-select') === k;
        b.classList.toggle('active', act);
        b.setAttribute('aria-selected', act ? 'true' : 'false');
      });

      zones.forEach((z) => {
        const zk = z.getAttribute('data-az-zone');
        const active = k === 'all' || zk === k || (k === 'runtime' && zk === 'sandbox');
        z.classList.toggle('dimmed', !active);
        z.classList.toggle('focused', k !== 'all' && zk === k);
      });

      edges.forEach((e) => {
        const links = (e.getAttribute('data-az-links') || '').split(/\s+/);
        const match = k === 'all' || links.includes(k);
        e.classList.toggle('dimmed', !match);
      });

      if (tagEl) tagEl.textContent = data.tag;
      if (noteEl) noteEl.textContent = data.note;
      if (codeEl) codeEl.textContent = data.code;
    }

    function toggleLock(key) {
      locked = locked === key ? 'all' : key;
      render(locked);
    }

    btns.forEach((b) => {
      b.addEventListener('click', () => {
        locked = b.getAttribute('data-az-select') || 'all';
        render(locked);
      });
    });

    zones.forEach((z) => {
      const k = z.getAttribute('data-az-zone');
      z.addEventListener('click', () => toggleLock(k));
      z.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleLock(k);
        }
      });
      z.addEventListener('mouseenter', () => render(k));
      z.addEventListener('mouseleave', () => render(locked));
    });

    render('all');
  })();
</script>
