---
const CONCEPTS = {
  all: {
    index: 'OVERVIEW',
    name: 'Two Planes, Six Primitives',
    plane: 'ARCHITECTURE',
    summary: 'Author a Harness by wiring Agents and Services on the top plane; the Runtime provisions isolated Sandboxes and persists every Run on the bottom plane.',
    primitive: 'createRuntime({ backend, profiles, services, maxBots, outputDir })',
    symbol: '@swarmenv/core',
  },
  harness: {
    index: '01 · HARNESS',
    name: 'Harness',
    plane: 'AUTHORING',
    summary: 'Your host-side TypeScript program deciding who spawns, how events route, and when collaboration terminates.',
    primitive: 'runtime.onEvent((e) => runtime.send(target, payload))',
    symbol: 'src/environments/*',
  },
  agent: {
    index: '02 · AGENT',
    name: 'Agent',
    plane: 'AUTHORING',
    summary: 'An independent execution unit with a persistent Pi session, private workspace, and 4 local tools (read, write, edit, bash).',
    primitive: 'runtime.spawn({ requestId, profile: "worker", forkFrom? })',
    symbol: 'BotInfo · Profile',
  },
  service: {
    index: '03 · SERVICE',
    name: 'Service',
    plane: 'AUTHORING',
    summary: 'Composable shared capability (task pool, mailbox, board, substrate) exposed to agents over the Bridge via JSON Schema.',
    primitive: 'services.registerService({ manifest, adapter })',
    symbol: 'ServiceRegistry',
  },
  runtime: {
    index: '04 · RUNTIME',
    name: 'Runtime',
    plane: 'EXECUTION',
    summary: 'Passive control plane managing lifecycles, unified send delivery, Service Bridge, Model Gateway, and archive-before-delete cleanup.',
    primitive: 'await runtime.send(id, msg, { mode: "steer", wakeIfIdle: false })',
    symbol: 'createRuntime()',
  },
  sandbox: {
    index: '05 · SANDBOX',
    name: 'Sandbox',
    plane: 'EXECUTION',
    summary: 'Isolated OpenSandbox container running Worker + Pi with strict filesystem quotas, network allowlists, and clean file exports.',
    primitive: 'runtime.files.prepare / grant / snapshot',
    symbol: 'OpenSandbox + Worker',
  },
  run: {
    index: '06 · RUN',
    name: 'Run',
    plane: 'EXECUTION',
    summary: 'One concrete execution durably archived on disk with redacted traces, service calls, native sessions, and reports.',
    primitive: 'outputDir/<runId>/{runtime.json, evidence.jsonl, bots/}',
    symbol: 'runtime.id · CloseReceipt',
  },
};
---

<div class="core-blueprint" data-core-blueprint>
  <figure class="schematic-card blueprint-card">
    <div class="schematic-head">
      <div class="schematic-title-wrap">
        <span class="pixel-badge">CORE ARCHITECTURE</span>
        <span class="schematic-sub">Hover or click any node to trace how authoring meets execution</span>
      </div>
      <div class="stage-controls">
        <button type="button" class="phase-btn active" data-bp-select="all">ALL</button>
        <button type="button" class="phase-btn" data-bp-select="harness">HARNESS</button>
        <button type="button" class="phase-btn" data-bp-select="agent">AGENT</button>
        <button type="button" class="phase-btn" data-bp-select="service">SERVICE</button>
        <button type="button" class="phase-btn" data-bp-select="runtime">RUNTIME</button>
        <button type="button" class="phase-btn" data-bp-select="sandbox">SANDBOX</button>
        <button type="button" class="phase-btn" data-bp-select="run">RUN</button>
      </div>
    </div>

    <div class="schematic-canvas-scroll">
      <svg class="schematic-svg blueprint-svg" viewBox="0 0 1060 326" width="1060" height="326" role="img" aria-label="Interactive two-plane murm core model architecture diagram">
        <defs>
          <pattern id="g-core" width="24" height="24" patternUnits="userSpaceOnUse">
            <path d="M 24 0 L 0 0 0 24" fill="none" stroke="var(--sch-grid)" stroke-width="0.9" />
          </pattern>
          <marker id="cb-co" viewBox="0 0 10 10" refX="8.2" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
            <path d="M 1 1.5 L 8.2 5 L 1 8.5" fill="none" stroke="var(--sch-indigo)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
          <marker id="cb-te" viewBox="0 0 10 10" refX="8.2" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
            <path d="M 1 1.5 L 8.2 5 L 1 8.5" fill="none" stroke="var(--sch-teal)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
          <marker id="cb-am" viewBox="0 0 10 10" refX="8.2" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
            <path d="M 1 1.5 L 8.2 5 L 1 8.5" fill="none" stroke="var(--sch-amber)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
          <marker id="cb-pu" viewBox="0 0 10 10" refX="8.2" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
            <path d="M 1 1.5 L 8.2 5 L 1 8.5" fill="none" stroke="var(--sch-purple)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
        </defs>

        <!-- Drafting surface + grid -->
