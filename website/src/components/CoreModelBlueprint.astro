          <rect x="498" y="206" width="216" height="74" rx="6" class="sch-card bp-card-rect" />
          <rect x="498" y="206" width="216" height="5" rx="2" fill="var(--sch-teal)" />
          <text x="512" y="227" class="sch-card-pixel">05 · SANDBOX</text>
          <text x="700" y="227" text-anchor="end" class="sch-card-pixel">DOCKER</text>
          <text x="512" y="248" class="bp-node-title">Isolated Worker + Pi</text>
          <text x="512" y="266" class="bp-node-sub">Quotas · allowlist · file handoff</text>
        </g>

        <!-- 06: RUN -->
        <g class="bp-node" data-bp-node="run" tabindex="0" role="button" aria-label="Inspect Run concept">
          <rect x="787" y="209" width="232" height="74" rx="6" class="sch-shadow" />
          <rect x="784" y="206" width="232" height="74" rx="6" class="sch-card bp-card-rect" />
          <rect x="784" y="206" width="232" height="5" rx="2" fill="var(--sch-amber)" />
          <text x="798" y="227" class="sch-card-pixel">06 · RUN</text>
          <text x="1002" y="227" text-anchor="end" class="sch-card-pixel">ARCHIVE</text>
          <text x="798" y="248" class="bp-node-title">Redacted execution bundle</text>
          <text x="798" y="266" class="bp-node-sub">Sessions · traces · service calls</text>
        </g>
      </svg>
    </div>

    <!-- Live Inspector Footer -->
    <figcaption class="schematic-caption stage-footer">
      <div class="stage-caption-main">
        <span class="caption-step" data-bp-badge>OVERVIEW</span>
        <span data-bp-summary>{CONCEPTS.all.summary}</span>
      </div>
      <div class="stage-tech-pills">
        <span><strong>Primitive:</strong> <code data-bp-primitive>{CONCEPTS.all.primitive}</code></span>
        <span><strong>Symbol:</strong> <code data-bp-symbol>{CONCEPTS.all.symbol}</code></span>
      </div>
    </figcaption>
  </figure>

  <!-- Synchronized 6-Concept Compact Selector Grid -->
  <div class="concept-grid concept-grid-linked">
    <button type="button" class="concept-card concept-btn" data-bp-card="harness">
      <div class="concept-top">
        <span class="concept-id-wrap">
          <span class="concept-dot" style="background:var(--sch-indigo)"></span>
          <code>Harness</code>
        </span>
        <span class="concept-tag tag-author">Authoring</span>
      </div>
      <p>Host TypeScript logic deciding who spawns, how events route, and when work finishes.</p>
      <span class="concept-code-foot">src/environments/*</span>
    </button>

    <button type="button" class="concept-card concept-btn" data-bp-card="agent">
      <div class="concept-top">
        <span class="concept-id-wrap">
          <span class="concept-dot" style="background:var(--sch-blue)"></span>
          <code>Agent</code>
        </span>
        <span class="concept-tag tag-author">Authoring</span>
      </div>
      <p>Independent execution unit with a persistent session, private workspace, and 4 local tools.</p>
      <span class="concept-code-foot">BotInfo · Profile</span>
    </button>

    <button type="button" class="concept-card concept-btn" data-bp-card="service">
      <div class="concept-top">
        <span class="concept-id-wrap">
          <span class="concept-dot" style="background:var(--sch-purple)"></span>
          <code>Service</code>
        </span>
        <span class="concept-tag tag-author">Authoring</span>
      </div>
      <p>Composable shared capability (task pool, mailbox, board, substrate) called over the Bridge.</p>
      <span class="concept-code-foot">ServiceRegistry</span>
    </button>

    <button type="button" class="concept-card concept-btn" data-bp-card="runtime">
      <div class="concept-top">
        <span class="concept-id-wrap">
          <span class="concept-dot" style="background:var(--sch-indigo)"></span>
          <code>Runtime</code>
        </span>
        <span class="concept-tag tag-runtime">Execution</span>
      </div>
      <p>Control plane managing lifecycles, input delivery, controlled file handoffs, and cleanup.</p>
      <span class="concept-code-foot">createRuntime()</span>
