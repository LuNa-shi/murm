    <button type="button" class="concept-card concept-btn" data-bp-card="run">
      <div class="concept-top">
        <span class="concept-id-wrap">
          <span class="concept-dot" style="background:var(--sch-amber)"></span>
          <code>Run</code>
        </span>
        <span class="concept-tag tag-runtime">Execution</span>
      </div>
      <p>One concrete execution archived to disk with sessions, model traces, service calls, and reports.</p>
      <span class="concept-code-foot">outputDir/&lt;runId&gt;/</span>
    </button>
  </div>
</div>

<script define:vars={{ CONCEPTS }}>
  (function initCoreBlueprint() {
    const root = document.querySelector('[data-core-blueprint]');
    if (!root) return;

    let lockedKey = 'all';

    const tabs = root.querySelectorAll('[data-bp-select]');
    const nodes = root.querySelectorAll('[data-bp-node]');
    const edges = root.querySelectorAll('[data-bp-links]');
    const cards = root.querySelectorAll('[data-bp-card]');
    const badgeEl = root.querySelector('[data-bp-badge]');
    const summaryEl = root.querySelector('[data-bp-summary]');
    const primEl = root.querySelector('[data-bp-primitive]');
    const symEl = root.querySelector('[data-bp-symbol]');

    function render(key) {
      const k = CONCEPTS[key] ? key : 'all';
      const meta = CONCEPTS[k];

      tabs.forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-bp-select') === k);
      });

      cards.forEach((card) => {
        card.classList.toggle('active', card.getAttribute('data-bp-card') === k);
      });

      nodes.forEach((node) => {
        const nk = node.getAttribute('data-bp-node');
        const active = k === 'all' || nk === k;
        node.classList.toggle('dimmed', !active);
        node.classList.toggle('focused', k !== 'all' && nk === k);
      });

      edges.forEach((edge) => {
        const links = (edge.getAttribute('data-bp-links') || '').split(/\s+/);
        const match = k === 'all' || links.includes(k);
        edge.classList.toggle('dimmed', !match);
      });

      if (badgeEl) badgeEl.textContent = meta.index;
      if (summaryEl) summaryEl.textContent = meta.summary;
      if (primEl) primEl.textContent = meta.primitive;
      if (symEl) symEl.textContent = meta.symbol;
    }

    function toggleLock(key) {
      lockedKey = lockedKey === key ? 'all' : key;
      render(lockedKey);
    }

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        lockedKey = btn.getAttribute('data-bp-select') || 'all';
        render(lockedKey);
      });
    });

    nodes.forEach((node) => {
      const k = node.getAttribute('data-bp-node');
      node.addEventListener('click', () => toggleLock(k));
      node.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleLock(k);
        }
      });
      node.addEventListener('mouseenter', () => render(k));
      node.addEventListener('mouseleave', () => render(lockedKey));
    });

    cards.forEach((card) => {
      const k = card.getAttribute('data-bp-card');
      card.addEventListener('click', () => toggleLock(k));
      card.addEventListener('mouseenter', () => render(k));
      card.addEventListener('mouseleave', () => render(lockedKey));
    });

    render('all');
  })();
</script>
