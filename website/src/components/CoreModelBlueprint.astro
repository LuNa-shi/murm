          <rect x="784" y="52" width="232" height="74" rx="6" class="sch-card bp-card-rect" />
          <rect x="784" y="52" width="232" height="5" rx="2" fill="var(--sch-purple)" />
          <text x="798" y="73" class="sch-card-pixel">03 · SERVICE</text>
          <text x="1002" y="73" text-anchor="end" class="sch-card-pixel">MANIFEST</text>
          <text x="798" y="94" class="bp-node-title">Pluggable shared tools</text>
          <text x="798" y="112" class="bp-node-sub">Task pool · mailbox · board · git</text>
        </g>

        <!-- 04: RUNTIME -->
        <g class="bp-node" data-bp-node="runtime" tabindex="0" role="button" aria-label="Inspect Runtime concept">
