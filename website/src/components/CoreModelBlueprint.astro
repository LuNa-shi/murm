        <rect x="176" y="0" width="884" height="326" fill="url(#g-core)" />
        <rect x="0" y="0" width="176" height="326" fill="var(--sch-header)" />
        <line x1="176" y1="0" x2="176" y2="326" class="sch-ink-rule" />

        <!-- Plane band labels on left rail -->
        <rect x="16" y="60" width="8" height="8" rx="1" fill="var(--sch-indigo)" />
        <text x="32" y="68" class="sch-agent-pixel">AUTHORING</text>
        <text x="32" y="87" class="sch-agent-role">What you write</text>
        <text x="32" y="105" class="sch-agent-role">TypeScript · policies</text>

        <line x1="0" y1="168" x2="176" y2="168" class="sch-ink-rule" />

        <rect x="16" y="220" width="8" height="8" rx="1" fill="var(--sch-teal)" />
        <text x="32" y="228" class="sch-agent-pixel">EXECUTION</text>
        <text x="32" y="247" class="sch-agent-role">What murm runs</text>
        <text x="32" y="265" class="sch-agent-role">Containers · traces</text>

