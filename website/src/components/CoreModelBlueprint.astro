    <button type="button" class="concept-card concept-btn" data-bp-card="sandbox">
      <div class="concept-top">
        <span class="concept-id-wrap">
          <span class="concept-dot" style="background:var(--sch-teal)"></span>
          <code>Sandbox</code>
        </span>
        <span class="concept-tag tag-runtime">Execution</span>
