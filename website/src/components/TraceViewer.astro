---
import { LAYOUT_PREVIEW_TRACE } from '../lib/trace-data';
---

<section class="tv-shell" data-trace-viewer="tv-inspector">
  <!-- Default Honest Empty State: Load Local Run Directory -->
  <div class="tv-empty-state" data-tv-empty>
    <div class="tv-drop-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
      </svg>
    </div>
    <h2>选择本地 Run 目录开始检查</h2>
    <p class="tv-empty-desc">
      直接读取 <code>outputDir/&lt;runId&gt;/</code> 中的 <code>runtime.json</code>、<code>evidence.jsonl</code>、<code>service-calls.jsonl</code> 与各 Agent 的原生会话记录。所有解析都在浏览器本地完成，不会上传任何数据。
    </p>

    <div class="tv-empty-actions">
      <label class="btn btn-primary">
        <span>选择本地 Run 目录</span>
        <input type="file" webkitdirectory directory multiple hidden data-tv-upload-empty />
      </label>
      <button type="button" class="btn btn-secondary" data-tv-load-preview>
        加载结构示意样例（仅预览界面）
      </button>
    </div>

    <div class="tv-cli-box">
      <span class="tv-cli-label">或通过本地命令行一键打开指定运行目录</span>
      <code>cd website &amp;&amp; npm run view -- /path/to/runs/&lt;runId&gt;</code>
    </div>

    <p class="tv-empty-note">
      说明：当前页面提供轻量级的本地目录检查能力；更完整的独立多智能体轨迹分析与调试界面将作为单独的 Web 应用承接。
    </p>
  </div>

  <!-- Active Inspector Workspace (revealed after loading a local run or preview) -->
  <div class="tv-workspace" data-tv-workspace hidden>
    <div class="tv-header">
      <div class="tv-header-left">
        <span class="tv-run-title" data-tv-title></span>
        <span class="tv-source-badge" data-tv-source></span>

        <div class="tv-tabs" role="tablist" aria-label="时间轴视图">
          <button type="button" class="tv-tab active" data-tv-mode="duration" role="tab" aria-selected="true">
            时间比例
          </button>
          <button type="button" class="tv-tab" data-tv-mode="sequence" role="tab" aria-selected="false">
            顺序等宽
          </button>
        </div>
      </div>

      <div class="tv-header-right">
        <input
          type="search"
          class="tv-search"
          data-tv-search
          placeholder="搜索事件、工具或 Service..."
          aria-label="搜索轨迹事件"
        />
        <label class="tv-upload-btn" title="切换其他本地 outputDir/<runId>/ 目录">
          <span>切换目录</span>
          <input type="file" webkitdirectory directory multiple hidden data-tv-upload />
        </label>
        <button type="button" class="tv-upload-btn" data-tv-reset>返回</button>
      </div>
    </div>

    <div class="tv-meta-bar">
      <span class="tv-subtitle" data-tv-subtitle></span>
    </div>

    <div class="tv-metrics" data-tv-metrics></div>

    <div class="tv-timeline">
      <div class="tv-legend">
        <div class="tv-legend-items">
          <span><i class="tv-dot" style="background:#3b82f6"></i>Input</span>
          <span><i class="tv-dot" style="background:#10b981"></i>Context</span>
          <span><i class="tv-dot" style="background:#7c3aed"></i>Model</span>
          <span><i class="tv-dot" style="background:#d97706"></i>Tools</span>
          <span><i class="tv-dot" style="background:#0d9488"></i>Service</span>
        </div>
        <span>点击泳道色块可定位至下方对应事件</span>
      </div>
      <div data-tv-swimlanes></div>
    </div>

    <div class="tv-filters" data-tv-filters></div>

    <div class="tv-stream" data-tv-stream></div>
  </div>
</section>

<script define:vars={{ LAYOUT_PREVIEW_TRACE }}>
  (function initLocalRunInspector() {
    const root = document.querySelector('[data-trace-viewer="tv-inspector"]');
    if (!root) return;

    let currentTrace = null;
    let viewMode = 'duration';
    let selectedAgent = 'ALL';
    let selectedKind = 'ALL';
    let searchQuery = '';
    let highlightedTurnId = null;

    const emptyEl = root.querySelector('[data-tv-empty]');
    const workspaceEl = root.querySelector('[data-tv-workspace]');
    const titleEl = root.querySelector('[data-tv-title]');
    const sourceEl = root.querySelector('[data-tv-source]');
    const subtitleEl = root.querySelector('[data-tv-subtitle]');
    const metricsEl = root.querySelector('[data-tv-metrics]');
    const swimlanesEl = root.querySelector('[data-tv-swimlanes]');
    const filtersEl = root.querySelector('[data-tv-filters]');
    const streamEl = root.querySelector('[data-tv-stream]');
    const searchEl = root.querySelector('[data-tv-search]');
    const uploadEmptyEl = root.querySelector('[data-tv-upload-empty]');
    const uploadEl = root.querySelector('[data-tv-upload]');
    const previewBtn = root.querySelector('[data-tv-load-preview]');
    const resetBtn = root.querySelector('[data-tv-reset]');
    const tabButtons = root.querySelectorAll('[data-tv-mode]');

    function esc(str) {
      return String(str)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }

    function fmtSec(sec) {
      const s = Math.max(0, Math.round(sec));
      const m = Math.floor(s / 60);
      const r = s % 60;
      return `${String(m).padStart(2, '0')}:${String(r).padStart(2, '0')}`;
    }

    function renderSwimlanes(trace) {
      const total = Math.max(trace.durationSec, 1);
      const lanes = [
        { key: 'input', label: 'Input', match: ['input', 'context'] },
        { key: 'model', label: 'Model', match: ['model'] },
        { key: 'tool', label: 'Tools', match: ['tool', 'service'] },
      ];

      swimlanesEl.innerHTML = trace.agents
        .map((agent) => {
          const agentSpans = trace.spans.filter((s) => s.agent === agent.id);
          const isSelected = selectedAgent === agent.id;
          const tracksHtml = lanes
            .map((lane) => {
              const items = agentSpans.filter((s) => lane.match.includes(s.lane));
              const bars = items
                .map((span, idx) => {
                  let leftPct;
                  let widthPct;
                  if (viewMode === 'duration') {
                    leftPct = (span.startSec / total) * 100;
                    widthPct = Math.max(((span.endSec - span.startSec) / total) * 100, 1.5);
                  } else {
                    const count = Math.max(items.length, 1);
                    leftPct = (idx / count) * 96 + 1;
                    widthPct = Math.max(90 / count - 1.5, 4);
                  }
                  const selClass = highlightedTurnId === span.turnId ? 'selected' : '';
                  return `<button
                    type="button"
                    class="tv-span lane-${span.lane} ${selClass}"
                    data-jump-turn="${esc(span.turnId)}"
                    style="left:${leftPct.toFixed(2)}%;width:${Math.min(widthPct, 100 - leftPct).toFixed(2)}%;"
                    title="${esc(span.agent)} · ${esc(span.label)} (${fmtSec(span.startSec)}–${fmtSec(span.endSec)})"
                  ></button>`;
                })
                .join('');
              return `
                <div class="tv-track-row">
                  <span class="tv-track-label">${lane.label}</span>
                  <div class="tv-track-bar">${bars}</div>
                </div>`;
            })
            .join('');

          return `
            <div class="tv-swimlane">
              <div class="tv-agent-meta">
                <button type="button" class="tv-agent-name" data-filter-agent="${esc(agent.id)}" style="${isSelected ? 'color:var(--accent);' : ''}">
                  <span class="tv-dot" style="background:${agent.color};margin:0;"></span>
                  <span>${esc(agent.id)}</span>
                </button>
                <span class="tv-agent-sub">${esc(agent.role)} · ${agent.calls} 条记录</span>
              </div>
              <div class="tv-tracks">${tracksHtml}</div>
            </div>`;
        })
        .join('');
    }

    function renderFilters(trace) {
      const agentBtns = [
        `<button type="button" class="tv-filter-pill ${selectedAgent === 'ALL' ? 'active' : ''}" data-filter-agent="ALL">全部 Agent</button>`,
        ...trace.agents.map(
          (a) =>
            `<button type="button" class="tv-filter-pill ${selectedAgent === a.id ? 'active' : ''}" data-filter-agent="${esc(a.id)}">${esc(a.id)}</button>`
        ),
      ];
      const kinds = ['ALL', 'USER', 'ASSISTANT', 'TOOL', 'SERVICE', 'SYSTEM'];
      const kindBtns = kinds.map(
        (k) =>
          `<button type="button" class="tv-filter-pill ${selectedKind === k ? 'active' : ''}" data-filter-kind="${k}">${k === 'ALL' ? '全部类型' : k}</button>`
      );
      filtersEl.innerHTML = `${agentBtns.join('')}<span class="tv-filter-sep"></span>${kindBtns.join('')}`;
    }

    function renderStream(trace) {
      const q = searchQuery.trim().toLowerCase();
      const filteredTurns = trace.turns
        .filter((turn) => selectedAgent === 'ALL' || turn.agent === selectedAgent)
        .map((turn) => {
          const events = turn.events.filter((ev) => {
            if (selectedKind !== 'ALL' && ev.kind !== selectedKind) return false;
            if (!q) return true;
            const hay = `${turn.agent} ${ev.kind} ${ev.summary} ${JSON.stringify(ev.payload || '')}`.toLowerCase();
            return hay.includes(q);
          });
          return { ...turn, events };
        })
        .filter((turn) => turn.events.length > 0);

      if (!filteredTurns.length) {
        streamEl.innerHTML = `<div class="tv-empty">当前筛选条件下没有匹配的事件记录。</div>`;
        return;
      }

      streamEl.innerHTML = filteredTurns
        .map((turn) => {
          const agentMeta = trace.agents.find((a) => a.id === turn.agent);
          const color = agentMeta ? agentMeta.color : '#2c4cde';
          const isHl = highlightedTurnId === turn.id;
          const eventsHtml = turn.events
            .map((ev) => {
              const handoff = ev.handoffTo
                ? `<span class="tv-handoff-tag">→ ${esc(ev.handoffTo)}</span>`
                : ev.handoffFrom
                  ? `<span class="tv-handoff-tag">← ${esc(ev.handoffFrom)}</span>`
                  : '';
              const metaRight = [ev.durationMs ? `${ev.durationMs}ms` : null, ev.timestamp]
                .filter(Boolean)
                .join(' · ');
              const payloadHtml = ev.payload
                ? `<pre class="tv-payload">${esc(typeof ev.payload === 'string' ? ev.payload : JSON.stringify(ev.payload, null, 2))}</pre>`
                : '';
              return `
                <div class="tv-event" data-tv-event>
                  <button type="button" class="tv-event-row" ${ev.payload ? 'data-toggle-payload' : ''}>
                    <span class="tv-badge badge-${ev.kind}">${ev.kind}</span>
                    <span class="tv-summary">${esc(ev.summary)}${handoff}</span>
                    <span class="tv-time">${esc(metaRight)}</span>
                  </button>
                  ${payloadHtml}
                </div>`;
            })
            .join('');

          return `
            <div class="tv-turn ${isHl ? 'highlight' : ''}" id="tv-${esc(turn.id)}">
              <div class="tv-turn-head">
                <span class="tv-turn-agent">
                  <span class="tv-dot" style="background:${color};margin:0;"></span>
                  <span>${esc(turn.agent)} · Turn ${turn.turnNumber}</span>
                </span>
                <span class="tv-turn-time">${fmtSec(turn.startSec)} – ${fmtSec(turn.endSec)} · ${esc(turn.outcome)}</span>
              </div>
              <div>${eventsHtml}</div>
            </div>`;
        })
        .join('');
    }

    function showTrace(trace) {
      currentTrace = trace;
      selectedAgent = 'ALL';
      selectedKind = 'ALL';
      searchQuery = '';
      highlightedTurnId = null;
      if (searchEl) searchEl.value = '';

      emptyEl.hidden = true;
      workspaceEl.hidden = false;

      titleEl.textContent = trace.title;
      sourceEl.textContent = trace.isLocal ? '本地目录' : '结构示意';
      sourceEl.classList.toggle('is-local', Boolean(trace.isLocal));
      subtitleEl.textContent = trace.subtitle;
      metricsEl.innerHTML = trace.metrics
        .map(
          (m) =>
            `<div class="tv-metric"><span class="tv-metric-label">${esc(m.label)}</span><span class="tv-metric-val">${esc(m.value)}</span></div>`
        )
        .join('');

      renderSwimlanes(trace);
      renderFilters(trace);
      renderStream(trace);
    }

    function showEmpty() {
      currentTrace = null;
      workspaceEl.hidden = true;
      emptyEl.hidden = false;
    }

    // Parse real SwarmEnv / murm outputDir/<runId>/ files in-browser
    function parseSwarmRunBundle(bundle) {
      const evidence = bundle.evidence || [];
      const serviceCalls = bundle.serviceCalls || [];
      const sessions = bundle.sessions || {};
      const runtime = bundle.runtime || {};
      const runId = runtime.runtimeId || bundle.environmentReport?.runtimeId || 'local-run';

      const timestamps = [
        ...evidence.map((e) => Date.parse(e.at)).filter(Number.isFinite),
        ...serviceCalls.map((s) => Date.parse(s.startedAt)).filter(Number.isFinite),
      ];
      for (const rows of Object.values(sessions)) {
        for (const r of rows) {
          const ts = Date.parse(r.timestamp || r.at || r.createdAt);
          if (Number.isFinite(ts)) timestamps.push(ts);
        }
      }

      const t0 = timestamps.length ? Math.min(...timestamps) : Date.now();
      const tMax = timestamps.length ? Math.max(...timestamps) : t0 + 10_000;
      const durationSec = Math.max(Math.ceil((tMax - t0) / 1000), 1);

      const palette = ['#2c4cde', '#0f766e', '#c26d0a', '#6d28d9', '#be185d', '#2563eb'];
      const botIds = [...new Set([
        ...evidence.map((e) => e.botId).filter(Boolean),
        ...serviceCalls.map((s) => s.caller?.botId).filter(Boolean),
        ...Object.keys(sessions),
      ])];
      if (!botIds.length) botIds.push('runtime');

      const agents = botIds.map((id, i) => ({
        id,
        role: runtime.bots?.find((b) => b.botId === id)?.profile || 'agent',
        color: palette[i % palette.length],
        turns: 0,
        calls: 0,
      }));

      const spans = [];
      const rawEventsByBot = new Map(botIds.map((id) => [id, []]));

      for (const row of evidence) {
        const botId = row.botId || botIds[0];
        const sec = Number.isFinite(Date.parse(row.at)) ? (Date.parse(row.at) - t0) / 1000 : 0;
        const list = rawEventsByBot.get(botId) || [];
        if (row.type === 'input') {
          list.push({
            sec,
            lane: 'input',
            kind: 'USER',
            summary: `Input ${row.requestId || row.inputId || ''} · state=${row.state} (${row.mode || 'steer'})`,
            payload: row,
          });
        } else if (row.type === 'event' && row.event) {
          const ev = row.event;
          const isOut = ev.type === 'output';
          list.push({
            sec,
            lane: isOut || ev.type === 'settled' ? 'model' : 'context',
            kind: isOut ? 'ASSISTANT' : 'SYSTEM',
            summary: isOut ? (ev.text || '').slice(0, 220) : `event.${ev.type}${ev.outcome ? ` (${ev.outcome})` : ''}`,
            payload: ev,
          });
        }
        rawEventsByBot.set(botId, list);
      }

      for (const call of serviceCalls) {
        if (call.phase && call.phase !== 'settled') continue;
        const botId = call.caller?.botId || botIds[0];
        const startSec = Number.isFinite(Date.parse(call.startedAt)) ? (Date.parse(call.startedAt) - t0) / 1000 : 0;
        const endSec = Number.isFinite(Date.parse(call.endedAt)) ? (Date.parse(call.endedAt) - t0) / 1000 : startSec + 1;
        const list = rawEventsByBot.get(botId) || [];
        list.push({
          sec: startSec,
          endSec: Math.max(endSec, startSec + 0.5),
          lane: 'service',
          kind: 'SERVICE',
          summary: `${call.service}.${call.operation} ${JSON.stringify(call.input || {}).slice(0, 140)}`,
          durationMs: Math.max(1, Math.round((endSec - startSec) * 1000)),
          payload: call,
        });
        rawEventsByBot.set(botId, list);
      }

      for (const [botId, rows] of Object.entries(sessions)) {
        const list = rawEventsByBot.get(botId) || [];
        rows.forEach((entry, idx) => {
          const ts = Date.parse(entry.timestamp || entry.at || entry.createdAt);
          const sec = Number.isFinite(ts) ? (ts - t0) / 1000 : (idx / Math.max(rows.length, 1)) * durationSec;
          const msg = entry.message || entry;
          if (msg.role === 'toolResult' || entry.type === 'tool_result') {
            list.push({
              sec,
              lane: 'tool',
              kind: 'TOOL',
              summary: `${msg.toolName || 'tool'} result`,
              payload: entry,
            });
          } else if (Array.isArray(msg.content)) {
            for (const block of msg.content) {
              if (block?.type === 'toolCall' || block?.type === 'tool_use') {
                list.push({
                  sec,
                  lane: 'tool',
                  kind: 'TOOL',
                  summary: `${block.name || 'tool'} ${JSON.stringify(block.arguments || block.input || {}).slice(0, 120)}`,
                  payload: block,
                });
              }
            }
          }
        });
        rawEventsByBot.set(botId, list);
      }

      const turns = [];
      for (const agent of agents) {
        const items = (rawEventsByBot.get(agent.id) || []).sort((a, b) => a.sec - b.sec);
        if (!items.length) continue;

        let turnIndex = 1;
        let currentEvents = [];
        let turnStart = items[0].sec;

        const flushTurn = (endSec, outcome) => {
          if (!currentEvents.length) return;
          const turnId = `${agent.id}-t${turnIndex}`;
          currentEvents.forEach((item, idx) => {
            spans.push({
              id: `${turnId}-s${idx}`,
              agent: agent.id,
              lane: item.lane,
              startSec: item.sec,
              endSec: item.endSec || item.sec + Math.max(durationSec * 0.02, 1),
              turnId,
              label: item.summary.slice(0, 60),
            });
          });
          turns.push({
            id: turnId,
            turnNumber: turnIndex,
            agent: agent.id,
            role: agent.role,
            startSec: turnStart,
            endSec: Math.max(endSec, turnStart),
            outcome,
            events: currentEvents.map((item, idx) => ({
              id: `${turnId}-e${idx}`,
              kind: item.kind,
              summary: item.summary,
              timestamp: fmtSec(item.sec),
              durationMs: item.durationMs,
              payload: item.payload,
            })),
          });
          turnIndex += 1;
          currentEvents = [];
        };

        for (const item of items) {
          if (!currentEvents.length) turnStart = item.sec;
          currentEvents.push(item);
          if (item.kind === 'SYSTEM' && item.summary.startsWith('event.settled')) {
            const outcome = item.payload?.outcome || 'completed';
            flushTurn(item.sec, outcome);
          }
        }
        if (currentEvents.length) {
          flushTurn(currentEvents[currentEvents.length - 1].sec, 'recorded');
        }

        agent.turns = turnIndex - 1;
        agent.calls = items.length;
      }

      turns.sort((a, b) => a.startSec - b.startSec);

      return {
        id: `local-${runId}`,
        title: `Run ${String(runId).slice(0, 16)}`,
        isLocal: true,
        subtitle: `已从本地目录载入（${evidence.length} 条 evidence、${serviceCalls.length} 条 service-calls、${Object.keys(sessions).length} 份 session 文件）`,
        durationSec,
        metrics: [
          { label: 'Run ID', value: String(runId).slice(0, 18) },
          { label: '总耗时', value: fmtSec(durationSec) },
          { label: 'Agents', value: String(agents.length) },
          { label: 'Evidence', value: String(evidence.length) },
          { label: 'Service Calls', value: String(serviceCalls.filter((s) => !s.phase || s.phase === 'settled').length) },
          { label: 'Cleanup', value: String(runtime.cleanup || bundle.environmentReport?.cleanup?.cleanup || 'recorded') },
        ],
        agents,
        spans,
        turns,
      };
    }

    async function handleFileList(fileList) {
      const files = [...(fileList || [])];
      if (!files.length) return;
      const bundle = { evidence: [], serviceCalls: [], sessions: {} };
      for (const file of files) {
        const rel = (file.webkitRelativePath || file.name).replaceAll('\\', '/');
        const text = await file.text();
        if (rel.endsWith('runtime.json')) {
          try { bundle.runtime = JSON.parse(text); } catch {}
        } else if (rel.endsWith('environment-report.json')) {
          try { bundle.environmentReport = JSON.parse(text); } catch {}
        } else if (rel.endsWith('evidence.jsonl')) {
          bundle.evidence = text.split('\n').filter(Boolean).map((l) => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
        } else if (rel.endsWith('service-calls.jsonl')) {
          bundle.serviceCalls = text.split('\n').filter(Boolean).map((l) => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
        } else if (/bots\/([^/]+)\/session\/.+\.jsonl$/.test(rel)) {
          const match = rel.match(/bots\/([^/]+)\/session\//);
          if (match) {
            const botId = match[1];
            const parsed = text.split('\n').filter(Boolean).map((l) => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
            bundle.sessions[botId] = [...(bundle.sessions[botId] || []), ...parsed];
          }
        }
      }
      showTrace(parseSwarmRunBundle(bundle));
    }

    uploadEmptyEl?.addEventListener('change', (e) => void handleFileList(e.target.files));
    uploadEl?.addEventListener('change', (e) => void handleFileList(e.target.files));
    previewBtn?.addEventListener('click', () => showTrace(structuredClone(LAYOUT_PREVIEW_TRACE)));
    resetBtn?.addEventListener('click', showEmpty);

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!currentTrace) return;
        viewMode = btn.getAttribute('data-tv-mode') || 'duration';
        tabButtons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('active', active);
          b.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        renderSwimlanes(currentTrace);
      });
    });

    searchEl?.addEventListener('input', (e) => {
      if (!currentTrace) return;
      searchQuery = e.target.value || '';
      renderStream(currentTrace);
    });

    root.addEventListener('click', (e) => {
      if (!currentTrace) return;
      const jump = e.target.closest('[data-jump-turn]');
      if (jump) {
        highlightedTurnId = jump.getAttribute('data-jump-turn');
        selectedAgent = 'ALL';
        renderSwimlanes(currentTrace);
        renderFilters(currentTrace);
        renderStream(currentTrace);
        const target = document.getElementById(`tv-${highlightedTurnId}`);
        target?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }
      const agentBtn = e.target.closest('[data-filter-agent]');
      if (agentBtn) {
        const val = agentBtn.getAttribute('data-filter-agent');
        selectedAgent = selectedAgent === val && val !== 'ALL' ? 'ALL' : val;
        renderSwimlanes(currentTrace);
        renderFilters(currentTrace);
        renderStream(currentTrace);
        return;
      }
      const kindBtn = e.target.closest('[data-filter-kind]');
      if (kindBtn) {
        selectedKind = kindBtn.getAttribute('data-filter-kind') || 'ALL';
        renderFilters(currentTrace);
        renderStream(currentTrace);
        return;
      }
      const toggle = e.target.closest('[data-toggle-payload]');
      if (toggle) {
        toggle.closest('[data-tv-event]')?.classList.toggle('expanded');
      }
    });

    // Auto-load local run when started via `npm run view -- /path/to/run`
    if (new URLSearchParams(location.search).get('local') === '1') {
      fetch('/api/local-run.json')
        .then((r) => (r.ok ? r.json() : null))
        .then((bundle) => {
          if (bundle) showTrace(parseSwarmRunBundle(bundle));
        })
        .catch(() => {});
    }
  })();
</script>
