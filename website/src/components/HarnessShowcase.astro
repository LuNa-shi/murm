---
import { withBase } from '../lib/url';

const HARNESS_META = {
  subagents: {
    index: '01',
    name: 'Subagents',
    kicker: 'TREE · MAILBOX',
    headline: 'Recursive named delegation, non-waking steer, and shared-workspace handoff',
    services: 'collaboration (6 ops)',
    primitives: 'spawn(forkFrom) · send(wakeIfIdle: false) · interrupt',
    docHref: withBase('/docs/harnesses/subagents/'),
    phases: ['01 SPAWN', '02 PARALLEL', '03 STEER', '04 HANDOFF', '05 CLOSE'],
    notes: {
      all: 'Overview: /root spawns isolated children on demand, injects mid-flight steers only into busy agents, and integrates verified test suites before archive-before-delete closeout.',
      '1': '01 · SPAWN: /root invokes collaboration.spawn_agent. The Runtime boots two isolated sandboxes and optionally mounts a shared workspace or forks parent context.',
      '2': '02 · PARALLEL: All three agents execute concurrently in separate Pi sessions with isolated disk and network limits — API keys never leave the host.',
      '3': '03 · STEER: Mid-flight requirements call send({ mode: "steer", wakeIfIdle: false }) so busy children react immediately while idle agents stay undisturbed in the mailbox.',
      '4': '04 · HANDOFF: Children report completion via settled events and send_message; /root runs the handed-off test suite and fixes edge cases.',
      '5': '05 · CLOSE: runtime.close() stops Pi, archives raw sessions, exports collect deliverables, and deletes containers only after archiving succeeds.',
    },
  },
  taskpool: {
    index: '02',
    name: 'TaskPool',
    kicker: 'POOL · LEASE · MAIN',
    headline: 'Read-only discovery, exclusive lease claims, host-granted writes, and versioned main merges',
    services: 'task · material · workspace · judge',
    primitives: 'writable: false · files.prepare/grant · modelAccessPolicy',
    docHref: withBase('/docs/harnesses/taskpool/'),
    phases: ['01 DISCOVER', '02 CLAIM', '03 LEASE GATE', '04 MERGE', '05 REFILL'],
    notes: {
      all: 'Overview: Identical workers start read-only, compete for leased tasks, receive host-granted write access, stay bounded by Model Gateway leases, and merge verified snapshots into main.',
      '1': '01 · DISCOVER: Workers boot with writable: false. They inspect open tasks and immutable Materials without being able to touch local workspace files.',
      '2': '02 · CLAIM: task_take acquires an exclusive lease + fencing_version; the host stages inputs with files.prepare() and unlocks writes via files.grant().',
      '3': '03 · LEASE GATE: Every model request checks modelAccessPolicy synchronously — if the lease expires or fencing_version changes, inference aborts immediately.',
      '4': '04 · MERGE: workspace_save captures a consistent files.snapshot(), optional Judge verifies the candidate, and workspace_merge advances public main.',
      '5': '05 · REFILL: On task_finish or timeout, the controller stops the finished worker, archives its session, and spawns a fresh worker into the freed slot.',
    },
  },
  peermesh: {
    index: '03',
    name: 'PeerMesh',
    kicker: 'PEERS · CHAT · GIT PR',
    headline: 'Equal peers negotiating soft claims in chat, coding on personal branches, and landing verified PRs',
    services: 'board · message · gitea + native git',
    primitives: 'per-peer bindings · network.allow · secretEnv · collect(includeGit)',
    docHref: withBase('/docs/harnesses/peermesh/'),
    phases: ['01 CLAIM', '02 NEGOTIATE', '03 BRANCH', '04 OPEN PR', '05 LAND'],
    notes: {
      all: 'Overview: No central dispatcher or exclusive locks — peers declare overlapping soft claims on a Board, coordinate via team chat, and open personal-branch PRs verified by the host.',
      '1': '01 · CLAIM: Both peer-a and peer-b post overlapping CLAIM entries on the shared Board to signal areas of interest without blocking each other.',
      '2': '02 · NEGOTIATE: External chat mentions enter each peer’s dedicated serial Router, which attaches a fresh Board snapshot and delivers followUp turns into the existing session.',
      '3': '03 · BRANCH: Each peer develops on its own WORK_BRANCH using native git with scoped Gitea credentials injected strictly via secretEnv.',
      '4': '04 · OPEN PR: Peers open pull requests from their personal branch to main through the scoped gitea Service (direct merges stay host-only).',
      '5': '05 · LAND: Host delivery checks author, branch, and pinned commit SHA before merging to main; collect(includeGit: true) preserves every local checkout.',
    },
  },
  substrate: {
    index: '04',
    name: 'Substrate',
    kicker: 'IMMUTABLE STORE · DAG',
    headline: 'Zero task queues and zero routing — equal peers publish, search, read, and cite immutable findings',
    services: 'substrate (SQLite: publish, search, visit)',
    primitives: 'spawn(files) · runInput · runtime.stop',
    docHref: withBase('/docs/harnesses/substrate/'),
    phases: ['01 PUBLISH', '02 RETIRE', '03 SEARCH', '04 VISIT', '05 CITE'],
    notes: {
      all: 'Overview: Fixed parallel rounds over one content-addressed SQLite store. Artifacts outlive their authors and evolve through audited search → visit → explicit citation chains.',
      '1': '01 · PUBLISH: peer-0 publishes a self-contained finding; SQLite assigns an immutable content:<sha256> address inside a BEGIN IMMEDIATE transaction.',
      '2': '02 · RETIRE: When peer-0 completes its rounds and calls runtime.stop(), its container is deleted while every published artifact stays durably readable in substrate.',
      '3': '03 · SEARCH: peer-1 queries substrate.search(); results rank by term frequency and citation count, logging the query into substrate_reads.',
      '4': '04 · VISIT: peer-1 fetches the full verified body and upstream citations via substrate.visit(), recording a durable read proof.',
      '5': '05 · CITE: peer-1 publishes a refined artifact explicitly citing content:<sha256>; host evidence checks confirm the complete cross-agent lineage.',
    },
  },
  'lead-worker': {
    index: '05',
    name: 'Lead-Worker',
    kicker: 'DIRECTION · FEEDBACK',
    headline: 'Staged lead direction, transactional worker claims, Git SHA-256 verification, and causal feedback loops',
    services: 'board (SQLite) · gitea + native git',
    primitives: 'fixed-team spawn · onEvent fatal fence · runInput stages',
    docHref: withBase('/docs/harnesses/lead-worker/'),
    phases: ['01 DIRECT', '02 CLAIM', '03 SHIP', '04 REVISE', '05 ROUND 2'],
    notes: {
      all: 'Overview: One lead sets direction while workers claim subtasks transactionally, ship byte-verified Git commits with field notes, and feed findings back into the next direction.',
      '1': '01 · DIRECT: Lead announces the initial direction, role assignments, and ready subtasks on the transactional SQLite Board.',
      '2': '02 · CLAIM: Workers concurrently call board.claim() with optimistic expected_revision inside BEGIN IMMEDIATE to lock a single permanent owner.',
      '3': '03 · SHIP: Each worker pushes a personal Git branch, leaves execution feedback notes, and submits { commit, path, sha256 } verified live against Gitea.',
      '4': '04 · REVISE: Causal read-gate check — Board allows Lead to publish the revised direction only after reads proves all worker feedback was inspected.',
      '5': '05 · ROUND 2: The same workers resume in their preserved sessions and Git directories, read the new direction_id, and deliver round-2 updates.',
    },
  },
};
---

<div class="showcase-root" data-harness-showcase>
  <!-- 5-Across Interactive Filmstrip Deck -->
  <div class="filmstrip-grid" role="tablist" aria-label="Select a multi-agent harness">
