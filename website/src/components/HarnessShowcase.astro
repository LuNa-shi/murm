---
import { docHref, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';

const SHOWCASE_UI = isZh
  ? {
      allTab: '全部',
      overviewTag: '总览',
      play: '播放',
      pause: '暂停',
      zoom: '放大',
      zoomTitle: '点击放大查看',
      clickHint: '点击放大 ⤢',
      docsBtn: '文档 →',
      deepDive: '阅读详细文档 →',
      servicesLabel: 'Services：',
      primitivesLabel: '核心原语：',
      closeAria: '关闭放大视图',
    }
  : {
      allTab: 'ALL',
      overviewTag: 'OVERVIEW',
      play: 'Play',
      pause: 'Pause',
      zoom: 'Zoom',
      zoomTitle: 'Click to zoom in',
      clickHint: 'Click to zoom ⤢',
      docsBtn: 'Docs →',
      deepDive: 'Read deep dive →',
      servicesLabel: 'Services:',
      primitivesLabel: 'Primitives:',
      closeAria: 'Close expanded view',
    };

const HARNESS_META = isZh
  ? {
      subagents: {
        index: '01',
        name: 'Subagents',
        kicker: '层级树 · 邮箱',
        headline: '示例：协作构建 CLI 文件查找器 — /root 递归委派子任务、中途非唤醒转向（steer）并集成验收',
        services: 'collaboration（6 个操作）',
        primitives: 'spawn(forkFrom) · send(wakeIfIdle: false) · interrupt',
        docHref: docHref('zh', 'harnesses/subagents'),
        phases: ['01 创建', '02 并行', '03 转向', '04 交接', '05 收尾'],
        notes: {
          all: '场景背景（构建命令行文件查找器）：/root 拆出正则匹配与筛选测试两个子任务给独立沙箱，中途将符号链接新需求非唤醒 steer 给忙碌子 Agent，最后统一跑测试并归档收尾。色条颜色代表所属 Agent 泳道。',
          '1': '01 · 创建：/root 调用 collaboration.spawn_agent，Runtime 启动独立沙箱并按需挂载共享工作区或分叉父级会话上下文。',
          '2': '02 · 并行：三个 Agent 在各自持久化执行器会话与隔离配额下并行工作，模型 API 密钥始终留在宿主机。',
          '3': '03 · 转向：中途新需求通过 send({ mode: "steer", wakeIfIdle: false }) 投递——忙碌子 Agent 在执行器支持的边界接收输入，明确空闲时由 Harness 保留到邮箱。',
          '4': '04 · 交接：子 Agent 通过 settled 事件与 send_message 回传结果，/root 运行测试套件并修复边界问题。',
          '5': '05 · 收尾：runtime.close() 先停止执行器进程、归档原始会话与 collect 产物，确认落盘后再销毁容器。',
        },
      },
      taskpool: {
        index: '02',
        name: 'TaskPool',
        kicker: '任务池 · 租约 · 主干',
        headline: '只读发现、独占租约领取、宿主授权写入与版本化 main 合并',
        services: 'task · material · workspace · judge',
        primitives: 'writable: false · files.replace · stop',
        docHref: docHref('zh', 'harnesses/taskpool'),
        phases: ['01 发现', '02 领任务', '03 租约门控', '04 合并', '05 补位'],
        notes: {
          all: '总览：同构 Worker 默认以只读方式启动，竞争带租约的独占任务，获宿主授权后写入，全程受 Model Gateway 租约保护并向 main 合并。',
          '1': '01 · 发现：Worker 以 writable: false 启动，只能通过 Service 浏览待办任务与不可变 Material，无法改动本地工作区。',
          '2': '02 · 领任务：task_take 获取独占租约与 fencing_version；宿主调用 files.replace({ writable: true })，成功后开放写入。',
          '3': '03 · 租约门控：每次模型请求同步校验 modelAccessPolicy——一旦租约过期或 fencing_version 变化，流式推理立即中止。',
          '4': '04 · 合并：workspace_save 通过 files.snapshot() 采集一致快照，可选 Judge 验证通过后由 workspace_merge 推进公共 main。',
          '5': '05 · 补位：任务完成或超时后，控制器停止该 Worker、归档会话，并在释放的槽位上启动全新 Worker。',
        },
      },
      peermesh: {
        index: '03',
        name: 'PeerMesh',
        kicker: '对等小组 · 聊天 · GIT PR',
        headline: '扁平研发小组在任务板登记分工、群聊协商、个人分支开发并经宿主核验合并 PR',
        services: 'peermesh-context · message · gitea + 原生 git',
        primitives: 'per-peer bindings · network.allow · secretEnv · collect(includeGit)',
        docHref: docHref('zh', 'harnesses/peermesh'),
        phases: ['01 登记分工', '02 协商', '03 分支开发', '04 提 PR', '05 验收集成'],
        notes: {
          all: '总览：无中心管理员也不强行加锁——成员在共享任务板自由登记正在处理的模块，通过群聊和私信协商分工，最后各自在个人分支提 PR 经宿主核验合入。',
          '1': '01 · 登记分工：peer-a 与 peer-b 在共享任务板发布 CLAIM 条目表明关注区域，不互相阻塞。',
          '2': '02 · 协商：消息进入每个成员的串行 Router，并附带最新 Board 视图；project 模式可将新私信和 Board 通知 steer 到活跃会话。',
          '3': '03 · 分支开发：每个成员在各自个人分支使用原生 git 开发，隔离的 Gitea 凭证严格通过 secretEnv 注入。',
          '4': '04 · 提 PR：成员通过受控的 gitea Service 从个人分支向受保护 main 发起 Pull Request。',
          '5': '05 · 验收集成：宿主核验作者、分支与固定 head_sha 后再执行合并；collect(includeGit: true) 保留完整本地仓库。',
        },
      },
      substrate: {
        index: '04',
        name: 'Substrate',
        kicker: '不可变存储 · 引文 DAG',
        headline: '零任务队列与零路由——对等成员围绕单一 SQLite 不可变库发布、检索、阅读并引用',
        services: 'substrate（SQLite：publish / search / visit）',
        primitives: 'spawn(files) · send · stop',
        docHref: docHref('zh', 'harnesses/substrate'),
        phases: ['01 发布', '02 退役', '03 检索', '04 阅读', '05 引用'],
        notes: {
          all: '总览：围绕内容寻址 SQLite 存储并发运行多轮探索。成果生命周期超越单个 Agent，通过可审计的 search → visit → 引用链持续演化。',
          '1': '01 · 发布：peer-0 发布自包含结论，SQLite 在 BEGIN IMMEDIATE 事务中分配不可变地址 content:<sha256>。',
          '2': '02 · 退役：peer-0 完成轮次后执行 runtime.stop() 释放容器，其发布的全部成果仍持久可读。',
          '3': '03 · 检索：peer-1 调用 substrate.search()，按词频与被引用数排序返回，并将查询记入 substrate_reads。',
          '4': '04 · 阅读：peer-1 调用 substrate.visit() 读取完整正文与上游引用，留下可审计阅读记录。',
          '5': '05 · 引用：peer-1 发布新成果并显式引用 content:<sha256>，宿主证据检查器验证完整跨成员复用链。',
        },
      },
      'lead-worker': {
        index: '05',
        name: 'Lead-Worker',
        kicker: '主管定调 · 反馈闭环',
        headline: '主管定方向、成员认领子任务并交 Git 代码；系统强制先读反馈再调向、先读方向再交稿',
        services: 'board（SQLite）· gitea + 原生 git',
        primitives: 'fixed-team spawn · onEvent · send',
        docHref: docHref('zh', 'harnesses/lead-worker'),
        phases: ['01 定调', '02 认领', '03 交付', '04 调向', '05 二轮'],
        notes: {
          all: '总览：一名主管负责定方向，多名执行成员认领子任务、提交经核验的 Git 代码并回传一线反馈，驱动下一轮调向。',
          '1': '01 · 定调：主管在 SQLite 任务板发布初始方向、分工安排与就绪子任务。',
          '2': '02 · 认领：多名成员并发调用 board.claim()，数据库事务锁定唯一永久负责人。',
          '3': '03 · 交付：成员推送个人分支、写下一线反馈，并提交 { commit, path, sha256 } 由宿主实时向 Gitea 核验。',
          '4': '04 · 调向：先读后写校验——只有数据库记录证明主管已实际读完反馈，任务板才允许发布新方向。',
          '5': '05 · 二轮：同一批 Worker 在保留的会话与 Git 工作区中继续执行，读取新 direction_id 并交付第二轮成果。',
        },
      },
    }
  : {
      subagents: {
        index: '01',
        name: 'Subagents',
        kicker: 'TREE · MAILBOX',
        headline: 'Example: building a CLI file finder — /root delegates subtasks, steers mid-flight, and integrates tests',
        services: 'collaboration (6 ops)',
        primitives: 'spawn(forkFrom) · send(wakeIfIdle: false) · interrupt',
        docHref: docHref('en', 'harnesses/subagents'),
        phases: ['01 SPAWN', '02 PARALLEL', '03 STEER', '04 HANDOFF', '05 CLOSE'],
        notes: {
          all: 'Scenario (building a CLI file finder): /root splits regex matching and filter testing across two child sandboxes, steers a mid-flight symlink spec into the busy child without waking idle agents, and runs the handed-off test suite before archive-before-delete closeout. Card top bars match each Agent’s lane color.',
          '1': '01 · SPAWN: /root invokes collaboration.spawn_agent. The Runtime boots two isolated sandboxes and optionally mounts a shared workspace or forks parent context.',
          '2': '02 · PARALLEL: All three agents execute concurrently in separate executor sessions with isolated disk and network limits — API keys never leave the host.',
          '3': '03 · STEER: Mid-flight requirements call send({ mode: "steer", wakeIfIdle: false }) so busy children receive input at supported execution boundaries; confirmed idle delivery is retained in the mailbox.',
          '4': '04 · HANDOFF: Children report completion via settled events and send_message; /root runs the handed-off test suite and fixes edge cases.',
          '5': '05 · CLOSE: runtime.close() stops executor work, archives raw sessions, exports collect deliverables, and deletes containers only after archiving succeeds.',
        },
      },
      taskpool: {
        index: '02',
        name: 'TaskPool',
        kicker: 'POOL · LEASE · MAIN',
        headline: 'Read-only discovery, exclusive lease claims, host-granted writes, and versioned main merges',
        services: 'task · material · workspace · judge',
        primitives: 'writable: false · files.replace · stop',
        docHref: docHref('en', 'harnesses/taskpool'),
        phases: ['01 DISCOVER', '02 CLAIM', '03 LEASE GATE', '04 MERGE', '05 REFILL'],
        notes: {
          all: 'Overview: Identical workers start read-only, compete for leased tasks, receive host-granted write access, stay bounded by Model Gateway leases, and merge verified snapshots into main.',
          '1': '01 · DISCOVER: Workers boot with writable: false. They inspect open tasks and immutable Materials without being able to touch local workspace files.',
          '2': '02 · CLAIM: task_take acquires an exclusive lease + fencing_version; the host uses files.replace({ writable: true }) to install files and enable writes.',
          '3': '03 · LEASE GATE: Every model request checks modelAccessPolicy synchronously — if the lease expires or fencing_version changes, inference aborts immediately.',
          '4': '04 · MERGE: workspace_save captures a consistent files.snapshot(), optional Judge verifies the candidate, and workspace_merge advances public main.',
          '5': '05 · REFILL: On task_finish or timeout, the controller stops the finished worker, archives its session, and spawns a fresh worker into the freed slot.',
        },
      },
      peermesh: {
        index: '03',
        name: 'PeerMesh',
        kicker: 'PEERS · CHAT · GIT PR',
        headline: 'Equal peers declaring work areas on a board, coordinating in chat, coding on branches, and landing verified PRs',
        services: 'peermesh-context · message · gitea + native git',
        primitives: 'per-peer bindings · network.allow · secretEnv · collect(includeGit)',
        docHref: docHref('en', 'harnesses/peermesh'),
        phases: ['01 DECLARE', '02 COORDINATE', '03 BRANCH', '04 OPEN PR', '05 LAND'],
        notes: {
          all: 'Overview: No central manager or hard locks — peers post focus areas on a shared Board, coordinate via team chat, and open personal-branch PRs verified by the host.',
          '1': '01 · DECLARE: Both peer-a and peer-b post focus entries on the shared Board to signal areas of interest without blocking each other.',
          '2': '02 · COORDINATE: Each peer receives chat updates with a fresh Board snapshot; active sessions can receive new DMs and Board notices mid-turn.',
          '3': '03 · BRANCH: Each peer develops on its own branch using native git with member-scoped Gitea credentials injected via secretEnv.',
          '4': '04 · OPEN PR: Peers open pull requests from their personal branch to main through the scoped gitea Service (direct merges stay host-only).',
          '5': '05 · LAND: Host delivery checks author, branch, and commit SHA before merging to main; collect(includeGit: true) preserves every local checkout.',
        },
      },
      substrate: {
        index: '04',
        name: 'Substrate',
        kicker: 'SHARED STORE · CITATIONS',
        headline: 'Zero task queues and zero routing — equal peers publish, search, read, and cite immutable findings',
        services: 'substrate (SQLite: publish, search, visit)',
        primitives: 'spawn(files) · send · stop',
        docHref: docHref('en', 'harnesses/substrate'),
        phases: ['01 PUBLISH', '02 RETIRE', '03 SEARCH', '04 VISIT', '05 CITE'],
        notes: {
          all: 'Overview: Fixed parallel rounds over one append-only SQLite store. Findings outlive their authors and evolve through audited search → visit → citation chains.',
          '1': '01 · PUBLISH: peer-0 publishes a self-contained finding; SQLite stores it under an immutable content hash.',
          '2': '02 · RETIRE: When peer-0 finishes and calls runtime.stop(), its container is removed while every published finding remains readable.',
          '3': '03 · SEARCH: peer-1 queries substrate.search(); results rank by relevance and citations while logging the read.',
          '4': '04 · VISIT: peer-1 reads the full finding and upstream references via substrate.visit(), recording a durable read proof.',
          '5': '05 · CITE: peer-1 publishes a refined finding explicitly citing peer-0; host checks confirm the complete cross-agent lineage.',
        },
      },
      'lead-worker': {
        index: '05',
        name: 'Lead-Worker',
        kicker: 'DIRECTION · FEEDBACK',
        headline: 'Lead sets direction, workers claim subtasks and ship Git commits; the board enforces reading feedback before revising',
        services: 'board (SQLite) · gitea + native git',
        primitives: 'fixed-team spawn · onEvent · send',
        docHref: docHref('en', 'harnesses/lead-worker'),
        phases: ['01 DIRECT', '02 CLAIM', '03 SHIP', '04 REVISE', '05 ROUND 2'],
        notes: {
          all: 'Overview: One lead sets direction while workers claim subtasks atomically, ship verified Git commits with field notes, and feed findings back into the next round.',
          '1': '01 · DIRECT: Lead posts the initial direction, role plan, and ready subtasks on the SQLite Board.',
          '2': '02 · CLAIM: Workers concurrently call board.claim(), atomically locking a single permanent owner per subtask.',
          '3': '03 · SHIP: Each worker pushes a personal Git branch, leaves field feedback, and submits a commit verified live against Gitea.',
          '4': '04 · REVISE: Read-before-write check — the Board allows Lead to publish a revised direction only after all worker feedback has been read.',
          '5': '05 · ROUND 2: The same workers resume in their preserved sessions and Git workspaces, read the new direction, and ship round-2 updates.',
        },
      },
    };
---

<div class="showcase-root" data-harness-showcase>
  <!-- 5-Across Interactive Filmstrip Deck -->
  <div class="filmstrip-grid" role="tablist" aria-label="Select a multi-agent harness">
    <!-- 01: Subagents -->
    <button type="button" class="film-card active" data-select-harness="subagents" role="tab" aria-selected="true">
      <div class="film-card-top">
        <span class="film-num">01</span>
        <span class="film-dot" style="background:var(--sch-indigo)"></span>
      </div>
      <div class="film-thumb" aria-hidden="true">
        <svg viewBox="0 0 180 70" width="180" height="70">
          <line x1="14" y1="16" x2="166" y2="16" stroke="var(--border-strong)" stroke-width="1" stroke-dasharray="2 3" />
          <line x1="48" y1="38" x2="144" y2="38" stroke="var(--border-strong)" stroke-width="1" stroke-dasharray="2 3" />
          <line x1="48" y1="58" x2="148" y2="58" stroke="var(--border-strong)" stroke-width="1" stroke-dasharray="2 3" />
          <path class="mini-flow" d="M 42 20 C 46 30, 48 38, 56 38" fill="none" stroke="var(--sch-indigo)" stroke-width="1.6" />
          <path class="mini-flow" d="M 38 20 C 42 42, 46 58, 56 58" fill="none" stroke="var(--sch-indigo)" stroke-width="1.6" />
          <path class="mini-flow" d="M 102 20 C 102 28, 96 31, 96 34" fill="none" stroke="var(--sch-blue)" stroke-width="1.6" />
          <path class="mini-flow" d="M 134 54 C 144 42, 144 30, 148 22" fill="none" stroke="var(--sch-amber)" stroke-width="1.6" />
          <rect x="16" y="10" width="32" height="11" rx="2.5" fill="var(--sch-indigo)" />
          <rect x="88" y="10" width="28" height="11" rx="2.5" fill="var(--sch-indigo)" />
          <rect x="138" y="10" width="28" height="11" rx="2.5" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1" />
          <rect x="58" y="32" width="54" height="11" rx="2.5" fill="var(--sch-teal)" />
          <rect x="58" y="52" width="76" height="11" rx="2.5" fill="var(--sch-amber)" />
        </svg>
      </div>
      <div class="film-card-meta">
        <h3>Subagents</h3>
        <span>TREE · MAILBOX</span>
      </div>
    </button>

    <!-- 02: TaskPool -->
    <button type="button" class="film-card" data-select-harness="taskpool" role="tab" aria-selected="false">
      <div class="film-card-top">
        <span class="film-num">02</span>
        <span class="film-dot" style="background:var(--sch-amber)"></span>
      </div>
      <div class="film-thumb" aria-hidden="true">
        <svg viewBox="0 0 180 70" width="180" height="70">
          <!-- Task pool tickets at top -->
          <rect x="18" y="8" width="34" height="14" rx="3" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.2" />
          <rect x="62" y="8" width="34" height="14" rx="3" fill="var(--sch-card-bg)" stroke="var(--ink)" stroke-width="1.2" />
          <rect x="106" y="8" width="34" height="14" rx="3" fill="var(--sch-card-bg)" stroke="var(--ink)" stroke-width="1.2" />
          <!-- Lease lock arrow -->
          <path class="mini-flow" d="M 35 22 L 35 38 L 90 38" fill="none" stroke="var(--sch-indigo)" stroke-width="1.6" />
          <path class="mini-flow" d="M 103 38 L 146 38 L 146 52" fill="none" stroke="var(--sch-teal)" stroke-width="1.6" />
          <circle cx="96" cy="38" r="7" fill="var(--sch-card-bg)" stroke="var(--sch-indigo)" stroke-width="1.6" />
          <rect x="93" y="36" width="6" height="5" rx="1" fill="var(--sch-indigo)" />
          <!-- Versioned main rail -->
          <line x1="18" y1="56" x2="162" y2="56" stroke="var(--ink)" stroke-width="2" />
          <circle cx="42" cy="56" r="4" fill="var(--sch-card-bg)" stroke="var(--ink)" stroke-width="1.6" />
          <circle cx="94" cy="56" r="4" fill="var(--sch-card-bg)" stroke="var(--ink)" stroke-width="1.6" />
          <circle cx="146" cy="56" r="5" fill="var(--sch-teal)" stroke="var(--ink)" stroke-width="1.4" />
        </svg>
      </div>
      <div class="film-card-meta">
        <h3>TaskPool</h3>
        <span>POOL · LEASE</span>
      </div>
    </button>

    <!-- 03: PeerMesh -->
    <button type="button" class="film-card" data-select-harness="peermesh" role="tab" aria-selected="false">
      <div class="film-card-top">
        <span class="film-num">03</span>
        <span class="film-dot" style="background:var(--sch-teal)"></span>
      </div>
      <div class="film-thumb" aria-hidden="true">
        <svg viewBox="0 0 180 70" width="180" height="70">
          <!-- Peer triangle chat links -->
          <path class="mini-flow" d="M 48 16 L 26 42 L 70 42 Z" fill="none" stroke="var(--sch-indigo)" stroke-width="1.5" />
          <circle cx="48" cy="15" r="5.5" fill="var(--sch-indigo)" />
          <circle cx="26" cy="42" r="5.5" fill="var(--sch-teal)" />
          <circle cx="70" cy="42" r="5.5" fill="var(--sch-amber)" />
          <!-- Parallel Git PR branches merging into main -->
          <line x1="94" y1="36" x2="164" y2="36" stroke="var(--ink)" stroke-width="2" />
          <path class="mini-flow" d="M 98 18 C 122 18, 130 36, 149 36" fill="none" stroke="var(--sch-indigo)" stroke-width="1.6" />
          <path class="mini-flow" d="M 98 54 C 122 54, 130 36, 149 36" fill="none" stroke="var(--sch-teal)" stroke-width="1.6" />
          <circle cx="98" cy="18" r="3.5" fill="var(--sch-indigo)" />
          <circle cx="98" cy="54" r="3.5" fill="var(--sch-teal)" />
          <circle cx="154" cy="36" r="5.5" fill="var(--marker-yellow)" stroke="var(--ink)" stroke-width="1.5" />
        </svg>
      </div>
      <div class="film-card-meta">
        <h3>PeerMesh</h3>
        <span>PEERS · GIT PR</span>
      </div>
    </button>

    <!-- 04: Substrate -->
    <button type="button" class="film-card" data-select-harness="substrate" role="tab" aria-selected="false">
      <div class="film-card-top">
        <span class="film-num">04</span>
        <span class="film-dot" style="background:var(--sch-purple)"></span>
      </div>
      <div class="film-thumb" aria-hidden="true">
        <svg viewBox="0 0 180 70" width="180" height="70">
          <!-- Clean 5-node upward citation DAG (every line connected cleanly) -->
          <path class="mini-flow" d="M 48 48 L 66 32 M 90 48 L 76 32 M 90 48 L 112 32 M 132 48 L 122 32 M 76 24 L 88 15 M 112 24 L 96 15" fill="none" stroke="var(--sch-indigo)" stroke-width="1.5" />
