            <path class="sch-flow-line" d="M 606 118 C 606 150, 594 162, 594 184" fill="none" stroke="var(--sch-indigo)" stroke-width="2.1" marker-end="url(#a-co-1)" />
            <path d="M 622 145 C 624 126, 750 125, 752 145 C 754 164, 620 165, 622 145 Z" fill="var(--sch-surface)" stroke="var(--sch-indigo)" stroke-width="1.6" />
            <text x="687" y="149.5" text-anchor="middle" class="sch-hand-blue-sm">wakeIfIdle: false</text>
