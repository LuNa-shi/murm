          <g class="sch-node" data-sch-phase="2"><rect x="385" y="189" width="148" height="44" rx="5" class="sch-shadow" /><rect x="382" y="186" width="148" height="44" rx="5" class="sch-card" /><rect x="382" y="186" width="148" height="5" rx="2" fill="var(--sch-amber)" /><text x="393" y="206" class="sch-card-pixel">BEGIN IMMEDIATE</text><text x="393" y="222" class="sch-card-title">Check revision</text></g>

          <g class="sch-node" data-sch-phase="3"><rect x="562" y="292" width="150" height="44" rx="5" class="sch-shadow" /><rect x="559" y="289" width="150" height="44" rx="5" class="sch-card" /><rect x="559" y="289" width="150" height="5" rx="2" fill="var(--sch-teal)" /><text x="570" y="309" class="sch-card-pixel">PUSH + NOTE</text><text x="570" y="325" class="sch-card-title">Commit &amp; feedback</text></g>
          <g class="sch-node" data-sch-phase="3"><rect x="562" y="189" width="150" height="44" rx="5" class="sch-shadow" /><rect x="559" y="186" width="150" height="44" rx="5" class="sch-card" /><rect x="559" y="186" width="150" height="5" rx="2" fill="var(--sch-amber)" /><text x="570" y="206" class="sch-card-pixel">VERIFY SHA-256</text><text x="570" y="222" class="sch-card-title">Live Gitea check</text></g>

          <g class="sch-node" data-sch-phase="4"><rect x="742" y="189" width="148" height="44" rx="5" class="sch-shadow" /><rect x="739" y="186" width="148" height="44" rx="5" class="sch-card" /><rect x="739" y="186" width="148" height="5" rx="2" fill="var(--sch-indigo)" /><text x="750" y="206" class="sch-card-pixel">CAUSAL GATE</text><text x="750" y="222" class="sch-card-title">Verify feedback read</text></g>
          <g class="sch-node" data-sch-phase="4"><rect x="742" y="77" width="148" height="44" rx="5" class="sch-shadow" /><rect x="739" y="74" width="148" height="44" rx="5" class="sch-card sch-card-yellow" /><text x="750" y="94" class="sch-card-pixel">ANNOUNCE V2</text><text x="750" y="110" class="sch-card-title">Revise direction</text></g>

          <g class="sch-node" data-sch-phase="5"><rect x="920" y="292" width="124" height="44" rx="5" class="sch-shadow" /><rect x="917" y="289" width="124" height="44" rx="5" class="sch-card" /><rect x="917" y="289" width="124" height="5" rx="2" fill="var(--sch-teal)" /><text x="928" y="309" class="sch-card-pixel">SAME SESSION</text><text x="928" y="325" class="sch-card-title">Ship round 2</text></g>
        </svg>
      </div>
    </div>

    <figcaption class="schematic-caption stage-footer">
      <div class="stage-caption-main">
        <span class="caption-step" data-phase-tag>OVERVIEW</span>
        <span data-phase-note>{HARNESS_META.subagents.notes.all}</span>
      </div>
      <div class="stage-tech-pills">
        <span><strong>Services:</strong> <code data-stage-services>{HARNESS_META.subagents.services}</code></span>
        <span><strong>Primitives:</strong> <code data-stage-primitives>{HARNESS_META.subagents.primitives}</code></span>
      </div>
    </figcaption>
  </figure>

  <!-- Fullscreen Zoom Lightbox -->
  <div class="zoom-backdrop" data-zoom-modal role="dialog" aria-modal="true" aria-label="Expanded harness diagram">
    <div class="zoom-dialog">
      <div class="zoom-head">
        <div class="zoom-tabs" role="tablist" aria-label="Switch harness">
          <button type="button" class="zoom-tab active" data-zoom-switch="subagents">01 Subagents</button>
          <button type="button" class="zoom-tab" data-zoom-switch="taskpool">02 TaskPool</button>
          <button type="button" class="zoom-tab" data-zoom-switch="peermesh">03 PeerMesh</button>
          <button type="button" class="zoom-tab" data-zoom-switch="substrate">04 Substrate</button>
          <button type="button" class="zoom-tab" data-zoom-switch="lead-worker">05 Lead-Worker</button>
        </div>
        <button type="button" class="stage-btn" data-zoom-close aria-label="Close expanded view">ESC ✕</button>
      </div>
      <div class="zoom-body" data-zoom-canvas></div>
      <div class="zoom-foot">
        <span class="caption-step" data-zoom-badge>01 · SUBAGENTS</span>
        <span data-zoom-note></span>
        <a class="section-link" data-zoom-doc href={HARNESS_META.subagents.docHref}>Read deep dive →</a>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ HARNESS_META }}>
  (function initHarnessShowcase() {
    const root = document.querySelector('[data-harness-showcase]');
    if (!root) return;

    const order = ['subagents', 'taskpool', 'peermesh', 'substrate', 'lead-worker'];
    let activeKey = 'subagents';
    let activePhase = 'all';
    let timer = null;
    let seqIdx = 0;

    const cards = root.querySelectorAll('[data-select-harness]');
    const panels = root.querySelectorAll('[data-panel]');
    const badgeEl = root.querySelector('[data-stage-badge]');
    const headlineEl = root.querySelector('[data-stage-headline]');
    const docEl = root.querySelector('[data-stage-doc]');
    const phaseBar = root.querySelector('[data-phase-bar]');
    const tagEl = root.querySelector('[data-phase-tag]');
    const noteEl = root.querySelector('[data-phase-note]');
    const svcEl = root.querySelector('[data-stage-services]');
    const primEl = root.querySelector('[data-stage-primitives]');
    const playBtn = root.querySelector('[data-stage-play]');
    const playIcon = root.querySelector('[data-play-icon]');
    const playLabel = root.querySelector('[data-play-label]');
    const zoomBtn = root.querySelector('[data-stage-zoom]');
    const canvasTrigger = root.querySelector('[data-stage-canvas]');

    const modal = root.querySelector('[data-zoom-modal]');
    const zoomCanvas = root.querySelector('[data-zoom-canvas]');
    const zoomTabs = root.querySelectorAll('[data-zoom-switch]');
    const zoomBadge = root.querySelector('[data-zoom-badge]');
    const zoomNote = root.querySelector('[data-zoom-note]');
    const zoomDoc = root.querySelector('[data-zoom-doc]');
    const zoomClose = root.querySelector('[data-zoom-close]');

    function stopPlay() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
      if (playIcon) playIcon.textContent = '▶';
      if (playLabel) playLabel.textContent = 'Play';
      playBtn?.classList.remove('playing');
    }

    function applyPhase(phase) {
      activePhase = phase;
      const meta = HARNESS_META[activeKey];
      const activePanel = root.querySelector(`[data-panel="${activeKey}"]`);
      phaseBar.querySelectorAll('[data-phase]').forEach((btn) => {
        const isAct = btn.getAttribute('data-phase') === phase;
        btn.classList.toggle('active', isAct);
        btn.setAttribute('aria-selected', isAct ? 'true' : 'false');
      });
      activePanel?.querySelectorAll('[data-sch-phase]').forEach((node) => {
        const match = phase === 'all' || node.getAttribute('data-sch-phase') === phase;
        node.classList.toggle('dimmed', !match);
      });
      if (tagEl) tagEl.textContent = phase === 'all' ? 'OVERVIEW' : meta.phases[Number(phase) - 1] || 'OVERVIEW';
      if (noteEl) noteEl.textContent = meta.notes[phase] || meta.notes.all;
    }

    function renderPhaseBar(meta) {
      const btns = [
        `<button type="button" class="phase-btn active" data-phase="all" role="tab" aria-selected="true">ALL</button>`,
        ...meta.phases.map(
          (label, i) =>
            `<button type="button" class="phase-btn" data-phase="${i + 1}" role="tab" aria-selected="false">${label}</button>`
        ),
      ];
      const legendItems = ['<span class="lane-swatch-item"><i class="lane-swatch lane-swatch-agent"></i>Agent</span>'];
      if (activeKey !== 'subagents') {
        legendItems.push('<span class="lane-swatch-item"><i class="lane-swatch lane-swatch-service"></i>Service</span>');
      }
      if (activeKey === 'taskpool') {
        legendItems.push('<span class="lane-swatch-item"><i class="lane-swatch lane-swatch-workspace"></i>Workspace</span>');
      }
      phaseBar.innerHTML = `${btns.join('')}<span class="lane-legend" aria-label="Lane types">${legendItems.join('')}</span><span class="click-hint">Click to zoom ⤢</span>`;
      phaseBar.querySelectorAll('[data-phase]').forEach((btn) => {
        btn.addEventListener('click', () => {
          stopPlay();
          applyPhase(btn.getAttribute('data-phase') || 'all');
        });
      });
    }

    function syncZoomContent() {
      if (!modal?.classList.contains('open')) return;
      const meta = HARNESS_META[activeKey];
      const activePanel = root.querySelector(`[data-panel="${activeKey}"]`);
      const svg = activePanel?.querySelector('svg');
      if (zoomCanvas && svg) {
        zoomCanvas.innerHTML = '';
        const clone = svg.cloneNode(true);
        clone.querySelectorAll('.dimmed').forEach((n) => n.classList.remove('dimmed'));
        const idMap = new Map();
        clone.querySelectorAll('defs [id]').forEach((el) => {
          const oldId = el.getAttribute('id');
          const newId = 'z-' + oldId;
          idMap.set(oldId, newId);
          el.setAttribute('id', newId);
        });
        clone.querySelectorAll('[fill],[marker-end],[marker-start]').forEach((el) => {
          ['fill', 'marker-end', 'marker-start'].forEach((attr) => {
            const val = el.getAttribute(attr);
            if (!val) return;
            const m = val.match(/^url\(#(.+)\)$/);
            if (m && idMap.has(m[1])) {
              el.setAttribute(attr, `url(#${idMap.get(m[1])})`);
            }
          });
        });
        zoomCanvas.appendChild(clone);
      }
      zoomTabs.forEach((t) => t.classList.toggle('active', t.getAttribute('data-zoom-switch') === activeKey));
      if (zoomBadge) zoomBadge.textContent = `${meta.index} · ${meta.name.toUpperCase()}`;
      if (zoomNote) zoomNote.textContent = meta.notes.all;
      if (zoomDoc) zoomDoc.setAttribute('href', meta.docHref);
    }

    function selectHarness(key) {
      stopPlay();
      activeKey = HARNESS_META[key] ? key : 'subagents';
      const meta = HARNESS_META[activeKey];

      cards.forEach((c) => {
        const isAct = c.getAttribute('data-select-harness') === activeKey;
        c.classList.toggle('active', isAct);
        c.setAttribute('aria-selected', isAct ? 'true' : 'false');
      });

      panels.forEach((p) => {
        const isAct = p.getAttribute('data-panel') === activeKey;
        p.classList.toggle('active', isAct);
        p.hidden = !isAct;
      });

      if (badgeEl) badgeEl.textContent = `${meta.index} · ${meta.name.toUpperCase()}`;
      if (headlineEl) headlineEl.textContent = meta.headline;
      if (docEl) docEl.setAttribute('href', meta.docHref);
      if (svcEl) svcEl.textContent = meta.services;
      if (primEl) primEl.textContent = meta.primitives;

      renderPhaseBar(meta);
      applyPhase('all');
      syncZoomContent();
    }

    function openZoom() {
      modal?.classList.add('open');
      document.body.style.overflow = 'hidden';
      syncZoomContent();
    }

    function closeZoom() {
      modal?.classList.remove('open');
      document.body.style.overflow = '';
    }

    cards.forEach((c) => {
      c.addEventListener('click', () => selectHarness(c.getAttribute('data-select-harness')));
    });

    playBtn?.addEventListener('click', () => {
      if (timer) {
        stopPlay();
        return;
      }
      const seq = ['1', '2', '3', '4', '5', 'all'];
      seqIdx = 0;
      applyPhase(seq[seqIdx]);
      if (playIcon) playIcon.textContent = '❚❚';
      if (playLabel) playLabel.textContent = 'Pause';
      playBtn.classList.add('playing');
      timer = setInterval(() => {
        seqIdx = (seqIdx + 1) % seq.length;
        applyPhase(seq[seqIdx]);
      }, 2200);
    });

    zoomBtn?.addEventListener('click', openZoom);
    canvasTrigger?.addEventListener('click', openZoom);
    zoomClose?.addEventListener('click', closeZoom);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeZoom();
    });
    zoomTabs.forEach((t) => {
      t.addEventListener('click', () => selectHarness(t.getAttribute('data-zoom-switch')));
    });

    document.addEventListener('keydown', (e) => {
      if (!modal?.classList.contains('open')) return;
      if (e.key === 'Escape') closeZoom();
      else if (e.key === 'ArrowRight') {
        const next = order[(order.indexOf(activeKey) + 1) % order.length];
        selectHarness(next);
      } else if (e.key === 'ArrowLeft') {
        const prev = order[(order.indexOf(activeKey) + order.length - 1) % order.length];
        selectHarness(prev);
      }
    });

    selectHarness('subagents');
  })();
</script>
