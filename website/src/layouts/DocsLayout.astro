---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getPrevNext } from '../lib/nav';
import { UI, docHref, type Lang } from '../lib/i18n';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  section: string;
  currentSlug: string;
  headings: Heading[];
  lang?: Lang;
}

const { title, description, section, currentSlug, headings, lang = 'en' } = Astro.props;
const t = UI[lang];
const { prev, next } = getPrevNext(currentSlug, lang);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={`${title} · murm`}
  description={description}
  showTopNav={true}
  showMobileMenu={true}
  lang={lang}
  currentSlug={currentSlug}
>
  <div class="docs-shell">
    <Sidebar currentSlug={currentSlug} lang={lang} />

    <main class="docs-main" id="docs-content">
      <div class="docs-header-row">
        <div class="docs-eyebrow">{section}</div>
        <button
          type="button"
          class="copy-page-btn"
          id="copy-page-btn"
          aria-label={t.copyPageAria}
          data-copy-page-label={t.copyPage}
          data-copied-page-label={t.copiedPage}
          data-error-page-label={t.copyError}
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span>{t.copyPage}</span>
        </button>
      </div>
      <h1 class="docs-title">{title}</h1>
      <p class="docs-lead">{description}</p>

      <article class="prose" id="docs-article">
        <slot />
      </article>

      {(prev || next) && (
        <nav class="docs-pager" aria-label={t.paginationAria}>
          {prev && (
            <a class="pager-link prev" href={docHref(lang, prev.slug)}>
              <span class="pager-dir">{t.prevLabel}</span>
              <span class="pager-title">{prev.title}</span>
            </a>
          )}
          {next && (
            <a class="pager-link next" href={docHref(lang, next.slug)}>
              <span class="pager-dir">{t.nextLabel}</span>
              <span class="pager-title">{next.title}</span>
            </a>
          )}
        </nav>
      )}
    </main>

    <aside class="docs-toc" aria-label={t.onThisPage}>
      {toc.length > 0 && (
        <>
          <div class="toc-title">{t.onThisPage}</div>
          <ul class="toc-list">
            {toc.map((h) => (
              <li>
                <a class:list={['toc-link', { 'depth-3': h.depth === 3 }]} href={`#${h.slug}`} data-toc-id={h.slug}>
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </aside>
  </div>

  <script is:inline>
    (function () {
      const copyBtn = document.getElementById('copy-page-btn');
      if (copyBtn) {
        const defaultLabel = copyBtn.dataset.copyPageLabel || 'Copy page';
        const copiedLabel = copyBtn.dataset.copiedPageLabel || 'Copied';
        const errorLabel = copyBtn.dataset.errorPageLabel || 'Error';
        copyBtn.addEventListener('click', async () => {
          const titleEl = document.querySelector('.docs-title');
          const leadEl = document.querySelector('.docs-lead');
          const articleEl = document.getElementById('docs-article');
          if (!articleEl) return;
          const clone = articleEl.cloneNode(true);
          clone.querySelectorAll('.copy-btn').forEach((el) => el.remove());
          const parts = [
            titleEl ? '# ' + titleEl.textContent.trim() : '',
            leadEl ? leadEl.textContent.trim() : '',
            clone.innerText.trim(),
          ].filter(Boolean);
          const label = copyBtn.querySelector('span');
          try {
            await navigator.clipboard.writeText(parts.join('\n\n'));
            if (label) label.textContent = copiedLabel;
            setTimeout(() => { if (label) label.textContent = defaultLabel; }, 1500);
          } catch {
            if (label) label.textContent = errorLabel;
          }
        });
      }

      const tocLinks = Array.from(document.querySelectorAll('.toc-link[data-toc-id]'));
      if (!tocLinks.length || !('IntersectionObserver' in window)) return;
      const headings = tocLinks
        .map((link) => document.getElementById(link.dataset.tocId))
        .filter(Boolean);
      if (!headings.length) return;

      const setActive = (id) => {
        tocLinks.forEach((link) => {
          link.classList.toggle('active', link.dataset.tocId === id);
        });
      };
      setActive(headings[0].id);

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length) setActive(visible[0].target.id);
        },
        { rootMargin: '-72px 0px -70% 0px', threshold: 0 }
      );
      headings.forEach((h) => observer.observe(h));
    })();
  </script>
</BaseLayout>
