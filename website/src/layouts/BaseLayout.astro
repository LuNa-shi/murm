---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/caveat/700.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500-italic.css';
import '../styles/global.css';
import TopNav from '../components/TopNav.astro';
import SearchModal from '../components/SearchModal.astro';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  showTopNav?: boolean;
  showMobileMenu?: boolean;
  paperGrid?: boolean;
}

const {
  title,
  description = 'A minimal runtime for building multi-agent harnesses with composable coordination services.',
  showTopNav = true,
  showMobileMenu = false,
  paperGrid = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('murm:theme');
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        const reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduced && 'IntersectionObserver' in window) {
          document.documentElement.classList.add('reveal-ready');
        }
      })();
    </script>
  </head>
  <body class:list={[{ 'paper-grid-bg': paperGrid }]}>
    {showTopNav && <TopNav showMobileMenu={showMobileMenu} />}
    <slot />
    <SearchModal />

    <script is:inline>
      (function () {
        document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            document.documentElement.dataset.theme = next;
            localStorage.setItem('murm:theme', next);
          });
        });

        const menuBtn = document.getElementById('mobile-menu-toggle');
        const sidebar = document.getElementById('docs-sidebar');
        menuBtn?.addEventListener('click', () => sidebar?.classList.toggle('open'));

        document.querySelectorAll('.prose pre').forEach((pre) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'copy-btn';
          btn.textContent = 'Copy';
          btn.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.textContent || pre.textContent || '';
            try {
              await navigator.clipboard.writeText(code);
              btn.textContent = 'Copied';
              setTimeout(() => (btn.textContent = 'Copy'), 1400);
            } catch {
              btn.textContent = 'Error';
            }
          });
          pre.appendChild(btn);
        });

        // Progressive scroll-reveal rhythm (calm, unhurried entrance)
        const revealEls = document.querySelectorAll('[data-reveal]');
        if (revealEls.length && document.documentElement.classList.contains('reveal-ready')) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.08, rootMargin: '0px 0px -36px 0px' }
          );
          revealEls.forEach((el) => io.observe(el));
        } else {
          revealEls.forEach((el) => el.classList.add('is-visible'));
        }
      })();
    </script>
  </body>
</html>
